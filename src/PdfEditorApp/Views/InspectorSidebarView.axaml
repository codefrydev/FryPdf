<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfEditorApp.ViewModels"
             xmlns:elvm="using:PdfEditorApp.ViewModels.ElementViewModels"
             xmlns:converters="using:PdfEditorApp.Converters"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="using:PdfEditorApp.Views.Controls"
             x:Class="PdfEditorApp.Views.InspectorSidebarView"
             x:DataType="vm:InspectorViewModel">

    <UserControl.Resources>
        <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
        <converters:HexToColorConverter x:Key="HexToColorConverter" />
        <converters:NullToBooleanConverter x:Key="NullToBooleanConverter" />
        <converters:DoubleToThicknessConverter x:Key="DoubleToThickness" />
        <converters:DoubleToCornerRadiusConverter x:Key="DoubleToCornerRadius" />
        <converters:EqualityToBooleanConverter x:Key="EqualityConverter" />
        <converters:EqualityToBooleanConverter x:Key="EnumToBooleanConverter" />
        <converters:BooleanToStringConverter x:Key="BooleanToStringConverter" />
    </UserControl.Resources>

    <!-- Outer Container: dynamically switches between Expanded (310px) and Collapsed (38px) mode -->
    <Panel>
        <!-- A. EXPANDED MODE (Width 310) -->
        <Border Background="{DynamicResource M3SurfaceContainerLowBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1,0,0,0" Width="310"
                IsVisible="{Binding !$parent[Window].((vm:MainViewModel)DataContext).IsInspectorCollapsed}">
            <Grid RowDefinitions="Auto,*">

                <!-- Sidebar Header -->
                <Border Grid.Row="0" Background="{DynamicResource M3SurfaceBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="{StaticResource M3ShapeCornerFull}"
                                    Background="{DynamicResource M3PrimaryContainerBrush}" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="TuneVariant" Width="16" Height="16"
                                                            Foreground="{DynamicResource M3OnPrimaryContainerBrush}"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Properties &amp; Format" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <controls:AskAiButton Variant="Subtle"
                                                  CommandParameter="{Binding SelectedElement}"
                                                  IsVisible="{Binding HasSelectedElement}" />
                            <Border Background="{DynamicResource M3SecondaryContainerBrush}" CornerRadius="{StaticResource M3ShapeCornerFull}" Padding="10,3">
                                <TextBlock Text="{Binding ActiveCategoryName}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource M3OnSecondaryContainerBrush}"
                                           VerticalAlignment="Center" />
                            </Border>
                            <Button Classes="m3-icon-btn" Width="28" Height="28"
                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleInspectorCollapseCommand}"
                                    ToolTip.Tip="Collapse Properties Inspector (⌘⇧P / Ctrl+Shift+P)">
                                <materialIcons:MaterialIcon Kind="ChevronRight" Width="18" Height="18" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Inspector Scrollable Cards -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12" Spacing="12">

                    <!-- EMPTY STATE: DOCUMENT & PAGE SETUP STUDIO (Visible when nothing is selected) -->
                    <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource M3ShapeCornerLarge}"
                            BoxShadow="{StaticResource M3ElevationLevel1}"
                            Padding="14"
                            IsVisible="{Binding !HasSelectedElement}">
                        <StackPanel Spacing="12">
                            <!-- Header & Live Page Pill -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                <Border Grid.Column="0" Width="30" Height="30"
                                        CornerRadius="{StaticResource M3ShapeCornerSmall}"
                                        Background="{DynamicResource M3PrimaryContainerBrush}">
                                    <materialIcons:MaterialIcon Kind="FileDocumentOutline" Width="16" Height="16"
                                                               Foreground="{DynamicResource M3PrimaryBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="Page &amp; Canvas Setup" FontWeight="SemiBold" FontSize="12.5"
                                               Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                    <TextBlock Text="Standards, orientation &amp; margins" FontSize="10"
                                               Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </StackPanel>
                                <Border Grid.Column="2" Background="{DynamicResource M3SecondaryContainerBrush}"
                                        CornerRadius="{StaticResource M3ShapeCornerFull}" Padding="8,3">
                                    <TextBlock Text="{Binding SelectedPage.PageNumber, StringFormat='Page {0}'}"
                                               FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource M3OnSecondaryContainerBrush}" />
                                </Border>
                            </Grid>

                            <!-- Page Format Standards (Acrobat Feature) -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Paper Size Standard" Classes="inspector-label" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Classes="m3-preset-chip" Height="24" Padding="8,2" Margin="2" Command="{Binding SetPageFormatCommand}" CommandParameter="A4"><TextBlock Text="A4" FontSize="10.5" /></Button>
                                    <Button Classes="m3-preset-chip" Height="24" Padding="8,2" Margin="2" Command="{Binding SetPageFormatCommand}" CommandParameter="Letter"><TextBlock Text="Letter" FontSize="10.5" /></Button>
                                    <Button Classes="m3-preset-chip" Height="24" Padding="8,2" Margin="2" Command="{Binding SetPageFormatCommand}" CommandParameter="Legal"><TextBlock Text="Legal" FontSize="10.5" /></Button>
                                    <Button Classes="m3-preset-chip" Height="24" Padding="8,2" Margin="2" Command="{Binding SetPageFormatCommand}" CommandParameter="A3"><TextBlock Text="A3" FontSize="10.5" /></Button>
                                    <Button Classes="m3-preset-chip" Height="24" Padding="8,2" Margin="2" Command="{Binding SetPageFormatCommand}" CommandParameter="A5"><TextBlock Text="A5" FontSize="10.5" /></Button>
                                    <Button Classes="m3-preset-chip" Height="24" Padding="8,2" Margin="2" Command="{Binding SetPageFormatCommand}" CommandParameter="Tabloid"><TextBlock Text="Tabloid" FontSize="10.5" /></Button>
                                </WrapPanel>
                            </StackPanel>

                            <!-- Orientation & Rotation Studio -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Orientation &amp; Rotation" Classes="inspector-label" />
                                <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="4">
                                    <Button Grid.Column="0" Classes="m3-preset-chip" Height="26" Padding="6,2" HorizontalAlignment="Stretch"
                                            Command="{Binding SetPageOrientationCommand}" CommandParameter="Portrait">
                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="FileOutline" Width="13" Height="13" Foreground="{DynamicResource M3PrimaryBrush}" />
                                            <TextBlock Text="Portrait" FontSize="10.5" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Classes="m3-preset-chip" Height="26" Padding="6,2" HorizontalAlignment="Stretch"
                                            Command="{Binding SetPageOrientationCommand}" CommandParameter="Landscape">
                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="FileOutline" Width="13" Height="13" Foreground="{DynamicResource M3PrimaryBrush}" RenderTransformOrigin="50%,50%">
                                                <materialIcons:MaterialIcon.RenderTransform>
                                                    <RotateTransform Angle="90" />
                                                </materialIcons:MaterialIcon.RenderTransform>
                                            </materialIcons:MaterialIcon>
                                            <TextBlock Text="Landscape" FontSize="10.5" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                                        <Button Classes="mini-tool-btn" Width="26" Height="26" Command="{Binding RotatePageCounterClockwiseCommand}" ToolTip.Tip="Rotate 90° Counter-Clockwise">
                                            <materialIcons:MaterialIcon Kind="RotateLeft" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                        </Button>
                                        <Button Classes="mini-tool-btn" Width="26" Height="26" Command="{Binding RotatePageClockwiseCommand}" ToolTip.Tip="Rotate 90° Clockwise">
                                            <materialIcons:MaterialIcon Kind="RotateRight" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- Custom Page Dimensions (Width & Height) -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="Width (pt)" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding SelectedPage.Width, Mode=TwoWay}" Minimum="200" Maximum="4000" Increment="10" FormatString="0"
                                                   HorizontalAlignment="Stretch" Height="28" FontSize="12" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="Height (pt)" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding SelectedPage.Height, Mode=TwoWay}" Minimum="200" Maximum="4000" Increment="10" FormatString="0"
                                                   HorizontalAlignment="Stretch" Height="28" FontSize="12" />
                                </StackPanel>
                            </Grid>

                            <!-- Page Canvas Background Color & ColorPicker -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Canvas Background Color" Classes="inspector-label" />
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Button Classes="color-studio-btn" ToolTip.Tip="Custom Canvas Color Studio">
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft">
                                                <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                                                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource M3ShapeCornerMedium}"
                                                        Padding="10"
                                                        BoxShadow="{StaticResource M3ElevationLevel3}">
                                                    <ColorView Color="{Binding SelectedPage.BackgroundColorHex, Mode=TwoWay, Converter={StaticResource HexToColorConverter}}"
                                                               IsAlphaEnabled="False" IsHexInputVisible="True" Width="280" />
                                                </Border>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Grid Width="24" Height="24">
                                            <Border CornerRadius="12" Width="24" Height="24">
                                                <Border.Background>
                                                    <ConicGradientBrush Center="0.5,0.5">
                                                        <GradientStop Color="#FF0000" Offset="0.0" />
                                                        <GradientStop Color="#FFFF00" Offset="0.17" />
                                                        <GradientStop Color="#00FF00" Offset="0.33" />
                                                        <GradientStop Color="#00FFFF" Offset="0.50" />
                                                        <GradientStop Color="#0000FF" Offset="0.67" />
                                                        <GradientStop Color="#FF00FF" Offset="0.83" />
                                                        <GradientStop Color="#FF0000" Offset="1.0" />
                                                    </ConicGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border Margin="3.5" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="{DynamicResource M3SurfaceContainerLowBrush}">
                                                <materialIcons:MaterialIcon Kind="Palette" Width="11" Height="11" Foreground="{DynamicResource M3OnSurfaceBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <Button Width="22" Height="22" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="{DynamicResource M3SurfaceBrush}" BorderBrush="{DynamicResource M3OutlineBrush}" BorderThickness="1" Command="{Binding SetPageBackgroundColorCommand}" CommandParameter="#FFFFFF" ToolTip.Tip="Pure White" />
                                    <Button Width="22" Height="22" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="#FFFDF7" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" Command="{Binding SetPageBackgroundColorCommand}" CommandParameter="#FFFDF7" ToolTip.Tip="Warm Cream" />
                                    <Button Width="22" Height="22" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="{DynamicResource M3SurfaceContainerLowBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" Command="{Binding SetPageBackgroundColorCommand}" CommandParameter="#F8FAFC" ToolTip.Tip="Slate Tint" />
                                    <Button Width="22" Height="22" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="#FEF3C7" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" Command="{Binding SetPageBackgroundColorCommand}" CommandParameter="#FEF3C7" ToolTip.Tip="Parchment Yellow" />
                                    <Button Width="22" Height="22" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="#0F172A" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" Command="{Binding SetPageBackgroundColorCommand}" CommandParameter="#0F172A" ToolTip.Tip="Blueprint Dark" />
                                </StackPanel>
                            </StackPanel>

                            <Rectangle Height="1" Fill="{DynamicResource M3OutlineVariantBrush}" Margin="0,2" />

                            <!-- Header & Footer Bar Settings -->
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="PageLayoutFooter" Width="14" Height="14" Foreground="{DynamicResource M3PrimaryBrush}" />
                                        <TextBlock Text="Header &amp; Footer Margins" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding SelectedPage.ShowHeaderFooter, Mode=TwoWay}"
                                                   OnContent="" OffContent="" Margin="0" />
                                </Grid>

                                <StackPanel Spacing="6" IsVisible="{Binding SelectedPage.ShowHeaderFooter}">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Quick Header/Footer Preset" Classes="inspector-label" />
                                        <WrapPanel Orientation="Horizontal">
                                            <Button Classes="m3-preset-chip" Height="22" Padding="6,1" Margin="2" Command="{Binding ApplyHeaderFooterPresetCommand}" CommandParameter="Standard"><TextBlock Text="Standard" FontSize="10" /></Button>
                                            <Button Classes="m3-preset-chip" Height="22" Padding="6,1" Margin="2" Command="{Binding ApplyHeaderFooterPresetCommand}" CommandParameter="Minimal"><TextBlock Text="Page Only" FontSize="10" /></Button>
                                            <Button Classes="m3-preset-chip" Height="22" Padding="6,1" Margin="2" Command="{Binding ApplyHeaderFooterPresetCommand}" CommandParameter="Corporate"><TextBlock Text="Corporate" FontSize="10" /></Button>
                                        </WrapPanel>
                                    </StackPanel>

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="Footer Left" Classes="inspector-label" FontSize="10" />
                                            <TextBox Classes="m3-outlined" Text="{Binding SelectedPage.FooterLeft, Mode=TwoWay}" Height="28" FontSize="11" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="Footer Right" Classes="inspector-label" FontSize="10" />
                                            <TextBox Classes="m3-outlined" Text="{Binding SelectedPage.FooterRight, Mode=TwoWay}" Height="28" FontSize="11" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 1. ADVANCED TYPOGRAPHY & TEXT STUDIO CARD -->
                    <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource M3ShapeCornerLarge}"
                            BoxShadow="{StaticResource M3ElevationLevel1}"
                            Padding="12"
                            IsVisible="{Binding TextElement, Converter={StaticResource NullToBooleanConverter}}">
                        <StackPanel Spacing="12">
                            <!-- Card Header & Auto-Fit Tools -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                <!-- Tonal Icon Avatar -->
                                <Border Grid.Column="0" Width="30" Height="30"
                                        CornerRadius="{StaticResource M3ShapeCornerSmall}"
                                        Background="{DynamicResource M3PrimaryContainerBrush}">
                                    <materialIcons:MaterialIcon Kind="FormatFont" Width="16" Height="16"
                                                               Foreground="{DynamicResource M3PrimaryBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <!-- Title & Contextual Subtitle -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="Typography &amp; Text Studio" FontWeight="SemiBold" FontSize="12.5"
                                               Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                    <TextBlock Text="Presets, warps &amp; formatting" FontSize="10"
                                               Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </StackPanel>

                                <!-- Auto-Fit Segmented Pill Cluster -->
                                <Border Grid.Column="2" Background="{DynamicResource M3SurfaceContainerLowBrush}"
                                        CornerRadius="{StaticResource M3ShapeCornerFull}" Padding="2"
                                        BorderThickness="1" BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="1">
                                        <Button Classes="mini-tool-btn" Width="24" Height="24"
                                                CornerRadius="{StaticResource M3ShapeCornerFull}"
                                                Command="{Binding AutoFitTextBothCommand}"
                                                ToolTip.Tip="Auto-Fit dimensions (Width &amp; Height)">
                                            <materialIcons:MaterialIcon Kind="FitToPageOutline" Width="13" Height="13" Foreground="{DynamicResource M3PrimaryBrush}" />
                                        </Button>
                                        <Button Classes="mini-tool-btn" Width="24" Height="24"
                                                CornerRadius="{StaticResource M3ShapeCornerFull}"
                                                Command="{Binding AutoFitTextWidthCommand}"
                                                ToolTip.Tip="Auto-Fit Width to content">
                                            <materialIcons:MaterialIcon Kind="ArrowExpandHorizontal" Width="13" Height="13" Foreground="{DynamicResource M3PrimaryBrush}" />
                                        </Button>
                                        <Button Classes="mini-tool-btn" Width="24" Height="24"
                                                CornerRadius="{StaticResource M3ShapeCornerFull}"
                                                Command="{Binding AutoFitTextHeightCommand}"
                                                ToolTip.Tip="Auto-Fit Height to content">
                                            <materialIcons:MaterialIcon Kind="ArrowExpandVertical" Width="13" Height="13" Foreground="{DynamicResource M3PrimaryBrush}" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Typography Presets Suite -->
                            <StackPanel Spacing="6">
                                <!-- Presets Section Header with Quick Reset -->
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="AutoFix" Width="13" Height="13" Foreground="{DynamicResource M3PrimaryBrush}" />
                                        <TextBlock Text="Quick Typography Presets" Classes="inspector-label" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0" />
                                    </StackPanel>

                                    <!-- Quick Normal / Reset Pill Button -->
                                    <Button Grid.Column="1" Classes="m3-preset-chip" Height="22" Padding="6,1,7,1"
                                            Command="{Binding ApplyTypographyPresetCommand}" CommandParameter="normal"
                                            ToolTip.Tip="Reset to normal straight text">
                                        <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="FormatLetterCase" Width="11" Height="11" Foreground="{DynamicResource M3PrimaryBrush}" />
                                            <TextBlock Text="Reset" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource M3PrimaryBrush}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Preset Category 1: Curves & Warps -->
                                <StackPanel Spacing="3">
                                    <TextBlock Text="CURVES &amp; WARPS" FontSize="9" FontWeight="SemiBold"
                                               Foreground="{DynamicResource M3OutlineColor}" Margin="1,0,0,0" />
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding ApplyTypographyPresetCommand}" CommandParameter="wave" ToolTip.Tip="Bézier Sine Wave curve">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <materialIcons:MaterialIcon Kind="Waves" Width="12" Height="12" Foreground="#0284C7" />
                                                <TextBlock Text="Wave" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding ApplyTypographyPresetCommand}" CommandParameter="scurve" ToolTip.Tip="S-Curve flow">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <materialIcons:MaterialIcon Kind="VectorCurve" Width="12" Height="12" Foreground="#2563EB" />
                                                <TextBlock Text="S-Curve" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding ApplyTypographyPresetCommand}" CommandParameter="bridge" ToolTip.Tip="Bridge / Convex Arch">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <materialIcons:MaterialIcon Kind="Arch" Width="12" Height="12" Foreground="#7C3AED" />
                                                <TextBlock Text="Bridge" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding ApplyTypographyPresetCommand}" CommandParameter="valley" ToolTip.Tip="Valley / Concave Dip">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <materialIcons:MaterialIcon Kind="TrendingDown" Width="12" Height="12" Foreground="#0D9488" />
                                                <TextBlock Text="Valley" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding ApplyTypographyPresetCommand}" CommandParameter="rise" ToolTip.Tip="Ascending Rise">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <materialIcons:MaterialIcon Kind="TrendingUp" Width="12" Height="12" Foreground="#16A34A" />
                                                <TextBlock Text="Rise" />
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>

                                <!-- Preset Category 2: Circles & Arcs -->
                                <StackPanel Spacing="3">
                                    <TextBlock Text="CIRCLES &amp; ARCS" FontSize="9" FontWeight="SemiBold"
                                               Foreground="{DynamicResource M3OutlineColor}" Margin="1,0,0,0" />
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding ApplyTypographyPresetCommand}" CommandParameter="archup" ToolTip.Tip="Circular Arch Upward">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <materialIcons:MaterialIcon Kind="ArrowUpBoldOutline" Width="12" Height="12" Foreground="#EA580C" />
                                                <TextBlock Text="Arch Up" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding ApplyTypographyPresetCommand}" CommandParameter="archdown" ToolTip.Tip="Circular Arch Downward">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <materialIcons:MaterialIcon Kind="ArrowDownBoldOutline" Width="12" Height="12" Foreground="#D97706" />
                                                <TextBlock Text="Arch Down" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding ApplyTypographyPresetCommand}" CommandParameter="circlebadge" ToolTip.Tip="360° Circular Badge Seal">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <materialIcons:MaterialIcon Kind="DecagramOutline" Width="12" Height="12" Foreground="#9333EA" />
                                                <TextBlock Text="Badge" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding ApplyTypographyPresetCommand}" CommandParameter="toparc" ToolTip.Tip="180° Top Arc placement">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <materialIcons:MaterialIcon Kind="CircleHalfFull" Width="12" Height="12" Foreground="#4F46E5" />
                                                <TextBlock Text="Top Arc" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding ApplyTypographyPresetCommand}" CommandParameter="bottomarc" ToolTip.Tip="180° Bottom Arc placement">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <materialIcons:MaterialIcon Kind="CircleHalfFull" Width="12" Height="12" Foreground="#6366F1" RenderTransformOrigin="50%,50%">
                                                    <materialIcons:MaterialIcon.RenderTransform>
                                                        <RotateTransform Angle="180" />
                                                    </materialIcons:MaterialIcon.RenderTransform>
                                                </materialIcons:MaterialIcon>
                                                <TextBlock Text="Bottom Arc" />
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>

                                <!-- Preset Category 3: Stylized Effects -->
                                <StackPanel Spacing="3">
                                    <TextBlock Text="STYLIZED EFFECTS" FontSize="9" FontWeight="SemiBold"
                                               Foreground="{DynamicResource M3OutlineColor}" Margin="1,0,0,0" />
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding ApplyTypographyPresetCommand}" CommandParameter="outlined" ToolTip.Tip="Bold Outline Stroke with White Fill">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <materialIcons:MaterialIcon Kind="BorderColor" Width="12" Height="12" Foreground="#0284C7" />
                                                <TextBlock Text="Outline" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding ApplyTypographyPresetCommand}" CommandParameter="shadowheading" ToolTip.Tip="Soft Drop Shadow Elevation">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <materialIcons:MaterialIcon Kind="LayersOutline" Width="12" Height="12" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                                <TextBlock Text="Shadow" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding ApplyTypographyPresetCommand}" CommandParameter="neonglow" ToolTip.Tip="Cyan Neon Glow Emission">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <materialIcons:MaterialIcon Kind="Creation" Width="12" Height="12" Foreground="#06B6D4" />
                                                <TextBlock Text="Neon Glow" />
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- In-Inspector Text Editor (Vertically Resizable with Drag Handle) -->
                            <StackPanel Spacing="3">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Text Content" Classes="inspector-label" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Classes="m3-icon-btn" Width="22" Height="22"
                                            Click="OnToggleTextEditorExpandClicked"
                                            ToolTip.Tip="Toggle Editor Size (Compact / Expanded)">
                                        <materialIcons:MaterialIcon Name="TextEditorExpandIcon" Kind="ArrowExpandVertical" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                    </Button>
                                </Grid>
                                <Border Classes="m3-resizable-editor">
                                    <Grid RowDefinitions="*,Auto">
                                        <TextBox Grid.Row="0"
                                                 Name="SidebarTextEditor"
                                                 Classes="m3-outlined"
                                                 BorderThickness="0"
                                                 CornerRadius="0"
                                                 Background="Transparent"
                                                 Text="{Binding TextElement.Text, Mode=TwoWay}"
                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                 Height="72" MinHeight="44" MaxHeight="450"
                                                 FontSize="12" Padding="8,6"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 AttachedToVisualTree="OnSidebarTextBoxAttached" />
                                        <Border Grid.Row="1"
                                                Classes="m3-resize-grip"
                                                Height="11"
                                                CornerRadius="0,0,12,12"
                                                PointerPressed="OnTextEditorResizeGripPointerPressed"
                                                PointerMoved="OnTextEditorResizeGripPointerMoved"
                                                PointerReleased="OnTextEditorResizeGripPointerReleased"
                                                DoubleTapped="OnTextEditorResizeGripDoubleTapped"
                                                ToolTip.Tip="Drag vertically to resize editor • Double-click to toggle">
                                            <Border Classes="m3-grip-pill"
                                                    Width="28" Height="3.5"
                                                    CornerRadius="{StaticResource M3ShapeCornerFull}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Font Family & Font Size -->
                            <Grid ColumnDefinitions="*,75" ColumnSpacing="6">
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="Font Family" Classes="inspector-label" />
                                    <ComboBox ItemsSource="{Binding AvailableFontFamilies}"
                                              SelectedItem="{Binding SelectedFontFamily, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch" Height="30" FontSize="12">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate DataType="x:String">
                                                <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="12" VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="Size (pt)" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding TextElement.FontSize, Mode=TwoWay}"
                                                   Minimum="4" Maximum="288" Increment="1" FormatString="0"
                                                   HorizontalAlignment="Stretch" Height="30" FontSize="12" />
                                </StackPanel>
                            </Grid>

                            <!-- Bold / Italic / Underline / Double Underline / Strikethrough / Alignment -->
                            <StackPanel Spacing="3">
                                <TextBlock Text="Style, Underline &amp; Alignment" Classes="inspector-label" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Classes="mini-tool-btn" Width="28" Height="28" Margin="1" Focusable="False"
                                            Classes.active="{Binding TextElement.IsBold, FallbackValue=False}"
                                            Command="{Binding ToggleBoldCommand}" ToolTip.Tip="Bold (Ctrl+B)">
                                        <materialIcons:MaterialIcon Kind="FormatBold" Width="15" Height="15" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                    </Button>

                                    <Button Classes="mini-tool-btn" Width="28" Height="28" Margin="1" Focusable="False"
                                            Classes.active="{Binding TextElement.IsItalic, FallbackValue=False}"
                                            Command="{Binding ToggleItalicCommand}" ToolTip.Tip="Italic (Ctrl+I)">
                                        <materialIcons:MaterialIcon Kind="FormatItalic" Width="15" Height="15" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                    </Button>

                                    <Button Classes="mini-tool-btn" Width="28" Height="28" Margin="1" Focusable="False"
                                            Classes.active="{Binding TextElement.IsUnderline, FallbackValue=False}"
                                            Command="{Binding ToggleUnderlineCommand}" ToolTip.Tip="Single Underline (Ctrl+U)">
                                        <materialIcons:MaterialIcon Kind="FormatUnderline" Width="15" Height="15" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                    </Button>

                                    <Button Classes="mini-tool-btn" Width="28" Height="28" Margin="1" Focusable="False"
                                            Classes.active="{Binding TextElement.IsDoubleUnderline, FallbackValue=False}"
                                            Command="{Binding ToggleDoubleUnderlineCommand}" ToolTip.Tip="Double Underline">
                                        <materialIcons:MaterialIcon Kind="FormatUnderline" Width="15" Height="15" Foreground="{DynamicResource M3PrimaryBrush}" />
                                    </Button>

                                    <Button Classes="mini-tool-btn" Width="28" Height="28" Margin="1" Focusable="False"
                                            Classes.active="{Binding TextElement.IsStrikethrough, FallbackValue=False}"
                                            Command="{Binding ToggleStrikethroughCommand}" ToolTip.Tip="Strikethrough">
                                        <materialIcons:MaterialIcon Kind="FormatStrikethrough" Width="15" Height="15" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                    </Button>

                                    <Rectangle Width="1" Height="18" Fill="{DynamicResource M3OutlineVariantBrush}" Margin="3,0" />

                                    <Button Classes="mini-tool-btn" Width="28" Height="28" Margin="1" Focusable="False"
                                            Command="{Binding ToggleBulletsCommand}" ToolTip.Tip="Bullet List">
                                        <materialIcons:MaterialIcon Kind="FormatListBulleted" Width="15" Height="15" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                    </Button>

                                    <Button Classes="mini-tool-btn" Width="28" Height="28" Margin="1" Focusable="False"
                                            Command="{Binding ToggleNumberingCommand}" ToolTip.Tip="Numbered List">
                                        <materialIcons:MaterialIcon Kind="FormatListNumbered" Width="15" Height="15" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                    </Button>

                                    <Rectangle Width="1" Height="18" Fill="{DynamicResource M3OutlineVariantBrush}" Margin="3,0" />

                                    <!-- Horizontal Alignment -->
                                    <Button Classes="mini-tool-btn" Width="28" Height="28" Margin="1" Focusable="False"
                                            Classes.active="{Binding TextElement.Alignment, Converter={StaticResource EqualityConverter}, ConverterParameter=Left}"
                                            Command="{Binding SetAlignmentCommand}" CommandParameter="Left" ToolTip.Tip="Align Left">
                                        <materialIcons:MaterialIcon Kind="FormatAlignLeft" Width="15" Height="15" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                    </Button>

                                    <Button Classes="mini-tool-btn" Width="28" Height="28" Margin="1" Focusable="False"
                                            Classes.active="{Binding TextElement.Alignment, Converter={StaticResource EqualityConverter}, ConverterParameter=Center}"
                                            Command="{Binding SetAlignmentCommand}" CommandParameter="Center" ToolTip.Tip="Align Center">
                                        <materialIcons:MaterialIcon Kind="FormatAlignCenter" Width="15" Height="15" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                    </Button>

                                    <Button Classes="mini-tool-btn" Width="28" Height="28" Margin="1" Focusable="False"
                                            Classes.active="{Binding TextElement.Alignment, Converter={StaticResource EqualityConverter}, ConverterParameter=Right}"
                                            Command="{Binding SetAlignmentCommand}" CommandParameter="Right" ToolTip.Tip="Align Right">
                                        <materialIcons:MaterialIcon Kind="FormatAlignRight" Width="15" Height="15" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                    </Button>

                                    <Button Classes="mini-tool-btn" Width="28" Height="28" Margin="1" Focusable="False"
                                            Classes.active="{Binding TextElement.Alignment, Converter={StaticResource EqualityConverter}, ConverterParameter=Justify}"
                                            Command="{Binding SetAlignmentCommand}" CommandParameter="Justify" ToolTip.Tip="Justify">
                                        <materialIcons:MaterialIcon Kind="FormatAlignJustify" Width="15" Height="15" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                    </Button>
                                </WrapPanel>
                            </StackPanel>

                            <!-- Vertical Alignment & Text Case -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="Vertical Align" Classes="inspector-label" />
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <Button Classes="mini-tool-btn" Width="26" Height="24"
                                                Classes.active="{Binding TextElement.VerticalAlignment, Converter={StaticResource EqualityConverter}, ConverterParameter=Top}"
                                                Command="{Binding SetVerticalAlignmentCommand}" CommandParameter="Top" ToolTip.Tip="Top Align">
                                            <materialIcons:MaterialIcon Kind="AlignVerticalTop" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                        </Button>
                                        <Button Classes="mini-tool-btn" Width="26" Height="24"
                                                Classes.active="{Binding TextElement.VerticalAlignment, Converter={StaticResource EqualityConverter}, ConverterParameter=Center}"
                                                Command="{Binding SetVerticalAlignmentCommand}" CommandParameter="Center" ToolTip.Tip="Middle Align">
                                            <materialIcons:MaterialIcon Kind="AlignVerticalCenter" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                        </Button>
                                        <Button Classes="mini-tool-btn" Width="26" Height="24"
                                                Classes.active="{Binding TextElement.VerticalAlignment, Converter={StaticResource EqualityConverter}, ConverterParameter=Bottom}"
                                                Command="{Binding SetVerticalAlignmentCommand}" CommandParameter="Bottom" ToolTip.Tip="Bottom Align">
                                            <materialIcons:MaterialIcon Kind="AlignVerticalBottom" Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="Text Case" Classes="inspector-label" />
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <Button Classes="secondary-btn" Height="24" Padding="4,1" Command="{Binding TransformTextCaseCommand}" CommandParameter="Upper"><TextBlock Text="AA" FontSize="9" /></Button>
                                        <Button Classes="secondary-btn" Height="24" Padding="4,1" Command="{Binding TransformTextCaseCommand}" CommandParameter="Lower"><TextBlock Text="aa" FontSize="9" /></Button>
                                        <Button Classes="secondary-btn" Height="24" Padding="4,1" Command="{Binding TransformTextCaseCommand}" CommandParameter="Title"><TextBlock Text="Aa" FontSize="9" /></Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!-- Spacing: Tracking, Word Spacing, Line Height, Paragraph Spacing -->
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="6">
                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Tracking / Spacing" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding TextElement.CharacterSpacing, Mode=TwoWay}"
                                                   Minimum="-5" Maximum="50" Increment="0.5" FormatString="0.0"
                                                   HorizontalAlignment="Stretch" Height="28" FontSize="11.5" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Word Spacing" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding TextElement.WordSpacing, Mode=TwoWay}"
                                                   Minimum="-10" Maximum="50" Increment="1" FormatString="0.0"
                                                   HorizontalAlignment="Stretch" Height="28" FontSize="11.5" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Line Height" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding TextElement.LineHeight, Mode=TwoWay}"
                                                   Minimum="0.5" Maximum="4.0" Increment="0.1" FormatString="0.0"
                                                   HorizontalAlignment="Stretch" Height="28" FontSize="11.5" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Paragraph Spacing" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding TextElement.ParagraphSpacing, Mode=TwoWay}"
                                                   Minimum="0" Maximum="50" Increment="1" FormatString="0"
                                                   HorizontalAlignment="Stretch" Height="28" FontSize="11.5" />
                                </StackPanel>
                            </Grid>

                            <!-- Text Wrap & Text Opacity -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <CheckBox Grid.Column="0" IsChecked="{Binding TextElement.TextWrap, Mode=TwoWay}" VerticalAlignment="Center">
                                    <TextBlock Text="Wrap Multiline Text" FontSize="11" />
                                </CheckBox>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Text Opacity" Classes="inspector-label" Margin="0" />
                                        <TextBlock Grid.Column="1" Text="{Binding TextElement.TextOpacity, StringFormat='{}{0:P0}'}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource M3PrimaryBrush}" />
                                    </Grid>
                                    <Slider Value="{Binding TextElement.TextOpacity, Mode=TwoWay}" Minimum="0.0" Maximum="1.0" Height="24" Margin="0" />
                                </StackPanel>
                            </Grid>

                            <!-- Text Color -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Text Color" Classes="inspector-label" />
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Button Classes="color-studio-btn" ToolTip.Tip="Custom Color Studio">
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft">
                                                <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                                                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource M3ShapeCornerMedium}"
                                                        Padding="10"
                                                        BoxShadow="{StaticResource M3ElevationLevel3}">
                                                    <ColorView Color="{Binding TextElement.TextColorHex, Mode=TwoWay, Converter={StaticResource HexToColorConverter}}"
                                                               IsAlphaEnabled="True" IsHexInputVisible="True" Width="280" />
                                                </Border>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Grid Width="24" Height="24">
                                            <Border CornerRadius="12" Width="24" Height="24">
                                                <Border.Background>
                                                    <ConicGradientBrush Center="0.5,0.5">
                                                        <GradientStop Color="#FF0000" Offset="0.0" />
                                                        <GradientStop Color="#FFFF00" Offset="0.17" />
                                                        <GradientStop Color="#00FF00" Offset="0.33" />
                                                        <GradientStop Color="#00FFFF" Offset="0.50" />
                                                        <GradientStop Color="#0000FF" Offset="0.67" />
                                                        <GradientStop Color="#FF00FF" Offset="0.83" />
                                                        <GradientStop Color="#FF0000" Offset="1.0" />
                                                    </ConicGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border Margin="3.5" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="{DynamicResource M3SurfaceContainerLowBrush}">
                                                <materialIcons:MaterialIcon Kind="Palette" Width="11" Height="11" Foreground="{DynamicResource M3OnSurfaceBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <ItemsControl ItemsSource="{Binding ColorSwatches}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:ColorSwatchItem">
                                                <Button Width="22" Height="22" Margin="1.5" CornerRadius="{StaticResource M3ShapeCornerFull}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1"
                                                        Background="{Binding Hex, Converter={StaticResource HexToBrushConverter}}"
                                                        Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).SetTextColorCommand}"
                                                        CommandParameter="{Binding Hex}" ToolTip.Tip="{Binding Name}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>

                            <!-- Text Stroke / Outline Studio -->
                            <Border Background="{DynamicResource M3SurfaceContainerLowBrush}" CornerRadius="{StaticResource M3ShapeCornerMedium}" Padding="8" BorderThickness="1" BorderBrush="{DynamicResource M3OutlineVariantBrush}">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <CheckBox Grid.Column="0" IsChecked="{Binding TextElement.HasStroke, Mode=TwoWay}" VerticalAlignment="Center">
                                            <TextBlock Text="Text Outline / Stroke" FontWeight="SemiBold" FontSize="11" />
                                        </CheckBox>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" IsVisible="{Binding TextElement.HasStroke}">
                                            <Button Classes="color-studio-btn" ToolTip.Tip="Custom Stroke Color">
                                                <Button.Flyout>
                                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                                        <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                                                                BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="{StaticResource M3ShapeCornerMedium}"
                                                                Padding="10"
                                                                BoxShadow="{StaticResource M3ElevationLevel3}">
                                                            <ColorView Color="{Binding TextElement.StrokeColorHex, Mode=TwoWay, Converter={StaticResource HexToColorConverter}}"
                                                                       IsAlphaEnabled="True" IsHexInputVisible="True" Width="280" />
                                                        </Border>
                                                    </Flyout>
                                                </Button.Flyout>
                                                <Border Width="20" Height="20" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="{Binding TextElement.StrokeColorHex, Converter={StaticResource HexToBrushConverter}}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,80" ColumnSpacing="6" IsVisible="{Binding TextElement.HasStroke}">
                                        <Slider Grid.Column="0" Value="{Binding TextElement.StrokeWidth, Mode=TwoWay}" Minimum="0.5" Maximum="12" Height="24" Margin="0" />
                                        <NumericUpDown Grid.Column="1" Value="{Binding TextElement.StrokeWidth, Mode=TwoWay}" Minimum="0.5" Maximum="20" Increment="0.5" FormatString="0.0 pt" Height="26" FontSize="11" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Text Drop Shadow & Glow Studio -->
                            <Border Background="{DynamicResource M3SurfaceContainerLowBrush}" CornerRadius="{StaticResource M3ShapeCornerMedium}" Padding="8" BorderThickness="1" BorderBrush="{DynamicResource M3OutlineVariantBrush}">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <CheckBox Grid.Column="0" IsChecked="{Binding TextElement.HasShadow, Mode=TwoWay}" VerticalAlignment="Center">
                                            <TextBlock Text="Text Shadow &amp; Glow" FontWeight="SemiBold" FontSize="11" />
                                        </CheckBox>
                                        <Button Grid.Column="1" Classes="color-studio-btn" ToolTip.Tip="Shadow Color" IsVisible="{Binding TextElement.HasShadow}">
                                            <Button.Flyout>
                                                <Flyout Placement="BottomEdgeAlignedLeft">
                                                    <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                                                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="{StaticResource M3ShapeCornerMedium}"
                                                            Padding="10"
                                                            BoxShadow="{StaticResource M3ElevationLevel3}">
                                                        <ColorView Color="{Binding TextElement.ShadowColorHex, Mode=TwoWay, Converter={StaticResource HexToColorConverter}}"
                                                                   IsAlphaEnabled="True" IsHexInputVisible="True" Width="280" />
                                                    </Border>
                                                </Flyout>
                                            </Button.Flyout>
                                            <Border Width="20" Height="20" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="{Binding TextElement.ShadowColorHex, Converter={StaticResource HexToBrushConverter}}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" />
                                        </Button>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4" IsVisible="{Binding TextElement.HasShadow}">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="Offset X" Classes="inspector-label" />
                                            <NumericUpDown Value="{Binding TextElement.ShadowOffsetX, Mode=TwoWay}"
                                                           Minimum="-50" Maximum="50" Increment="1" FormatString="0"
                                                           Height="26" FontSize="10.5" HorizontalContentAlignment="Left"
                                                           ToolTip.Tip="Horizontal Shadow Offset (-50 to 50)" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="Offset Y" Classes="inspector-label" />
                                            <NumericUpDown Value="{Binding TextElement.ShadowOffsetY, Mode=TwoWay}"
                                                           Minimum="-50" Maximum="50" Increment="1" FormatString="0"
                                                           Height="26" FontSize="10.5" HorizontalContentAlignment="Left"
                                                           ToolTip.Tip="Vertical Shadow Offset (-50 to 50)" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="2">
                                            <TextBlock Text="Blur Radius" Classes="inspector-label" />
                                            <NumericUpDown Value="{Binding TextElement.ShadowBlurRadius, Mode=TwoWay}"
                                                           Minimum="0" Maximum="40" Increment="1" FormatString="0"
                                                           Height="26" FontSize="10.5" HorizontalContentAlignment="Left"
                                                           ToolTip.Tip="Shadow Blur Radius (0 to 40)" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Background Highlight & Box Decoration -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Highlight / Background Box" Classes="inspector-label" />
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Classes="m3-preset-chip" Height="24" Padding="6,1" Command="{Binding SetTextBackgroundCommand}" CommandParameter="#00000000" Content="None" />
                                    <Button Classes="color-studio-btn" ToolTip.Tip="Custom Highlight Color">
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft">
                                                <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                                                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource M3ShapeCornerMedium}"
                                                        Padding="10"
                                                        BoxShadow="{StaticResource M3ElevationLevel3}">
                                                    <ColorView Color="{Binding TextElement.BackgroundColorHex, Mode=TwoWay, Converter={StaticResource HexToColorConverter}}"
                                                               IsAlphaEnabled="True" IsHexInputVisible="True" Width="280" />
                                                </Border>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Grid Width="24" Height="24">
                                            <Border CornerRadius="12" Width="24" Height="24">
                                                <Border.Background>
                                                    <ConicGradientBrush Center="0.5,0.5">
                                                        <GradientStop Color="#FF0000" Offset="0.0" /><GradientStop Color="#FFFF00" Offset="0.17" /><GradientStop Color="#00FF00" Offset="0.33" /><GradientStop Color="#00FFFF" Offset="0.50" /><GradientStop Color="#0000FF" Offset="0.67" /><GradientStop Color="#FF00FF" Offset="0.83" /><GradientStop Color="#FF0000" Offset="1.0" />
                                                    </ConicGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border Margin="3.5" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="{DynamicResource M3SurfaceContainerLowBrush}">
                                                <materialIcons:MaterialIcon Kind="Palette" Width="11" Height="11" Foreground="{DynamicResource M3OnSurfaceBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <Button Width="22" Height="22" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="#FEF08A" Command="{Binding SetTextBackgroundCommand}" CommandParameter="#FEF08A" ToolTip.Tip="Yellow Highlight" />
                                    <Button Width="22" Height="22" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="#BAE6FD" Command="{Binding SetTextBackgroundCommand}" CommandParameter="#BAE6FD" ToolTip.Tip="Blue Highlight" />
                                    <Button Width="22" Height="22" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="#BBF7D0" Command="{Binding SetTextBackgroundCommand}" CommandParameter="#BBF7D0" ToolTip.Tip="Green Highlight" />
                                    <Button Width="22" Height="22" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="#FEE2E2" Command="{Binding SetTextBackgroundCommand}" CommandParameter="#FEE2E2" ToolTip.Tip="Red Highlight" />
                                    <Button Width="22" Height="22" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="{DynamicResource M3SurfaceContainerHighBrush}" Command="{Binding SetTextBackgroundCommand}" CommandParameter="#F1F5F9" ToolTip.Tip="Light Gray" />
                                </StackPanel>

                                <!-- Box Padding, Corner Radius, Border -->
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6" Margin="0,4,0,0">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="Padding" Classes="inspector-label" />
                                        <NumericUpDown Value="{Binding TextElement.Padding, Mode=TwoWay}"
                                                       Minimum="0" Maximum="64" Increment="1" FormatString="0"
                                                       Height="26" FontSize="11" HorizontalContentAlignment="Left"
                                                       ToolTip.Tip="Internal Box Padding (0-64 px)" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="Corner Radius" Classes="inspector-label" />
                                        <NumericUpDown Value="{Binding TextElement.CornerRadius, Mode=TwoWay}"
                                                       Minimum="0" Maximum="64" Increment="1" FormatString="0"
                                                       Height="26" FontSize="11" HorizontalContentAlignment="Left"
                                                       ToolTip.Tip="Box Corner Radius (0-64 px)" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="2">
                                        <TextBlock Text="Border Thick." Classes="inspector-label" />
                                        <NumericUpDown Value="{Binding TextElement.BorderThickness, Mode=TwoWay}"
                                                       Minimum="0" Maximum="20" Increment="0.5" FormatString="0.0"
                                                       Height="26" FontSize="11" HorizontalContentAlignment="Left"
                                                       ToolTip.Tip="Border Stroke Thickness (0-20 pt)" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- ========================================================= -->
                            <!-- CURVED & CIRCULAR TYPOGRAPHY STUDIO SECTION               -->
                            <!-- ========================================================= -->
                            <Border Background="{DynamicResource M3SurfaceContainerLowBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" CornerRadius="{StaticResource M3ShapeCornerMedium}" Padding="10">
                                <StackPanel Spacing="8">
                                    <!-- Shape Mode Selector -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="VectorCurve" Width="16" Height="16" Foreground="{DynamicResource M3PrimaryBrush}" />
                                            <TextBlock Text="Curved &amp; Circular Text" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Mode Toggle: Normal, Curved Arc, Circular, Bézier Curve -->
                                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="3">
                                        <Button Grid.Column="0" Classes="secondary-btn" Height="28" Padding="2"
                                                Classes.active="{Binding TextElement.ShapeMode, Converter={StaticResource EqualityConverter}, ConverterParameter=Normal}"
                                                Command="{Binding SetTextShapeModeCommand}" CommandParameter="Normal">
                                            <TextBlock Text="Straight" FontSize="10" />
                                        </Button>
                                        <Button Grid.Column="1" Classes="secondary-btn" Height="28" Padding="2"
                                                Classes.active="{Binding TextElement.ShapeMode, Converter={StaticResource EqualityConverter}, ConverterParameter=Curved}"
                                                Command="{Binding SetTextShapeModeCommand}" CommandParameter="Curved">
                                            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="VectorCurve" Width="11" Height="11" />
                                                <TextBlock Text="Arc" FontSize="10" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="2" Classes="secondary-btn" Height="28" Padding="2"
                                                Classes.active="{Binding TextElement.ShapeMode, Converter={StaticResource EqualityConverter}, ConverterParameter=Circular}"
                                                Command="{Binding SetTextShapeModeCommand}" CommandParameter="Circular">
                                            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="CircleOutline" Width="11" Height="11" />
                                                <TextBlock Text="Circle" FontSize="10" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="3" Classes="secondary-btn" Height="28" Padding="2"
                                                Classes.active="{Binding TextElement.ShapeMode, Converter={StaticResource EqualityConverter}, ConverterParameter=BezierCurve}"
                                                Command="{Binding SetTextShapeModeCommand}" CommandParameter="BezierCurve">
                                            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="VectorBezier" Width="11" Height="11" />
                                                <TextBlock Text="Bézier" FontSize="10" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- CURVED MODE CONTROLS -->
                                    <StackPanel Spacing="6" IsVisible="{Binding TextElement.IsCurvedMode}">
                                        <!-- Curve Radius & Arc Sweep Angle -->
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="Curve Radius (pt)" Classes="inspector-label" />
                                                <NumericUpDown Value="{Binding TextElement.CurveRadius, Mode=TwoWay}" Minimum="20" Maximum="2000" Increment="10" FormatString="0" Height="26" FontSize="11" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="Arc Angle (°)" Classes="inspector-label" />
                                                <NumericUpDown Value="{Binding TextElement.CurveArcAngle, Mode=TwoWay}" Minimum="10" Maximum="360" Increment="10" FormatString="0°" Height="26" FontSize="11" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Start Angle & Direction -->
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="Start Angle (°)" Classes="inspector-label" />
                                                <NumericUpDown Value="{Binding TextElement.CurveStartAngle, Mode=TwoWay}" Minimum="-180" Maximum="180" Increment="15" FormatString="0°" Height="26" FontSize="11" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="Arch Direction" Classes="inspector-label" />
                                                <Button Classes="secondary-btn" Height="26" HorizontalAlignment="Stretch" Command="{Binding ToggleCurveDirectionCommand}">
                                                    <TextBlock Text="{Binding TextElement.CurveClockwise, Converter={x:Static converters:BooleanToFontWeightConverter.Instance}}" FontSize="10" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Invert Text Checkbox -->
                                        <CheckBox IsChecked="{Binding TextElement.CurveInvert, Mode=TwoWay}">
                                            <TextBlock Text="Invert / Reverse Text Orientation" FontSize="10.5" />
                                        </CheckBox>
                                    </StackPanel>

                                    <!-- CIRCULAR MODE CONTROLS -->
                                    <StackPanel Spacing="6" IsVisible="{Binding TextElement.IsCircularMode}">
                                        <!-- Placement Buttons: Top Arc, Bottom Arc, Full Circle -->
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Circular Placement" Classes="inspector-label" />
                                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                                                <Button Grid.Column="0" Classes="secondary-btn" Height="26"
                                                        Classes.active="{Binding TextElement.CircularPlacement, Converter={StaticResource EqualityConverter}, ConverterParameter=TopArc}"
                                                        Command="{Binding SetCircularPlacementCommand}" CommandParameter="TopArc">
                                                    <TextBlock Text="Top Arc" FontSize="10" />
                                                </Button>
                                                <Button Grid.Column="1" Classes="secondary-btn" Height="26"
                                                        Classes.active="{Binding TextElement.CircularPlacement, Converter={StaticResource EqualityConverter}, ConverterParameter=BottomArc}"
                                                        Command="{Binding SetCircularPlacementCommand}" CommandParameter="BottomArc">
                                                    <TextBlock Text="Bottom Arc" FontSize="10" />
                                                </Button>
                                                <Button Grid.Column="2" Classes="secondary-btn" Height="26"
                                                        Classes.active="{Binding TextElement.CircularPlacement, Converter={StaticResource EqualityConverter}, ConverterParameter=FullCircle}"
                                                        Command="{Binding SetCircularPlacementCommand}" CommandParameter="FullCircle">
                                                    <TextBlock Text="Full Circle" FontSize="10" />
                                                </Button>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Circle Radius & Start Angle -->
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="Circle Radius" Classes="inspector-label" />
                                                <NumericUpDown Value="{Binding TextElement.CurveRadius, Mode=TwoWay}" Minimum="20" Maximum="2000" Increment="5" FormatString="0 pt" Height="26" FontSize="11" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="Rotation (°)" Classes="inspector-label" />
                                                <NumericUpDown Value="{Binding TextElement.CurveStartAngle, Mode=TwoWay}" Minimum="-180" Maximum="180" Increment="15" FormatString="0°" Height="26" FontSize="11" />
                                            </StackPanel>
                                        </Grid>

                                        <CheckBox IsChecked="{Binding TextElement.CurveInvert, Mode=TwoWay}">
                                            <TextBlock Text="Invert / Reverse Text Orientation" FontSize="10.5" />
                                        </CheckBox>
                                    </StackPanel>

                                    <!-- BÉZIER CURVE MODE CONTROLS -->
                                    <StackPanel Spacing="6" IsVisible="{Binding TextElement.IsBezierMode}">
                                        <!-- Bézier Presets -->
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Curve Shape Presets" Classes="inspector-label" />
                                            <WrapPanel Orientation="Horizontal">
                                                <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="1" Command="{Binding SetBezierPresetCommand}" CommandParameter="Wave"><TextBlock Text="Wave" FontSize="9.5" /></Button>
                                                <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="1" Command="{Binding SetBezierPresetCommand}" CommandParameter="SCurve"><TextBlock Text="S-Curve" FontSize="9.5" /></Button>
                                                <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="1" Command="{Binding SetBezierPresetCommand}" CommandParameter="Bridge"><TextBlock Text="Bridge (Arch)" FontSize="9.5" /></Button>
                                                <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="1" Command="{Binding SetBezierPresetCommand}" CommandParameter="Valley"><TextBlock Text="Valley (Dip)" FontSize="9.5" /></Button>
                                                <Button Classes="secondary-btn" Height="24" Padding="5,1" Margin="1" Command="{Binding SetBezierPresetCommand}" CommandParameter="Rise"><TextBlock Text="Rise" FontSize="9.5" /></Button>
                                            </WrapPanel>
                                        </StackPanel>

                                        <!-- Control Point 1 & Control Point 2 -->
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="Control Pt 1 (X, Y)" Classes="inspector-label" />
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="2">
                                                    <NumericUpDown Grid.Column="0" Value="{Binding TextElement.BezierP1X, Mode=TwoWay}" Minimum="-0.5" Maximum="1.5" Increment="0.05" FormatString="0.00" Height="26" FontSize="10" />
                                                    <NumericUpDown Grid.Column="1" Value="{Binding TextElement.BezierP1Y, Mode=TwoWay}" Minimum="-0.5" Maximum="1.5" Increment="0.05" FormatString="0.00" Height="26" FontSize="10" />
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="Control Pt 2 (X, Y)" Classes="inspector-label" />
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="2">
                                                    <NumericUpDown Grid.Column="0" Value="{Binding TextElement.BezierP2X, Mode=TwoWay}" Minimum="-0.5" Maximum="1.5" Increment="0.05" FormatString="0.00" Height="26" FontSize="10" />
                                                    <NumericUpDown Grid.Column="1" Value="{Binding TextElement.BezierP2Y, Mode=TwoWay}" Minimum="-0.5" Maximum="1.5" Increment="0.05" FormatString="0.00" Height="26" FontSize="10" />
                                                </Grid>
                                            </StackPanel>
                                        </Grid>

                                        <CheckBox IsChecked="{Binding TextElement.CurveInvert, Mode=TwoWay}">
                                            <TextBlock Text="Invert / Reverse Text Orientation" FontSize="10.5" />
                                        </CheckBox>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- ========================================================= -->
                            <!-- PER-CHARACTER TRANSFORMS & SCALING                        -->
                            <!-- ========================================================= -->
                            <Border Background="{DynamicResource M3SurfaceContainerLowBrush}" CornerRadius="{StaticResource M3ShapeCornerMedium}" Padding="8" BorderThickness="1" BorderBrush="{DynamicResource M3OutlineVariantBrush}">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Glyph Offsets &amp; Scaling" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Classes="secondary-btn" Height="22" Padding="6,1" Command="{Binding ResetTextTransformsCommand}" ToolTip.Tip="Reset scale and baseline transforms">
                                            <TextBlock Text="Reset" FontSize="9.5" />
                                        </Button>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="Baseline Shift" Classes="inspector-label" />
                                            <NumericUpDown Value="{Binding TextElement.BaselineShift, Mode=TwoWay}" Minimum="-100" Maximum="100" Increment="1" FormatString="0 pt" Height="26" FontSize="10.5" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="Char Rotation (°)" Classes="inspector-label" />
                                            <NumericUpDown Value="{Binding TextElement.CharacterRotation, Mode=TwoWay}" Minimum="-180" Maximum="180" Increment="5" FormatString="0°" Height="26" FontSize="10.5" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="6">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="Scale X" Classes="inspector-label" />
                                            <NumericUpDown Value="{Binding TextElement.ScaleX, Mode=TwoWay}" Minimum="0.1" Maximum="5.0" Increment="0.1" FormatString="0.0" Height="26" FontSize="10.5" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="Scale Y" Classes="inspector-label" />
                                            <NumericUpDown Value="{Binding TextElement.ScaleY, Mode=TwoWay}" Minimum="0.1" Maximum="5.0" Increment="0.1" FormatString="0.0" Height="26" FontSize="10.5" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Classes="mini-tool-btn" Width="28" Height="26" Margin="0,14,0,0"
                                                Classes.active="{Binding TextElement.FlipX, FallbackValue=False}"
                                                Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).ToggleTextFlipXCommand}"
                                                ToolTip.Tip="Flip Text Horizontally">
                                            <materialIcons:MaterialIcon Kind="FlipHorizontal" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                        </Button>
                                        <Button Grid.Column="3" Classes="mini-tool-btn" Width="28" Height="26" Margin="0,14,0,0"
                                                Classes.active="{Binding TextElement.FlipY, FallbackValue=False}"
                                                Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).ToggleTextFlipYCommand}"
                                                ToolTip.Tip="Flip Text Vertically">
                                            <materialIcons:MaterialIcon Kind="FlipVertical" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Border>

                    <!-- 2. SHAPE & BADGE CARD (Visible when Shape element is selected) -->
                    <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource M3ShapeCornerLarge}"
                            BoxShadow="{StaticResource M3ElevationLevel1}"
                            Padding="12"
                            IsVisible="{Binding ShapeElement, Converter={StaticResource NullToBooleanConverter}}">
                        <StackPanel Spacing="10">
                            <!-- Card Header with Tonal Avatar -->
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
                                <Border Grid.Column="0" Width="30" Height="30"
                                        CornerRadius="{StaticResource M3ShapeCornerSmall}"
                                        Background="{DynamicResource M3PrimaryContainerBrush}">
                                    <materialIcons:MaterialIcon Kind="ShapeOutline" Width="16" Height="16"
                                                               Foreground="{DynamicResource M3PrimaryBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="Shape Geometry &amp; Badges" FontWeight="SemiBold" FontSize="12.5"
                                               Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                    <TextBlock Text="29 vector forms, strokes &amp; badges" FontSize="10"
                                               Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </StackPanel>
                            </Grid>

                            <!-- Shape Type Selector Grid -->
                            <StackPanel Spacing="4">
                                <Button Classes="m3-section-toggle"
                                        Command="{Binding TogglePresetGeometryExpandedCommand}"
                                        ToolTip.Tip="Collapse / Expand Preset Geometries">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Preset Geometry (Certificates &amp; Polygons)" Classes="inspector-label" VerticalAlignment="Center" />
                                        <materialIcons:MaterialIcon Grid.Column="1" Kind="{Binding IsPresetGeometryExpanded, Converter={StaticResource BooleanToStringConverter}, ConverterParameter='ChevronUp|ChevronDown'}" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <Panel IsVisible="{Binding IsPresetGeometryExpanded}">
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Classes="m3-preset-chip" Height="24" Padding="6,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="Rectangle"><StackPanel Orientation="Horizontal" Spacing="4"><materialIcons:MaterialIcon Kind="SquareOutline" Width="11" Height="11" Foreground="{DynamicResource M3PrimaryBrush}" /><TextBlock Text="Rect" FontSize="10" /></StackPanel></Button>
                                        <Button Classes="m3-preset-chip" Height="24" Padding="6,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="RoundedRectangle"><StackPanel Orientation="Horizontal" Spacing="4"><materialIcons:MaterialIcon Kind="RoundedCorner" Width="11" Height="11" Foreground="{DynamicResource M3PrimaryBrush}" /><TextBlock Text="Rounded" FontSize="10" /></StackPanel></Button>
                                        <Button Classes="m3-preset-chip" Height="24" Padding="6,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="Circle"><StackPanel Orientation="Horizontal" Spacing="4"><materialIcons:MaterialIcon Kind="CircleOutline" Width="11" Height="11" Foreground="{DynamicResource M3PrimaryBrush}" /><TextBlock Text="Circle" FontSize="10" /></StackPanel></Button>
                                        <Button Classes="m3-preset-chip" Height="24" Padding="6,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="BezierCurve"><StackPanel Orientation="Horizontal" Spacing="4"><materialIcons:MaterialIcon Kind="VectorBezier" Width="11" Height="11" Foreground="{DynamicResource M3PrimaryBrush}" /><TextBlock Text="Bézier Curve" FontSize="10" /></StackPanel></Button>
                                        <Button Classes="m3-preset-chip" Height="24" Padding="6,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="CurvedArrow"><StackPanel Orientation="Horizontal" Spacing="4"><materialIcons:MaterialIcon Kind="ArrowTopRight" Width="11" Height="11" Foreground="{DynamicResource M3PrimaryBrush}" /><TextBlock Text="Curved Arrow" FontSize="10" /></StackPanel></Button>
                                        <Button Classes="m3-preset-chip" Height="24" Padding="6,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="SCurveConnector"><StackPanel Orientation="Horizontal" Spacing="4"><materialIcons:MaterialIcon Kind="VectorCurve" Width="11" Height="11" Foreground="{DynamicResource M3PrimaryBrush}" /><TextBlock Text="S-Connector" FontSize="10" /></StackPanel></Button>
                                        <Button Classes="m3-preset-chip" Height="24" Padding="6,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="WaveLine"><StackPanel Orientation="Horizontal" Spacing="4"><materialIcons:MaterialIcon Kind="Waves" Width="11" Height="11" Foreground="{DynamicResource M3PrimaryBrush}" /><TextBlock Text="Wave Line" FontSize="10" /></StackPanel></Button>
                                        <Button Classes="m3-preset-chip" Height="24" Padding="6,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="ArcLine"><StackPanel Orientation="Horizontal" Spacing="4"><materialIcons:MaterialIcon Kind="Arch" Width="11" Height="11" Foreground="{DynamicResource M3PrimaryBrush}" /><TextBlock Text="Arc" FontSize="10" /></StackPanel></Button>
                                        <Button Classes="m3-preset-chip" Height="24" Padding="6,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="CurlyBrace"><StackPanel Orientation="Horizontal" Spacing="4"><materialIcons:MaterialIcon Kind="CodeBraces" Width="11" Height="11" Foreground="{DynamicResource M3PrimaryBrush}" /><TextBlock Text="Curly Brace" FontSize="10" /></StackPanel></Button>
                                        <Button Classes="m3-preset-chip" Height="24" Padding="6,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="CurvedCallout"><StackPanel Orientation="Horizontal" Spacing="4"><materialIcons:MaterialIcon Kind="MessageOutline" Width="11" Height="11" Foreground="{DynamicResource M3PrimaryBrush}" /><TextBlock Text="Curved Bubble" FontSize="10" /></StackPanel></Button>
                                        <Button Classes="m3-preset-chip" Height="24" Padding="6,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="Teardrop"><StackPanel Orientation="Horizontal" Spacing="4"><materialIcons:MaterialIcon Kind="WaterOutline" Width="11" Height="11" Foreground="{DynamicResource M3PrimaryBrush}" /><TextBlock Text="Teardrop" FontSize="10" /></StackPanel></Button>
                                        <Button Classes="m3-preset-chip" Height="24" Padding="6,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="WaveRibbon"><StackPanel Orientation="Horizontal" Spacing="4"><materialIcons:MaterialIcon Kind="Ribbon" Width="11" Height="11" Foreground="{DynamicResource M3PrimaryBrush}" /><TextBlock Text="Wave Ribbon" FontSize="10" /></StackPanel></Button>
                                        <Button Classes="m3-preset-chip" Height="24" Padding="6,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="OrganicBlob"><StackPanel Orientation="Horizontal" Spacing="4"><materialIcons:MaterialIcon Kind="ShapeOvalPlus" Width="11" Height="11" Foreground="{DynamicResource M3PrimaryBrush}" /><TextBlock Text="Blob" FontSize="10" /></StackPanel></Button>
                                        <Button Classes="m3-preset-chip" Height="24" Padding="6,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="MedalRibbonBadge"><StackPanel Orientation="Horizontal" Spacing="4"><materialIcons:MaterialIcon Kind="MedalOutline" Width="11" Height="11" Foreground="{DynamicResource M3PrimaryBrush}" /><TextBlock Text="Medal Ribbon" FontSize="10" /></StackPanel></Button>
                                        <Button Classes="m3-preset-chip" Height="24" Padding="6,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="LaurelWreathSeal"><StackPanel Orientation="Horizontal" Spacing="4"><materialIcons:MaterialIcon Kind="Seal" Width="11" Height="11" Foreground="{DynamicResource M3PrimaryBrush}" /><TextBlock Text="Laurel Seal" FontSize="10" /></StackPanel></Button>
                                        <Button Classes="m3-preset-chip" Height="24" Padding="6,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="RosetteSeal"><StackPanel Orientation="Horizontal" Spacing="4"><materialIcons:MaterialIcon Kind="DecagramOutline" Width="11" Height="11" Foreground="{DynamicResource M3PrimaryBrush}" /><TextBlock Text="Rosette" FontSize="10" /></StackPanel></Button>
                                        <Button Classes="m3-preset-chip" Height="24" Padding="6,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="RibbonBanner"><StackPanel Orientation="Horizontal" Spacing="4"><materialIcons:MaterialIcon Kind="BookmarkOutline" Width="11" Height="11" Foreground="{DynamicResource M3PrimaryBrush}" /><TextBlock Text="Banner" FontSize="10" /></StackPanel></Button>
                                        <Button Classes="m3-preset-chip" Height="24" Padding="6,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="CornerPolygonalAccentTopLeft"><StackPanel Orientation="Horizontal" Spacing="4"><materialIcons:MaterialIcon Kind="VectorPolygon" Width="11" Height="11" Foreground="{DynamicResource M3PrimaryBrush}" /><TextBlock Text="Corner TL" FontSize="10" /></StackPanel></Button>
                                        <Button Classes="m3-preset-chip" Height="24" Padding="6,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="CornerPolygonalAccentBottomRight"><StackPanel Orientation="Horizontal" Spacing="4"><materialIcons:MaterialIcon Kind="VectorPolygon" Width="11" Height="11" Foreground="{DynamicResource M3PrimaryBrush}" /><TextBlock Text="Corner BR" FontSize="10" /></StackPanel></Button>
                                        <Button Classes="m3-preset-chip" Height="24" Padding="6,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="ShieldBadge"><StackPanel Orientation="Horizontal" Spacing="4"><materialIcons:MaterialIcon Kind="ShieldOutline" Width="11" Height="11" Foreground="{DynamicResource M3PrimaryBrush}" /><TextBlock Text="Shield" FontSize="10" /></StackPanel></Button>
                                        <Button Classes="m3-preset-chip" Height="24" Padding="6,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="Star5"><StackPanel Orientation="Horizontal" Spacing="4"><materialIcons:MaterialIcon Kind="StarOutline" Width="11" Height="11" Foreground="{DynamicResource M3PrimaryBrush}" /><TextBlock Text="Star 5" FontSize="10" /></StackPanel></Button>
                                        <Button Classes="m3-preset-chip" Height="24" Padding="6,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="Star8Badge"><StackPanel Orientation="Horizontal" Spacing="4"><materialIcons:MaterialIcon Kind="DecagramOutline" Width="11" Height="11" Foreground="{DynamicResource M3PrimaryBrush}" /><TextBlock Text="Star 8" FontSize="10" /></StackPanel></Button>
                                        <Button Classes="m3-preset-chip" Height="24" Padding="6,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="Triangle"><StackPanel Orientation="Horizontal" Spacing="4"><materialIcons:MaterialIcon Kind="TriangleOutline" Width="11" Height="11" Foreground="{DynamicResource M3PrimaryBrush}" /><TextBlock Text="Triangle" FontSize="10" /></StackPanel></Button>
                                        <Button Classes="m3-preset-chip" Height="24" Padding="6,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="RightTriangle"><StackPanel Orientation="Horizontal" Spacing="4"><materialIcons:MaterialIcon Kind="TriangleOutline" Width="11" Height="11" Foreground="{DynamicResource M3PrimaryBrush}" /><TextBlock Text="Rt. Tri" FontSize="10" /></StackPanel></Button>
                                        <Button Classes="m3-preset-chip" Height="24" Padding="6,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="Diamond"><StackPanel Orientation="Horizontal" Spacing="4"><materialIcons:MaterialIcon Kind="CardsDiamondOutline" Width="11" Height="11" Foreground="{DynamicResource M3PrimaryBrush}" /><TextBlock Text="Diamond" FontSize="10" /></StackPanel></Button>
                                        <Button Classes="m3-preset-chip" Height="24" Padding="6,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="Chevron"><StackPanel Orientation="Horizontal" Spacing="4"><materialIcons:MaterialIcon Kind="ChevronRight" Width="11" Height="11" Foreground="{DynamicResource M3PrimaryBrush}" /><TextBlock Text="Chevron" FontSize="10" /></StackPanel></Button>
                                        <Button Classes="m3-preset-chip" Height="24" Padding="6,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="Trapezoid"><StackPanel Orientation="Horizontal" Spacing="4"><materialIcons:MaterialIcon Kind="VectorPolygon" Width="11" Height="11" Foreground="{DynamicResource M3PrimaryBrush}" /><TextBlock Text="Trapezoid" FontSize="10" /></StackPanel></Button>
                                        <Button Classes="m3-preset-chip" Height="24" Padding="6,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="Parallelogram"><StackPanel Orientation="Horizontal" Spacing="4"><materialIcons:MaterialIcon Kind="VectorPolygon" Width="11" Height="11" Foreground="{DynamicResource M3PrimaryBrush}" /><TextBlock Text="Parallelogram" FontSize="10" /></StackPanel></Button>
                                        <Button Classes="m3-preset-chip" Height="24" Padding="6,1" Margin="2" Command="{Binding SetShapeTypeCommand}" CommandParameter="CustomSvgPath"><StackPanel Orientation="Horizontal" Spacing="4"><materialIcons:MaterialIcon Kind="Draw" Width="11" Height="11" Foreground="{DynamicResource M3PrimaryBrush}" /><TextBlock Text="Custom SVG" FontSize="10" /></StackPanel></Button>
                                    </WrapPanel>
                                </Panel>
                            </StackPanel>

                            <!-- Line Dash Pattern & Endcaps (for Lines & Curves) -->
                            <StackPanel Spacing="4">
                                <Button Classes="m3-section-toggle"
                                        Command="{Binding ToggleLineStrokePatternExpandedCommand}"
                                        ToolTip.Tip="Collapse / Expand Line Stroke Pattern">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Line Stroke Pattern" Classes="inspector-label" VerticalAlignment="Center" />
                                        <materialIcons:MaterialIcon Grid.Column="1" Kind="{Binding IsLineStrokePatternExpanded, Converter={StaticResource BooleanToStringConverter}, ConverterParameter='ChevronUp|ChevronDown'}" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <Panel IsVisible="{Binding IsLineStrokePatternExpanded}">
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Classes="m3-preset-chip" Height="24" Padding="8,1" Margin="2" Command="{Binding SetShapeDashStyleCommand}" CommandParameter="Solid"><StackPanel Orientation="Horizontal" Spacing="4"><materialIcons:MaterialIcon Kind="Minus" Width="11" Height="11" Foreground="{DynamicResource M3PrimaryBrush}" /><TextBlock Text="Solid" FontSize="10" /></StackPanel></Button>
                                        <Button Classes="m3-preset-chip" Height="24" Padding="8,1" Margin="2" Command="{Binding SetShapeDashStyleCommand}" CommandParameter="Dashed"><TextBlock Text="Dashed" FontSize="10" /></Button>
                                        <Button Classes="m3-preset-chip" Height="24" Padding="8,1" Margin="2" Command="{Binding SetShapeDashStyleCommand}" CommandParameter="Dotted"><TextBlock Text="Dotted" FontSize="10" /></Button>
                                        <Button Classes="m3-preset-chip" Height="24" Padding="8,1" Margin="2" Command="{Binding SetShapeDashStyleCommand}" CommandParameter="DashDot"><TextBlock Text="Dash-Dot" FontSize="10" /></Button>
                                    </WrapPanel>
                                </Panel>
                            </StackPanel>

                            <!-- Custom SVG Path Data (Visible when CustomSvgPath is selected) -->
                            <StackPanel Spacing="3" IsVisible="{Binding ShapeElement.ShapeType, Converter={StaticResource EqualityConverter}, ConverterParameter=CustomSvgPath}">
                                <TextBlock Text="Custom Vector Path (SVG 'd')" Classes="inspector-label" />
                                <TextBox Classes="m3-outlined" Text="{Binding ShapeElement.CustomPathData, Mode=TwoWay}"
                                         AcceptsReturn="True" TextWrapping="Wrap" Height="50" FontSize="11"
                                         PlaceholderText="e.g. M 0,0 L 100,0 L 50,100 Z" />
                            </StackPanel>

                            <!-- Colors Section (Fill, Secondary, Border) -->
                            <StackPanel Spacing="4">
                                <Button Classes="m3-section-toggle"
                                        Command="{Binding ToggleColorsExpandedCommand}"
                                        ToolTip.Tip="Collapse / Expand Colors">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Fill &amp; Border Colors" Classes="inspector-label" VerticalAlignment="Center" />
                                        <materialIcons:MaterialIcon Grid.Column="1" Kind="{Binding IsColorsExpanded, Converter={StaticResource BooleanToStringConverter}, ConverterParameter='ChevronUp|ChevronDown'}" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <StackPanel Spacing="8" IsVisible="{Binding IsColorsExpanded}">
                                    <!-- Fill Color Swatches & Custom ColorPicker -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Fill Color" Classes="inspector-label" />
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <Button Classes="color-studio-btn" ToolTip.Tip="Custom Shape Fill Studio">
                                                <Button.Flyout>
                                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                                        <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                                                                BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="{StaticResource M3ShapeCornerMedium}"
                                                                Padding="10"
                                                                BoxShadow="{StaticResource M3ElevationLevel3}">
                                                            <ColorView Color="{Binding ShapeElement.FillColorHex, Mode=TwoWay, Converter={StaticResource HexToColorConverter}}"
                                                                       IsAlphaEnabled="True" IsHexInputVisible="True" Width="280" />
                                                        </Border>
                                                    </Flyout>
                                                </Button.Flyout>
                                                <Grid Width="24" Height="24">
                                                    <Border CornerRadius="12" Width="24" Height="24">
                                                        <Border.Background>
                                                            <ConicGradientBrush Center="0.5,0.5">
                                                                <GradientStop Color="#FF0000" Offset="0.0" /><GradientStop Color="#FFFF00" Offset="0.17" /><GradientStop Color="#00FF00" Offset="0.33" /><GradientStop Color="#00FFFF" Offset="0.50" /><GradientStop Color="#0000FF" Offset="0.67" /><GradientStop Color="#FF00FF" Offset="0.83" /><GradientStop Color="#FF0000" Offset="1.0" />
                                                            </ConicGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <Border Margin="3.5" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="{DynamicResource M3SurfaceContainerLowBrush}">
                                                        <materialIcons:MaterialIcon Kind="Palette" Width="11" Height="11" Foreground="{DynamicResource M3OnSurfaceBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </Grid>
                                            </Button>
                                            <ItemsControl ItemsSource="{Binding ColorSwatches}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="vm:ColorSwatchItem">
                                                        <Button Width="22" Height="22" Margin="1.5" CornerRadius="{StaticResource M3ShapeCornerFull}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1"
                                                                Background="{Binding Hex, Converter={StaticResource HexToBrushConverter}}"
                                                                Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).SetShapeFillColorCommand}"
                                                                CommandParameter="{Binding Hex}" ToolTip.Tip="{Binding Name}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Secondary Color (for Medal Ribbons / Dual-Tone Polygons) -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Secondary / Ribbon Tail Color" Classes="inspector-label" />
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <Button Classes="color-studio-btn" ToolTip.Tip="Secondary Accent Color">
                                                <Button.Flyout>
                                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                                        <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                                                                BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="{StaticResource M3ShapeCornerMedium}"
                                                                Padding="10"
                                                                BoxShadow="{StaticResource M3ElevationLevel3}">
                                                            <ColorView Color="{Binding ShapeElement.SecondaryFillColorHex, Mode=TwoWay, Converter={StaticResource HexToColorConverter}}"
                                                                       IsAlphaEnabled="True" IsHexInputVisible="True" Width="280" />
                                                        </Border>
                                                    </Flyout>
                                                </Button.Flyout>
                                                <Grid Width="24" Height="24">
                                                    <Border CornerRadius="12" Width="24" Height="24" Background="{Binding ShapeElement.SecondaryFillColorHex, Converter={StaticResource HexToBrushConverter}}" />
                                                    <Border Margin="3.5" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="{DynamicResource M3SurfaceContainerLowBrush}">
                                                        <materialIcons:MaterialIcon Kind="Ribbon" Width="11" Height="11" Foreground="{DynamicResource M3OnSurfaceBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </Grid>
                                            </Button>
                                            <Button Width="22" Height="22" Margin="1.5" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="#990000" Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).SetShapeFillColorCommand}" CommandParameter="#990000" ToolTip.Tip="Crimson Red" />
                                            <Button Width="22" Height="22" Margin="1.5" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="#0F172A" Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).SetShapeFillColorCommand}" CommandParameter="#0F172A" ToolTip.Tip="Navy Slate" />
                                            <Button Width="22" Height="22" Margin="1.5" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="#D97706" Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).SetShapeFillColorCommand}" CommandParameter="#D97706" ToolTip.Tip="Gold Amber" />
                                            <Button Width="22" Height="22" Margin="1.5" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="#16A34A" Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).SetShapeFillColorCommand}" CommandParameter="#16A34A" ToolTip.Tip="Emerald" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Stroke / Border Color Swatches & Custom ColorPicker -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Border / Stroke Color" Classes="inspector-label" />
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <Button Classes="color-studio-btn" ToolTip.Tip="Custom Stroke Color Studio">
                                                <Button.Flyout>
                                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                                        <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                                                                BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="{StaticResource M3ShapeCornerMedium}"
                                                                Padding="10"
                                                                BoxShadow="{StaticResource M3ElevationLevel3}">
                                                            <ColorView Color="{Binding ShapeElement.StrokeColorHex, Mode=TwoWay, Converter={StaticResource HexToColorConverter}}"
                                                                       IsAlphaEnabled="True" IsHexInputVisible="True" Width="280" />
                                                        </Border>
                                                    </Flyout>
                                                </Button.Flyout>
                                                <Grid Width="24" Height="24">
                                                    <Border CornerRadius="12" Width="24" Height="24">
                                                        <Border.Background>
                                                            <ConicGradientBrush Center="0.5,0.5">
                                                                <GradientStop Color="#FF0000" Offset="0.0" /><GradientStop Color="#FFFF00" Offset="0.17" /><GradientStop Color="#00FF00" Offset="0.33" /><GradientStop Color="#00FFFF" Offset="0.50" /><GradientStop Color="#0000FF" Offset="0.67" /><GradientStop Color="#FF00FF" Offset="0.83" /><GradientStop Color="#FF0000" Offset="1.0" />
                                                            </ConicGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <Border Margin="3.5" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="{DynamicResource M3SurfaceContainerLowBrush}">
                                                        <materialIcons:MaterialIcon Kind="SquareOutline" Width="11" Height="11" Foreground="{DynamicResource M3OnSurfaceBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </Grid>
                                            </Button>
                                            <ItemsControl ItemsSource="{Binding ColorSwatches}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="vm:ColorSwatchItem">
                                                        <Button Width="22" Height="22" Margin="1.5" CornerRadius="{StaticResource M3ShapeCornerFull}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1"
                                                                Background="{Binding Hex, Converter={StaticResource HexToBrushConverter}}"
                                                                Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).SetShapeStrokeColorCommand}"
                                                                CommandParameter="{Binding Hex}" ToolTip.Tip="{Binding Name}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- Radius, Border Width & Badge Text Section -->
                            <StackPanel Spacing="4">
                                <Button Classes="m3-section-toggle"
                                        Command="{Binding ToggleDimensionsExpandedCommand}"
                                        ToolTip.Tip="Collapse / Expand Radius &amp; Dimensions">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Radius, Border &amp; Badge Text" Classes="inspector-label" VerticalAlignment="Center" />
                                        <materialIcons:MaterialIcon Grid.Column="1" Kind="{Binding IsDimensionsExpanded, Converter={StaticResource BooleanToStringConverter}, ConverterParameter='ChevronUp|ChevronDown'}" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <StackPanel Spacing="8" IsVisible="{Binding IsDimensionsExpanded}">
                                    <!-- Corner Radius & Border Thickness -->
                                    <Grid ColumnDefinitions="*,*">
                                        <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,4,0">
                                            <TextBlock Text="Corner Radius" Classes="inspector-label" />
                                            <NumericUpDown Value="{Binding ShapeElement.CornerRadius, Mode=TwoWay}"
                                                           Minimum="0" Maximum="100" Increment="1" FormatString="0"
                                                           HorizontalAlignment="Stretch" Height="28" FontSize="12" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Spacing="3" Margin="4,0,0,0">
                                            <TextBlock Text="Border Width" Classes="inspector-label" />
                                            <NumericUpDown Value="{Binding ShapeElement.StrokeThickness, Mode=TwoWay}"
                                                           Minimum="0" Maximum="20" Increment="0.5" FormatString="0.0"
                                                           HorizontalAlignment="Stretch" Height="28" FontSize="12" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Shape Center Label (for Badges & Buttons) -->
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Center Label / Badge Text" Classes="inspector-label" />
                                        <TextBox Classes="m3-outlined" Text="{Binding ShapeElement.Label, Mode=TwoWay}" Height="28" FontSize="12" PlaceholderText="e.g. APPROVED, 1, ✦..." />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*" IsVisible="{Binding ShapeElement.Label, Converter={StaticResource NullToBooleanConverter}}">
                                <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,4,0">
                                    <TextBlock Text="Label Size" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding ShapeElement.LabelFontSize, Mode=TwoWay}"
                                                   Minimum="8" Maximum="72" Increment="1" FormatString="0"
                                                   HorizontalAlignment="Stretch" Height="28" FontSize="12" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3" Margin="4,0,0,0">
                                    <TextBlock Text="Label Color" Classes="inspector-label" />
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button Classes="color-studio-btn" ToolTip.Tip="Custom Label Color Studio">
                                            <Button.Flyout>
                                                <Flyout Placement="BottomEdgeAlignedLeft">
                                                    <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                                                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="{StaticResource M3ShapeCornerMedium}"
                                                            Padding="10"
                                                            BoxShadow="{StaticResource M3ElevationLevel3}">
                                                        <ColorView Color="{Binding ShapeElement.LabelColorHex, Mode=TwoWay, Converter={StaticResource HexToColorConverter}}"
                                                                   IsAlphaEnabled="True" IsHexInputVisible="True" Width="280" />
                                                    </Border>
                                                </Flyout>
                                            </Button.Flyout>
                                            <Grid Width="20" Height="20">
                                                <Border CornerRadius="{StaticResource M3ShapeCornerFull}" Width="20" Height="20">
                                                    <Border.Background>
                                                        <ConicGradientBrush Center="0.5,0.5">
                                                            <GradientStop Color="#FF0000" Offset="0.0" /><GradientStop Color="#FFFF00" Offset="0.17" /><GradientStop Color="#00FF00" Offset="0.33" /><GradientStop Color="#00FFFF" Offset="0.50" /><GradientStop Color="#0000FF" Offset="0.67" /><GradientStop Color="#FF00FF" Offset="0.83" /><GradientStop Color="#FF0000" Offset="1.0" />
                                                        </ConicGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <Border Margin="2.5" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="{DynamicResource M3SurfaceContainerLowBrush}">
                                                    <materialIcons:MaterialIcon Kind="Palette" Width="9" Height="9" Foreground="{DynamicResource M3OnSurfaceBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </Button>
                                        <Button Width="20" Height="20" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="{DynamicResource M3SurfaceBrush}" BorderBrush="{DynamicResource M3OutlineBrush}" BorderThickness="1" Command="{Binding SetShapeLabelColorCommand}" CommandParameter="#FFFFFF" />
                                        <Button Width="20" Height="20" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="#201F1E" Command="{Binding SetShapeLabelColorCommand}" CommandParameter="#201F1E" />
                                        <Button Width="20" Height="20" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="#0F6CBD" Command="{Binding SetShapeLabelColorCommand}" CommandParameter="#0F6CBD" />
                                        <Button Width="20" Height="20" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="#16A34A" Command="{Binding SetShapeLabelColorCommand}" CommandParameter="#16A34A" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 3. IMAGE CARD (Visible when Image is selected) -->
                    <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource M3ShapeCornerLarge}"
                            BoxShadow="{StaticResource M3ElevationLevel1}"
                            Padding="12"
                            IsVisible="{Binding ImageElement, Converter={StaticResource NullToBooleanConverter}}">
                        <StackPanel Spacing="10">
                            <!-- Card Header with Tonal Avatar -->
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
                                <Border Grid.Column="0" Width="30" Height="30"
                                        CornerRadius="{StaticResource M3ShapeCornerSmall}"
                                        Background="{DynamicResource M3PrimaryContainerBrush}">
                                    <materialIcons:MaterialIcon Kind="ImageOutline" Width="16" Height="16"
                                                               Foreground="{DynamicResource M3PrimaryBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="Image Properties" FontWeight="SemiBold" FontSize="12.5"
                                               Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                    <TextBlock Text="Aspect ratio, radius &amp; border" FontSize="10"
                                               Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Alt Text / Caption" Classes="inspector-label" />
                                <TextBox Classes="m3-outlined" Text="{Binding ImageElement.AltText, Mode=TwoWay}" Height="28" FontSize="12" />
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Image File Path" Classes="inspector-label" />
                                <TextBox Classes="m3-outlined" Text="{Binding ImageElement.ImagePath, Mode=TwoWay}" Height="28" FontSize="11" PlaceholderText="/path/to/image.png" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,4,0">
                                    <TextBlock Text="Corner Radius" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding ImageElement.CornerRadius, Mode=TwoWay}"
                                                   Minimum="0" Maximum="60" Increment="1" FormatString="0"
                                                   HorizontalAlignment="Stretch" Height="28" FontSize="12" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3" Margin="4,0,0,0">
                                    <TextBlock Text="Border Width" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding ImageElement.BorderThickness, Mode=TwoWay}"
                                                   Minimum="0" Maximum="10" Increment="0.5" FormatString="0.0"
                                                   HorizontalAlignment="Stretch" Height="28" FontSize="12" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Preserve Aspect Ratio" FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ImageElement.KeepAspectRatio, Mode=TwoWay}" OnContent="" OffContent="" Margin="0" />
                            </Grid>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Border Color" Classes="inspector-label" />
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Button Classes="color-studio-btn" ToolTip.Tip="Custom Border Color Studio">
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft">
                                                <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                                                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource M3ShapeCornerMedium}"
                                                        Padding="10"
                                                        BoxShadow="{StaticResource M3ElevationLevel3}">
                                                    <ColorView Color="{Binding ImageElement.BorderColorHex, Mode=TwoWay, Converter={StaticResource HexToColorConverter}}"
                                                               IsAlphaEnabled="True" IsHexInputVisible="True" Width="280" />
                                                </Border>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Grid Width="24" Height="24">
                                            <Border CornerRadius="12" Width="24" Height="24">
                                                <Border.Background>
                                                    <ConicGradientBrush Center="0.5,0.5">
                                                        <GradientStop Color="#FF0000" Offset="0.0" /><GradientStop Color="#FFFF00" Offset="0.17" /><GradientStop Color="#00FF00" Offset="0.33" /><GradientStop Color="#00FFFF" Offset="0.50" /><GradientStop Color="#0000FF" Offset="0.67" /><GradientStop Color="#FF00FF" Offset="0.83" /><GradientStop Color="#FF0000" Offset="1.0" />
                                                    </ConicGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border Margin="3.5" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="{DynamicResource M3SurfaceContainerLowBrush}">
                                                <materialIcons:MaterialIcon Kind="Palette" Width="11" Height="11" Foreground="{DynamicResource M3OnSurfaceBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <ItemsControl ItemsSource="{Binding ColorSwatches}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:ColorSwatchItem">
                                                <Button Width="22" Height="22" Margin="1.5" CornerRadius="{StaticResource M3ShapeCornerFull}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1"
                                                        Background="{Binding Hex, Converter={StaticResource HexToBrushConverter}}"
                                                        Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).SetImageBorderColorCommand}" CommandParameter="{Binding Hex}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 4. DIVIDER CARD (Visible when Divider is selected) -->
                    <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource M3ShapeCornerLarge}"
                            BoxShadow="{StaticResource M3ElevationLevel1}"
                            Padding="12"
                            IsVisible="{Binding DividerElement, Converter={StaticResource NullToBooleanConverter}}">
                        <StackPanel Spacing="10">
                            <!-- Card Header with Tonal Avatar -->
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
                                <Border Grid.Column="0" Width="30" Height="30"
                                        CornerRadius="{StaticResource M3ShapeCornerSmall}"
                                        Background="{DynamicResource M3PrimaryContainerBrush}">
                                    <materialIcons:MaterialIcon Kind="Minus" Width="16" Height="16"
                                                               Foreground="{DynamicResource M3PrimaryBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="Divider Line &amp; Decorative Wave" FontWeight="SemiBold" FontSize="12.5"
                                               Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                    <TextBlock Text="6 decorative wave &amp; stroke styles" FontSize="10"
                                               Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </StackPanel>
                            </Grid>

                            <!-- Divider Style Presets -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Divider Style (6 Styles)" Classes="inspector-label" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Classes="m3-preset-chip" Height="24" Padding="6,1" Margin="2" Command="{Binding SetDividerStyleCommand}" CommandParameter="Straight"><StackPanel Orientation="Horizontal" Spacing="4"><materialIcons:MaterialIcon Kind="Minus" Width="11" Height="11" Foreground="{DynamicResource M3PrimaryBrush}" /><TextBlock Text="Straight" FontSize="10" /></StackPanel></Button>
                                    <Button Classes="m3-preset-chip" Height="24" Padding="6,1" Margin="2" Command="{Binding SetDividerStyleCommand}" CommandParameter="Wave"><StackPanel Orientation="Horizontal" Spacing="4"><materialIcons:MaterialIcon Kind="Waves" Width="11" Height="11" Foreground="{DynamicResource M3PrimaryBrush}" /><TextBlock Text="Wave" FontSize="10" /></StackPanel></Button>
                                    <Button Classes="m3-preset-chip" Height="24" Padding="6,1" Margin="2" Command="{Binding SetDividerStyleCommand}" CommandParameter="SCurve"><StackPanel Orientation="Horizontal" Spacing="4"><materialIcons:MaterialIcon Kind="VectorCurve" Width="11" Height="11" Foreground="{DynamicResource M3PrimaryBrush}" /><TextBlock Text="S-Curve" FontSize="10" /></StackPanel></Button>
                                    <Button Classes="m3-preset-chip" Height="24" Padding="6,1" Margin="2" Command="{Binding SetDividerStyleCommand}" CommandParameter="Arch"><StackPanel Orientation="Horizontal" Spacing="4"><materialIcons:MaterialIcon Kind="Arch" Width="11" Height="11" Foreground="{DynamicResource M3PrimaryBrush}" /><TextBlock Text="Arch" FontSize="10" /></StackPanel></Button>
                                    <Button Classes="m3-preset-chip" Height="24" Padding="6,1" Margin="2" Command="{Binding SetDividerStyleCommand}" CommandParameter="DoubleWave"><StackPanel Orientation="Horizontal" Spacing="4"><materialIcons:MaterialIcon Kind="WaterOutline" Width="11" Height="11" Foreground="{DynamicResource M3PrimaryBrush}" /><TextBlock Text="Double Wave" FontSize="10" /></StackPanel></Button>
                                    <Button Classes="m3-preset-chip" Height="24" Padding="6,1" Margin="2" Command="{Binding SetDividerStyleCommand}" CommandParameter="CalligraphicFlourish"><StackPanel Orientation="Horizontal" Spacing="4"><materialIcons:MaterialIcon Kind="Draw" Width="11" Height="11" Foreground="{DynamicResource M3PrimaryBrush}" /><TextBlock Text="Flourish" FontSize="10" /></StackPanel></Button>
                                </WrapPanel>
                            </StackPanel>

                            <!-- Wave Parameters (Amplitude & Frequency) -->
                            <Grid ColumnDefinitions="*,*" Margin="0,2">
                                <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,4,0">
                                    <TextBlock Text="Wave Amplitude (px)" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding DividerElement.WaveAmplitude, Mode=TwoWay}"
                                                   Minimum="2" Maximum="50" Increment="1" FormatString="0.0"
                                                   HorizontalAlignment="Stretch" Height="28" FontSize="12" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3" Margin="4,0,0,0">
                                    <TextBlock Text="Wave Cycles" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding DividerElement.WaveFrequency, Mode=TwoWay}"
                                                   Minimum="1" Maximum="20" Increment="1" FormatString="0"
                                                   HorizontalAlignment="Stretch" Height="28" FontSize="12" />
                                </StackPanel>
                            </Grid>

                            <!-- Line Dash Pattern -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Dash Pattern" Classes="inspector-label" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Classes="m3-preset-chip" Height="24" Padding="8,1" Margin="2" Command="{Binding SetDividerDashStyleCommand}" CommandParameter="Solid"><StackPanel Orientation="Horizontal" Spacing="4"><materialIcons:MaterialIcon Kind="Minus" Width="11" Height="11" Foreground="{DynamicResource M3PrimaryBrush}" /><TextBlock Text="Solid" FontSize="10" /></StackPanel></Button>
                                    <Button Classes="m3-preset-chip" Height="24" Padding="8,1" Margin="2" Command="{Binding SetDividerDashStyleCommand}" CommandParameter="Dashed"><TextBlock Text="Dashed" FontSize="10" /></Button>
                                    <Button Classes="m3-preset-chip" Height="24" Padding="8,1" Margin="2" Command="{Binding SetDividerDashStyleCommand}" CommandParameter="Dotted"><TextBlock Text="Dotted" FontSize="10" /></Button>
                                    <Button Classes="m3-preset-chip" Height="24" Padding="8,1" Margin="2" Command="{Binding SetDividerDashStyleCommand}" CommandParameter="DashDot"><TextBlock Text="Dash-Dot" FontSize="10" /></Button>
                                </WrapPanel>
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Line Thickness (pt)" Classes="inspector-label" />
                                <NumericUpDown Value="{Binding DividerElement.Thickness, Mode=TwoWay}"
                                               Minimum="0.5" Maximum="20" Increment="0.5" FormatString="0.0"
                                               HorizontalAlignment="Stretch" Height="28" FontSize="12" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Vertical Divider" FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding DividerElement.IsVertical, Mode=TwoWay}" OnContent="" OffContent="" Margin="0" />
                            </Grid>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Line Color" Classes="inspector-label" />
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Button Classes="color-studio-btn" ToolTip.Tip="Custom Line Color Studio">
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft">
                                                <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                                                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource M3ShapeCornerMedium}"
                                                        Padding="10"
                                                        BoxShadow="{StaticResource M3ElevationLevel3}">
                                                    <ColorView Color="{Binding DividerElement.ColorHex, Mode=TwoWay, Converter={StaticResource HexToColorConverter}}"
                                                               IsAlphaEnabled="True" IsHexInputVisible="True" Width="280" />
                                                </Border>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Grid Width="24" Height="24">
                                            <Border CornerRadius="12" Width="24" Height="24">
                                                <Border.Background>
                                                    <ConicGradientBrush Center="0.5,0.5">
                                                        <GradientStop Color="#FF0000" Offset="0.0" /><GradientStop Color="#FFFF00" Offset="0.17" /><GradientStop Color="#00FF00" Offset="0.33" /><GradientStop Color="#00FFFF" Offset="0.50" /><GradientStop Color="#0000FF" Offset="0.67" /><GradientStop Color="#FF00FF" Offset="0.83" /><GradientStop Color="#FF0000" Offset="1.0" />
                                                    </ConicGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border Margin="3.5" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="{DynamicResource M3SurfaceContainerLowBrush}">
                                                <materialIcons:MaterialIcon Kind="Palette" Width="11" Height="11" Foreground="{DynamicResource M3OnSurfaceBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <ItemsControl ItemsSource="{Binding ColorSwatches}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:ColorSwatchItem">
                                                <Button Width="22" Height="22" Margin="1.5" CornerRadius="{StaticResource M3ShapeCornerFull}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1"
                                                        Background="{Binding Hex, Converter={StaticResource HexToBrushConverter}}"
                                                        Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).SetDividerColorCommand}" CommandParameter="{Binding Hex}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 5. TABLE STYLES & ROW/COL CARD (Visible when Table is selected) -->
                    <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource M3ShapeCornerLarge}"
                            Padding="12"
                            BoxShadow="{StaticResource M3ElevationLevel1}"
                            IsVisible="{Binding TableElement, Converter={StaticResource NullToBooleanConverter}}">
                        <StackPanel Spacing="10">
                            <!-- Card Header with Tonal Avatar -->
                            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,2">
                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="{StaticResource M3ShapeCornerSmall}"
                                        Background="{DynamicResource M3SecondaryContainerBrush}" Margin="0,0,8,0">
                                    <materialIcons:MaterialIcon Kind="TableHeadersEye" Width="16" Height="16"
                                                                Foreground="{DynamicResource M3OnSecondaryContainerBrush}"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Table Styles &amp; Grid" FontWeight="SemiBold" FontSize="12.5"
                                               Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                    <TextBlock Text="8 Themes • Rows &amp; Columns" FontSize="10"
                                               Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </StackPanel>
                            </Grid>

                            <!-- Table Style Presets -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Apply Preset Theme" Classes="inspector-label" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding ApplyTableStyleCommand}" CommandParameter="ModernMinimal"><TextBlock Text="Minimal" FontSize="10.5" /></Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding ApplyTableStyleCommand}" CommandParameter="EnterpriseBlue"><TextBlock Text="Enterprise" FontSize="10.5" /></Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding ApplyTableStyleCommand}" CommandParameter="DarkModeSlate"><TextBlock Text="Dark Slate" FontSize="10.5" /></Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding ApplyTableStyleCommand}" CommandParameter="ZebraStriped"><TextBlock Text="Zebra" FontSize="10.5" /></Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding ApplyTableStyleCommand}" CommandParameter="EmeraldGreen"><TextBlock Text="Emerald" FontSize="10.5" /></Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding ApplyTableStyleCommand}" CommandParameter="AmberAccent"><TextBlock Text="Amber" FontSize="10.5" /></Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding ApplyTableStyleCommand}" CommandParameter="FinancialBordered"><TextBlock Text="Financial" FontSize="10.5" /></Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding ApplyTableStyleCommand}" CommandParameter="CompactClean"><TextBlock Text="Compact" FontSize="10.5" /></Button>
                                </WrapPanel>
                            </StackPanel>

                            <!-- Add / Remove Rows and Columns -->
                            <TextBlock Text="Structure &amp; Dimensions" Classes="inspector-label" />
                            <Grid ColumnDefinitions="*,*" Margin="0,2">
                                <Button Grid.Column="0" Classes="m3-tonal-btn" Height="28" Margin="0,0,3,0"
                                        Command="{Binding TableElement.AddRowCommand}" ToolTip.Tip="Add Table Row">
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="TableRowPlusAfter" Width="14" Height="14" Foreground="{DynamicResource M3PrimaryBrush}" />
                                        <TextBlock Text="Add Row" FontSize="11" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Classes="m3-tonal-btn" Height="28" Margin="3,0,0,0"
                                        Command="{Binding TableElement.RemoveRowCommand}" ToolTip.Tip="Delete Table Row">
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="TableRowRemove" Width="14" Height="14" Foreground="{DynamicResource M3ErrorBrush}" />
                                        <TextBlock Text="Del Row" FontSize="11" Foreground="{DynamicResource M3ErrorBrush}" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid ColumnDefinitions="*,*" Margin="0,2">
                                <Button Grid.Column="0" Classes="m3-tonal-btn" Height="28" Margin="0,0,3,0"
                                        Command="{Binding TableElement.AddColumnCommand}" ToolTip.Tip="Add Table Column">
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="TableColumnPlusAfter" Width="14" Height="14" Foreground="{DynamicResource M3PrimaryBrush}" />
                                        <TextBlock Text="Add Col" FontSize="11" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Classes="m3-tonal-btn" Height="28" Margin="3,0,0,0"
                                        Command="{Binding TableElement.RemoveColumnCommand}" ToolTip.Tip="Delete Table Column">
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="TableColumnRemove" Width="14" Height="14" Foreground="{DynamicResource M3ErrorBrush}" />
                                        <TextBlock Text="Del Col" FontSize="11" Foreground="{DynamicResource M3ErrorBrush}" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Data Source & Studio -->
                            <TextBlock Text="Data Source &amp; Connector" Classes="inspector-label" Margin="0,4,0,0" />
                            <Button Classes="m3-filled-btn" Height="30" Command="{Binding OpenDataStudioForTableCommand}" ToolTip.Tip="Open Data Studio to import from Excel, CSV, REST API, or Grid">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="DatabaseArrowDownOutline" Width="14" Height="14" />
                                    <TextBlock Text="Open Data Studio..." FontSize="11" />
                                </StackPanel>
                            </Button>

                            <Grid ColumnDefinitions="*,*">
                                <Button Grid.Column="0" Classes="m3-outlined-btn" Height="28" Margin="0,0,2,0" Command="{Binding QuickPasteDataToTableCommand}" ToolTip.Tip="Paste TSV/CSV from clipboard into table">
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="ContentPaste" Width="13" Height="13" Foreground="{DynamicResource M3PrimaryBrush}" />
                                        <TextBlock Text="Paste Table" FontSize="10.5" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Classes="m3-outlined-btn" Height="28" Margin="2,0,0,0" Command="{Binding ConvertTableToChartCommand}" ToolTip.Tip="Convert this Table into a LiveCharts2 Chart">
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="ChartBoxOutline" Width="13" Height="13" Foreground="{DynamicResource M3PrimaryBrush}" />
                                        <TextBlock Text="To Chart" FontSize="10.5" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 6. CHART CONFIG CARD (Visible when Chart is selected) -->
                    <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource M3ShapeCornerLarge}"
                            Padding="12"
                            BoxShadow="{StaticResource M3ElevationLevel1}"
                            IsVisible="{Binding ChartElement, Converter={StaticResource NullToBooleanConverter}}">
                        <StackPanel Spacing="10">
                            <!-- Card Header with Tonal Avatar -->
                            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,2">
                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="{StaticResource M3ShapeCornerSmall}"
                                        Background="{DynamicResource M3SecondaryContainerBrush}" Margin="0,0,8,0">
                                    <materialIcons:MaterialIcon Kind="ChartBar" Width="16" Height="16"
                                                                Foreground="{DynamicResource M3OnSecondaryContainerBrush}"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="LiveCharts2 Engine" FontWeight="SemiBold" FontSize="12.5"
                                               Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                    <TextBlock Text="15 Chart Types • Palettes &amp; Layout" FontSize="10"
                                               Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </StackPanel>
                            </Grid>

                            <!-- Chart Types Selector -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Select Chart Kind" Classes="inspector-label" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding SetChartTypeCommand}" CommandParameter="BarColumn"><TextBlock Text="Columns" FontSize="10" /></Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding SetChartTypeCommand}" CommandParameter="HorizontalBar"><TextBlock Text="H-Bar" FontSize="10" /></Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding SetChartTypeCommand}" CommandParameter="StackedBar"><TextBlock Text="Stacked" FontSize="10" /></Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding SetChartTypeCommand}" CommandParameter="StackedHorizontalBar"><TextBlock Text="Stacked-H" FontSize="10" /></Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding SetChartTypeCommand}" CommandParameter="Line"><TextBlock Text="Line" FontSize="10" /></Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding SetChartTypeCommand}" CommandParameter="SmoothLine"><TextBlock Text="Spline" FontSize="10" /></Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding SetChartTypeCommand}" CommandParameter="Area"><TextBlock Text="Area" FontSize="10" /></Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding SetChartTypeCommand}" CommandParameter="StepLine"><TextBlock Text="Step" FontSize="10" /></Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding SetChartTypeCommand}" CommandParameter="DonutPie"><TextBlock Text="Donut" FontSize="10" /></Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding SetChartTypeCommand}" CommandParameter="GaugeProgress"><TextBlock Text="Gauge" FontSize="10" /></Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding SetChartTypeCommand}" CommandParameter="ScatterPlot"><TextBlock Text="Scatter" FontSize="10" /></Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding SetChartTypeCommand}" CommandParameter="Radar"><TextBlock Text="Radar" FontSize="10" /></Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding SetChartTypeCommand}" CommandParameter="PolarArea"><TextBlock Text="Polar" FontSize="10" /></Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding SetChartTypeCommand}" CommandParameter="Candlestick"><TextBlock Text="Candle" FontSize="10" /></Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding SetChartTypeCommand}" CommandParameter="Waterfall"><TextBlock Text="Waterfall" FontSize="10" /></Button>
                                </WrapPanel>
                            </StackPanel>

                            <!-- Color Palette Selector -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Color Palette" Classes="inspector-label" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Classes="m3-preset-chip" Margin="0,0,3,3" Command="{Binding SetChartPaletteCommand}" CommandParameter="CorporateBlue"><TextBlock Text="Corporate" FontSize="10" /></Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,3,3" Command="{Binding SetChartPaletteCommand}" CommandParameter="EmeraldGreen"><TextBlock Text="Emerald" FontSize="10" /></Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,3,3" Command="{Binding SetChartPaletteCommand}" CommandParameter="SunsetOrange"><TextBlock Text="Sunset" FontSize="10" /></Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,3,3" Command="{Binding SetChartPaletteCommand}" CommandParameter="CyberNeon"><TextBlock Text="Cyber" FontSize="10" /></Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,3,3" Command="{Binding SetChartPaletteCommand}" CommandParameter="ExecutiveSlate"><TextBlock Text="Slate" FontSize="10" /></Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,3,3" Command="{Binding SetChartPaletteCommand}" CommandParameter="PastelHarmony"><TextBlock Text="Pastel" FontSize="10" /></Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,3,3" Command="{Binding SetChartPaletteCommand}" CommandParameter="VibrantRainbow"><TextBlock Text="Rainbow" FontSize="10" /></Button>
                                </WrapPanel>
                            </StackPanel>

                            <!-- Legend Position Selector -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Legend Placement" Classes="inspector-label" />
                                <Border Classes="m3-segmented-container">
                                    <Grid ColumnDefinitions="*,*,*,*,*">
                                        <Button Grid.Column="0" Classes="m3-segment-btn" Height="24" Command="{Binding SetChartLegendPositionCommand}" CommandParameter="Top"><TextBlock Text="Top" FontSize="9.5" HorizontalAlignment="Center" /></Button>
                                        <Button Grid.Column="1" Classes="m3-segment-btn" Height="24" Command="{Binding SetChartLegendPositionCommand}" CommandParameter="Bottom"><TextBlock Text="Btm" FontSize="9.5" HorizontalAlignment="Center" /></Button>
                                        <Button Grid.Column="2" Classes="m3-segment-btn" Height="24" Command="{Binding SetChartLegendPositionCommand}" CommandParameter="Left"><TextBlock Text="Left" FontSize="9.5" HorizontalAlignment="Center" /></Button>
                                        <Button Grid.Column="3" Classes="m3-segment-btn" Height="24" Command="{Binding SetChartLegendPositionCommand}" CommandParameter="Right"><TextBlock Text="Right" FontSize="9.5" HorizontalAlignment="Center" /></Button>
                                        <Button Grid.Column="4" Classes="m3-segment-btn" Height="24" Command="{Binding SetChartLegendPositionCommand}" CommandParameter="Hidden"><TextBlock Text="Off" FontSize="9.5" HorizontalAlignment="Center" /></Button>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Display Options Toggles -->
                            <Grid ColumnDefinitions="*,*">
                                <CheckBox Grid.Column="0" Content="Data Labels" IsChecked="{Binding ChartElement.ShowDataLabels, Mode=TwoWay}" FontSize="11.5" />
                                <CheckBox Grid.Column="1" Content="Gridlines" IsChecked="{Binding ChartElement.ShowGridlines, Mode=TwoWay}" FontSize="11.5" />
                            </Grid>

                            <!-- Donut Hole Slider (Visible for Donut) -->
                            <StackPanel Spacing="3" IsVisible="{Binding ChartElement.IsDonutPie}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Donut Hole Ratio" Classes="inspector-label" />
                                    <TextBlock Grid.Column="1" Text="{Binding ChartElement.DonutHoleRatio, StringFormat='{}{0:F2}'}" FontSize="10" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </Grid>
                                <Slider Value="{Binding ChartElement.DonutHoleRatio, Mode=TwoWay}" Minimum="0.1" Maximum="0.85" SmallChange="0.05" Height="28" />
                            </StackPanel>

                            <!-- Curve Smoothness Slider (Visible for Spline / Area) -->
                            <StackPanel Spacing="3" IsVisible="{Binding ChartElement.IsSmoothLine}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Curve Tension" Classes="inspector-label" />
                                    <TextBlock Grid.Column="1" Text="{Binding ChartElement.CurveSmoothness, StringFormat='{}{0:F2}'}" FontSize="10" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </Grid>
                                <Slider Value="{Binding ChartElement.CurveSmoothness, Mode=TwoWay}" Minimum="0.0" Maximum="1.0" SmallChange="0.05" Height="28" />
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Chart Title" Classes="inspector-label" />
                                <TextBox Classes="m3-outlined" Text="{Binding ChartElement.Title, Mode=TwoWay}" Height="32" FontSize="12" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*" Margin="0,2">
                                <Button Grid.Column="0" Classes="m3-tonal-btn" Height="28" Margin="0,0,3,0"
                                        Command="{Binding ChartElement.AddDataPointCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="Plus" Width="14" Height="14" Foreground="{DynamicResource M3PrimaryBrush}" />
                                        <TextBlock Text="Add Point" FontSize="11" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Classes="m3-tonal-btn" Height="28" Margin="3,0,0,0"
                                        Command="{Binding ChartElement.RemoveDataPointCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="Minus" Width="14" Height="14" Foreground="{DynamicResource M3ErrorBrush}" />
                                        <TextBlock Text="Del Point" FontSize="11" Foreground="{DynamicResource M3ErrorBrush}" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Data Source & Studio -->
                            <TextBlock Text="Data Source &amp; Connector" Classes="inspector-label" Margin="0,4,0,0" />
                            <Button Classes="m3-filled-btn" Height="30" Command="{Binding OpenDataStudioForChartCommand}" ToolTip.Tip="Open Data Studio to import from Excel, CSV, REST API, or Grid">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="DatabaseArrowDownOutline" Width="14" Height="14" />
                                    <TextBlock Text="Open Data Studio..." FontSize="11" />
                                </StackPanel>
                            </Button>

                            <Grid ColumnDefinitions="*,*">
                                <Button Grid.Column="0" Classes="m3-outlined-btn" Height="28" Margin="0,0,2,0" Command="{Binding QuickPasteDataToChartCommand}" ToolTip.Tip="Paste TSV/CSV from clipboard into chart">
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="ContentPaste" Width="13" Height="13" Foreground="{DynamicResource M3PrimaryBrush}" />
                                        <TextBlock Text="Paste Data" FontSize="10.5" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Classes="m3-outlined-btn" Height="28" Margin="2,0,0,0" Command="{Binding ConvertChartToTableCommand}" ToolTip.Tip="Convert this Chart into an editable Table">
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="Table" Width="13" Height="13" Foreground="{DynamicResource M3PrimaryBrush}" />
                                        <TextBlock Text="To Table" FontSize="10.5" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 7. WATERMARK CARD (Visible when Watermark is selected) -->
                    <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource M3ShapeCornerLarge}"
                            Padding="12"
                            BoxShadow="{StaticResource M3ElevationLevel1}"
                            IsVisible="{Binding WatermarkElement, Converter={StaticResource NullToBooleanConverter}}">
                        <StackPanel Spacing="10">
                            <!-- Card Header with Tonal Avatar -->
                            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,2">
                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="{StaticResource M3ShapeCornerSmall}"
                                        Background="{DynamicResource M3SecondaryContainerBrush}" Margin="0,0,8,0">
                                    <materialIcons:MaterialIcon Kind="Watermark" Width="16" Height="16"
                                                                Foreground="{DynamicResource M3OnSecondaryContainerBrush}"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Watermark Security" FontWeight="SemiBold" FontSize="12.5"
                                               Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                    <TextBlock Text="Angle • Opacity • Font Size" FontSize="10"
                                               Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Watermark Text" Classes="inspector-label" />
                                <TextBox Classes="m3-outlined" Text="{Binding WatermarkElement.Text, Mode=TwoWay}" Height="32" FontSize="12" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,4,0">
                                    <TextBlock Text="Font Size" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding WatermarkElement.FontSize, Mode=TwoWay}"
                                                   Minimum="20" Maximum="120" Increment="1" FormatString="0"
                                                   HorizontalAlignment="Stretch" Height="28" FontSize="12" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3" Margin="4,0,0,0">
                                    <TextBlock Text="Angle (°)" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding WatermarkElement.Angle, Mode=TwoWay}"
                                                   Minimum="-90" Maximum="90" Increment="5" FormatString="0°"
                                                   HorizontalAlignment="Stretch" Height="28" FontSize="12" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Opacity" Classes="inspector-label" />
                                <Slider Value="{Binding WatermarkElement.Opacity, Mode=TwoWay}" Minimum="0.05" Maximum="1.0" Height="28" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Watermark Color" Classes="inspector-label" />
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Button Classes="color-studio-btn" ToolTip.Tip="Custom Watermark Color Studio">
                                        <Button.Flyout>
                                             <Flyout Placement="BottomEdgeAlignedLeft">
                                                 <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                                                         BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                         BorderThickness="1"
                                                         CornerRadius="{StaticResource M3ShapeCornerMedium}"
                                                         Padding="10"
                                                         BoxShadow="{StaticResource M3ElevationLevel3}">
                                                     <ColorView Color="{Binding WatermarkElement.ColorHex, Mode=TwoWay, Converter={StaticResource HexToColorConverter}}"
                                                                IsAlphaEnabled="True" IsHexInputVisible="True" Width="280" />
                                                 </Border>
                                             </Flyout>
                                        </Button.Flyout>
                                        <Grid Width="24" Height="24">
                                            <Border CornerRadius="12" Width="24" Height="24">
                                                <Border.Background>
                                                    <ConicGradientBrush Center="0.5,0.5">
                                                        <GradientStop Color="#FF0000" Offset="0.0" /><GradientStop Color="#FFFF00" Offset="0.17" /><GradientStop Color="#00FF00" Offset="0.33" /><GradientStop Color="#00FFFF" Offset="0.50" /><GradientStop Color="#0000FF" Offset="0.67" /><GradientStop Color="#FF00FF" Offset="0.83" /><GradientStop Color="#FF0000" Offset="1.0" />
                                                    </ConicGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border Margin="3.5" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="{DynamicResource M3SurfaceContainerLowBrush}">
                                                <materialIcons:MaterialIcon Kind="Palette" Width="11" Height="11" Foreground="{DynamicResource M3OnSurfaceBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <ItemsControl ItemsSource="{Binding ColorSwatches}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:ColorSwatchItem">
                                                <Button Width="22" Height="22" Margin="1.5" CornerRadius="{StaticResource M3ShapeCornerFull}"
                                                        BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1"
                                                        Background="{Binding Hex, Converter={StaticResource HexToBrushConverter}}"
                                                        Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).SetWatermarkColorCommand}" CommandParameter="{Binding Hex}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 8. ACROFORMS CARD (Visible when Form Field is selected) -->
                    <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource M3ShapeCornerLarge}"
                            Padding="12"
                            BoxShadow="{StaticResource M3ElevationLevel1}"
                            IsVisible="{Binding FormFieldElement, Converter={StaticResource NullToBooleanConverter}}">
                        <StackPanel Spacing="10">
                            <!-- Card Header with Tonal Avatar -->
                            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,2">
                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="{StaticResource M3ShapeCornerSmall}"
                                        Background="{DynamicResource M3SecondaryContainerBrush}" Margin="0,0,8,0">
                                    <materialIcons:MaterialIcon Kind="FormTextbox" Width="16" Height="16"
                                                                Foreground="{DynamicResource M3OnSecondaryContainerBrush}"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="AcroForm Field Setup" FontWeight="SemiBold" FontSize="12.5"
                                               Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                    <TextBlock Text="Interactive PDF Form Elements" FontSize="10"
                                               Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </StackPanel>
                            </Grid>

                            <!-- Field Type Switcher Chips with Vector Icons -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Field Control Type" Classes="inspector-label" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding SetFormFieldTypeCommand}" CommandParameter="Text">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <materialIcons:MaterialIcon Kind="FormTextbox" Width="13" Height="13" Foreground="{DynamicResource M3PrimaryBrush}" />
                                            <TextBlock Text="Text" FontSize="10" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding SetFormFieldTypeCommand}" CommandParameter="MultilineText">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <materialIcons:MaterialIcon Kind="TextLong" Width="13" Height="13" Foreground="{DynamicResource M3PrimaryBrush}" />
                                            <TextBlock Text="Textarea" FontSize="10" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding SetFormFieldTypeCommand}" CommandParameter="Checkbox">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <materialIcons:MaterialIcon Kind="CheckboxMarkedOutline" Width="13" Height="13" Foreground="{DynamicResource M3PrimaryBrush}" />
                                            <TextBlock Text="Check" FontSize="10" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding SetFormFieldTypeCommand}" CommandParameter="Radio">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <materialIcons:MaterialIcon Kind="RadioboxMarked" Width="13" Height="13" Foreground="{DynamicResource M3PrimaryBrush}" />
                                            <TextBlock Text="Radio" FontSize="10" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding SetFormFieldTypeCommand}" CommandParameter="Dropdown">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <materialIcons:MaterialIcon Kind="MenuDown" Width="13" Height="13" Foreground="{DynamicResource M3PrimaryBrush}" />
                                            <TextBlock Text="Select" FontSize="10" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding SetFormFieldTypeCommand}" CommandParameter="DatePicker">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <materialIcons:MaterialIcon Kind="CalendarOutline" Width="13" Height="13" Foreground="{DynamicResource M3PrimaryBrush}" />
                                            <TextBlock Text="Date" FontSize="10" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding SetFormFieldTypeCommand}" CommandParameter="Number">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <materialIcons:MaterialIcon Kind="Numeric" Width="13" Height="13" Foreground="{DynamicResource M3PrimaryBrush}" />
                                            <TextBlock Text="Number" FontSize="10" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding SetFormFieldTypeCommand}" CommandParameter="SignatureLine">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <materialIcons:MaterialIcon Kind="DrawPen" Width="13" Height="13" Foreground="{DynamicResource M3PrimaryBrush}" />
                                            <TextBlock Text="Signature" FontSize="10" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding SetFormFieldTypeCommand}" CommandParameter="Button">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <materialIcons:MaterialIcon Kind="GestureTapButton" Width="13" Height="13" Foreground="{DynamicResource M3PrimaryBrush}" />
                                            <TextBlock Text="Button" FontSize="10" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Field Internal Name (AcroForm)" Classes="inspector-label" />
                                <TextBox Classes="m3-outlined" Text="{Binding FormFieldElement.FieldName, Mode=TwoWay}" Height="32" FontSize="12" />
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Field Label" Classes="inspector-label" />
                                <TextBox Classes="m3-outlined" Text="{Binding FormFieldElement.Label, Mode=TwoWay}" Height="32" FontSize="12" />
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Current Field Value" Classes="inspector-label" />
                                <TextBox Classes="m3-outlined" Text="{Binding FormFieldElement.Value, Mode=TwoWay}" Height="32" FontSize="12" PlaceholderText="Type form value..." />
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Placeholder / Default Value" Classes="inspector-label" />
                                <TextBox Classes="m3-outlined" Text="{Binding FormFieldElement.Placeholder, Mode=TwoWay}" Height="32" FontSize="12" />
                            </StackPanel>

                            <CheckBox IsChecked="{Binding FormFieldElement.ShowLabel, Mode=TwoWay}">
                                <TextBlock Text="Display Field Label" FontSize="11.5" />
                            </CheckBox>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Validation Rule Preset" Classes="inspector-label" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding SetFormFieldValidationCommand}" CommandParameter="None"><TextBlock Text="None" FontSize="10" /></Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding SetFormFieldValidationCommand}" CommandParameter="Email"><TextBlock Text="Email" FontSize="10" /></Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding SetFormFieldValidationCommand}" CommandParameter="Numeric"><TextBlock Text="123" FontSize="10" /></Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding SetFormFieldValidationCommand}" CommandParameter="Phone"><TextBlock Text="Phone" FontSize="10" /></Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding SetFormFieldValidationCommand}" CommandParameter="Date"><TextBlock Text="Date" FontSize="10" /></Button>
                                </WrapPanel>
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*">
                                <CheckBox Grid.Column="0" IsChecked="{Binding FormFieldElement.IsRequired, Mode=TwoWay}">
                                    <TextBlock Text="Required (*)" FontSize="11.5" />
                                </CheckBox>
                                <CheckBox Grid.Column="1" IsChecked="{Binding FormFieldElement.IsReadOnly, Mode=TwoWay}">
                                    <TextBlock Text="Read Only" FontSize="11.5" />
                                </CheckBox>
                            </Grid>

                            <!-- Calculation Formula (Acrobat Feature) -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Field Calculation / Formula" Classes="inspector-label" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding SetFormFieldCalculationCommand}" CommandParameter="None"><TextBlock Text="None" FontSize="10" /></Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding SetFormFieldCalculationCommand}" CommandParameter="Sum"><TextBlock Text="Sum (+)" FontSize="10" /></Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding SetFormFieldCalculationCommand}" CommandParameter="Average"><TextBlock Text="Avg" FontSize="10" /></Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding SetFormFieldCalculationCommand}" CommandParameter="Product"><TextBlock Text="Product (×)" FontSize="10" /></Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding SetFormFieldCalculationCommand}" CommandParameter="Min"><TextBlock Text="Min" FontSize="10" /></Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding SetFormFieldCalculationCommand}" CommandParameter="Max"><TextBlock Text="Max" FontSize="10" /></Button>
                                </WrapPanel>
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Calculation Source Fields (comma-separated)" Classes="inspector-label" />
                                <TextBox Classes="m3-outlined" Text="{Binding FormFieldElement.CalculationSourceFields, Mode=TwoWay}" Height="32" FontSize="11.5" PlaceholderText="e.g. subtotal, tax_rate" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Border Color" Classes="inspector-label" />
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Button Classes="color-studio-btn" ToolTip.Tip="Custom Field Border Color Studio">
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft">
                                                <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                                                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource M3ShapeCornerMedium}"
                                                        Padding="10"
                                                        BoxShadow="{StaticResource M3ElevationLevel3}">
                                                    <ColorView Color="{Binding FormFieldElement.BorderColorHex, Mode=TwoWay, Converter={StaticResource HexToColorConverter}}"
                                                               IsAlphaEnabled="True" IsHexInputVisible="True" Width="280" />
                                                </Border>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Grid Width="24" Height="24">
                                            <Border CornerRadius="12" Width="24" Height="24">
                                                <Border.Background>
                                                    <ConicGradientBrush Center="0.5,0.5">
                                                        <GradientStop Color="#FF0000" Offset="0.0" /><GradientStop Color="#FFFF00" Offset="0.17" /><GradientStop Color="#00FF00" Offset="0.33" /><GradientStop Color="#00FFFF" Offset="0.50" /><GradientStop Color="#0000FF" Offset="0.67" /><GradientStop Color="#FF00FF" Offset="0.83" /><GradientStop Color="#FF0000" Offset="1.0" />
                                                    </ConicGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border Margin="3.5" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="{DynamicResource M3SurfaceContainerLowBrush}">
                                                <materialIcons:MaterialIcon Kind="Palette" Width="11" Height="11" Foreground="{DynamicResource M3OnSurfaceBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <ItemsControl ItemsSource="{Binding ColorSwatches}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:ColorSwatchItem">
                                                <Button Width="22" Height="22" Margin="1.5" CornerRadius="{StaticResource M3ShapeCornerFull}"
                                                        BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1"
                                                        Background="{Binding Hex, Converter={StaticResource HexToBrushConverter}}"
                                                        Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).SetFormFieldBorderColorCommand}" CommandParameter="{Binding Hex}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 9. QR CODE CARD (Visible when QR Code is selected) -->
                    <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource M3ShapeCornerLarge}"
                            Padding="12"
                            BoxShadow="{StaticResource M3ElevationLevel1}"
                            IsVisible="{Binding QrCodeElement, Converter={StaticResource NullToBooleanConverter}}">
                        <StackPanel Spacing="10">
                            <!-- Card Header with Tonal Avatar -->
                            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,2">
                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="{StaticResource M3ShapeCornerSmall}"
                                        Background="{DynamicResource M3SecondaryContainerBrush}" Margin="0,0,8,0">
                                    <materialIcons:MaterialIcon Kind="Qrcode" Width="16" Height="16"
                                                                Foreground="{DynamicResource M3OnSecondaryContainerBrush}"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="QR Code Studio" FontWeight="SemiBold" FontSize="12.5"
                                               Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                    <TextBlock Text="10 Payload Presets • ECC Levels" FontSize="10"
                                               Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Quick Payload Presets" Classes="inspector-label" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding ApplyQrPresetCommand}" CommandParameter="Url">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <materialIcons:MaterialIcon Kind="LinkVariant" Width="13" Height="13" Foreground="{DynamicResource M3PrimaryBrush}" />
                                            <TextBlock Text="URL" FontSize="10" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding ApplyQrPresetCommand}" CommandParameter="Wifi">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <materialIcons:MaterialIcon Kind="Wifi" Width="13" Height="13" Foreground="{DynamicResource M3PrimaryBrush}" />
                                            <TextBlock Text="Wi-Fi" FontSize="10" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding ApplyQrPresetCommand}" CommandParameter="VCard">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <materialIcons:MaterialIcon Kind="AccountBoxOutline" Width="13" Height="13" Foreground="{DynamicResource M3PrimaryBrush}" />
                                            <TextBlock Text="vCard" FontSize="10" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding ApplyQrPresetCommand}" CommandParameter="Email">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <materialIcons:MaterialIcon Kind="EmailOutline" Width="13" Height="13" Foreground="{DynamicResource M3PrimaryBrush}" />
                                            <TextBlock Text="Email" FontSize="10" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding ApplyQrPresetCommand}" CommandParameter="PhoneCall">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <materialIcons:MaterialIcon Kind="PhoneOutline" Width="13" Height="13" Foreground="{DynamicResource M3PrimaryBrush}" />
                                            <TextBlock Text="Phone" FontSize="10" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding ApplyQrPresetCommand}" CommandParameter="Sms">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <materialIcons:MaterialIcon Kind="MessageTextOutline" Width="13" Height="13" Foreground="{DynamicResource M3PrimaryBrush}" />
                                            <TextBlock Text="SMS" FontSize="10" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding ApplyQrPresetCommand}" CommandParameter="CryptoAddress">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <materialIcons:MaterialIcon Kind="CurrencyBtc" Width="13" Height="13" Foreground="{DynamicResource M3PrimaryBrush}" />
                                            <TextBlock Text="Crypto" FontSize="10" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding ApplyQrPresetCommand}" CommandParameter="GeoLocation">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <materialIcons:MaterialIcon Kind="MapMarkerOutline" Width="13" Height="13" Foreground="{DynamicResource M3PrimaryBrush}" />
                                            <TextBlock Text="GPS" FontSize="10" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding ApplyQrPresetCommand}" CommandParameter="EventCalendar">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <materialIcons:MaterialIcon Kind="CalendarOutline" Width="13" Height="13" Foreground="{DynamicResource M3PrimaryBrush}" />
                                            <TextBlock Text="Event" FontSize="10" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding ApplyQrPresetCommand}" CommandParameter="PlainText">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <materialIcons:MaterialIcon Kind="FileDocumentOutline" Width="13" Height="13" Foreground="{DynamicResource M3PrimaryBrush}" />
                                            <TextBlock Text="Text" FontSize="10" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Target URL / Payload" Classes="inspector-label" />
                                <TextBox Classes="m3-outlined" Text="{Binding QrCodeElement.Content, Mode=TwoWay}"
                                         AcceptsReturn="True" TextWrapping="Wrap" Height="54" FontSize="11" />
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Label Text" Classes="inspector-label" />
                                <TextBox Classes="m3-outlined" Text="{Binding QrCodeElement.Label, Mode=TwoWay}" Height="32" FontSize="12" />
                            </StackPanel>

                            <!-- Error Correction Level (ECC) Segmented Capsule -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Error Correction (ECC)" Classes="inspector-label" />
                                <Border Classes="m3-segmented-container">
                                    <Grid ColumnDefinitions="*,*,*,*">
                                        <Button Grid.Column="0" Classes="m3-segment-btn" Height="24" Command="{Binding SetQrCodeEccLevelCommand}" CommandParameter="L" ToolTip.Tip="Low (7% recovery)">
                                            <TextBlock Text="L (7%)" FontSize="9.5" HorizontalAlignment="Center" />
                                        </Button>
                                        <Button Grid.Column="1" Classes="m3-segment-btn" Height="24" Command="{Binding SetQrCodeEccLevelCommand}" CommandParameter="M" ToolTip.Tip="Medium (15% recovery)">
                                            <TextBlock Text="M (15%)" FontSize="9.5" HorizontalAlignment="Center" />
                                        </Button>
                                        <Button Grid.Column="2" Classes="m3-segment-btn" Height="24" Command="{Binding SetQrCodeEccLevelCommand}" CommandParameter="Q" ToolTip.Tip="Quartile (25% recovery)">
                                            <TextBlock Text="Q (25%)" FontSize="9.5" HorizontalAlignment="Center" />
                                        </Button>
                                        <Button Grid.Column="3" Classes="m3-segment-btn" Height="24" Command="{Binding SetQrCodeEccLevelCommand}" CommandParameter="H" ToolTip.Tip="High (30% recovery)">
                                            <TextBlock Text="H (30%)" FontSize="9.5" HorizontalAlignment="Center" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Foreground (Dark) Color -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="QR Code Color" Classes="inspector-label" />
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Button Classes="color-studio-btn" ToolTip.Tip="Custom QR Color Studio">
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft">
                                                <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                                                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource M3ShapeCornerMedium}"
                                                        Padding="10"
                                                        BoxShadow="{StaticResource M3ElevationLevel3}">
                                                    <ColorView Color="{Binding QrCodeElement.DarkColorHex, Mode=TwoWay, Converter={StaticResource HexToColorConverter}}"
                                                               IsAlphaEnabled="True" IsHexInputVisible="True" Width="280" />
                                                </Border>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Grid Width="24" Height="24">
                                            <Border CornerRadius="12" Width="24" Height="24">
                                                <Border.Background>
                                                    <ConicGradientBrush Center="0.5,0.5">
                                                        <GradientStop Color="#FF0000" Offset="0.0" /><GradientStop Color="#FFFF00" Offset="0.17" /><GradientStop Color="#00FF00" Offset="0.33" /><GradientStop Color="#00FFFF" Offset="0.50" /><GradientStop Color="#0000FF" Offset="0.67" /><GradientStop Color="#FF00FF" Offset="0.83" /><GradientStop Color="#FF0000" Offset="1.0" />
                                                    </ConicGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border Margin="3.5" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="{DynamicResource M3SurfaceContainerLowBrush}">
                                                <materialIcons:MaterialIcon Kind="Palette" Width="11" Height="11" Foreground="{DynamicResource M3OnSurfaceBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <ItemsControl ItemsSource="{Binding ColorSwatches}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:ColorSwatchItem">
                                                <Button Width="22" Height="22" Margin="1.5" CornerRadius="{StaticResource M3ShapeCornerFull}"
                                                        BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1"
                                                        Background="{Binding Hex, Converter={StaticResource HexToBrushConverter}}"
                                                        Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).SetQrCodeDarkColorCommand}" CommandParameter="{Binding Hex}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>

                            <!-- Background (Light) Color -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Background Color" Classes="inspector-label" />
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Button Classes="color-studio-btn" ToolTip.Tip="Custom QR Background Color Studio">
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft">
                                                <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                                                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource M3ShapeCornerMedium}"
                                                        Padding="10"
                                                        BoxShadow="{StaticResource M3ElevationLevel3}">
                                                    <ColorView Color="{Binding QrCodeElement.LightColorHex, Mode=TwoWay, Converter={StaticResource HexToColorConverter}}"
                                                               IsAlphaEnabled="True" IsHexInputVisible="True" Width="280" />
                                                </Border>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Grid Width="24" Height="24">
                                            <Border CornerRadius="12" Width="24" Height="24" Background="{Binding QrCodeElement.LightColorHex, Converter={StaticResource HexToBrushConverter}}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" />
                                            <Border Margin="3.5" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="Transparent">
                                                <materialIcons:MaterialIcon Kind="FormatColorFill" Width="11" Height="11" Foreground="{DynamicResource M3OnSurfaceBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <Button Width="22" Height="22" Margin="1.5" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="#FFFFFF" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" Command="{Binding SetQrCodeLightColorCommand}" CommandParameter="#FFFFFF" ToolTip.Tip="White" />
                                    <Button Width="22" Height="22" Margin="1.5" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="#F8FAFC" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" Command="{Binding SetQrCodeLightColorCommand}" CommandParameter="#F8FAFC" ToolTip.Tip="Slate Light" />
                                    <Button Width="22" Height="22" Margin="1.5" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="#FEF3C7" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" Command="{Binding SetQrCodeLightColorCommand}" CommandParameter="#FEF3C7" ToolTip.Tip="Amber Light" />
                                    <Button Width="22" Height="22" Margin="1.5" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="#EFF6FF" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" Command="{Binding SetQrCodeLightColorCommand}" CommandParameter="#EFF6FF" ToolTip.Tip="Blue Light" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Quiet Zones Toggle -->
                            <CheckBox IsChecked="{Binding QrCodeElement.DrawQuietZones, Mode=TwoWay}">
                                <TextBlock Text="Include Quiet Zones (Margin)" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                            </CheckBox>
                        </StackPanel>
                    </Border>


                    <!-- 10. BARCODE CARD (Visible when Barcode is selected) -->
                    <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource M3ShapeCornerLarge}"
                            Padding="12"
                            BoxShadow="{StaticResource M3ElevationLevel1}"
                            IsVisible="{Binding BarcodeElement, Converter={StaticResource NullToBooleanConverter}}">
                        <StackPanel Spacing="10">
                            <!-- Card Header with Tonal Avatar -->
                            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,2">
                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="{StaticResource M3ShapeCornerSmall}"
                                        Background="{DynamicResource M3SecondaryContainerBrush}" Margin="0,0,8,0">
                                    <materialIcons:MaterialIcon Kind="Barcode" Width="16" Height="16"
                                                                Foreground="{DynamicResource M3OnSecondaryContainerBrush}"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Barcode Standards" FontWeight="SemiBold" FontSize="12.5"
                                               Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                    <TextBlock Text="7 Formats • Code128, EAN, UPC, ITF" FontSize="10"
                                               Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Select Barcode Standard" Classes="inspector-label" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding SetBarcodeFormatCommand}" CommandParameter="Code128"><TextBlock Text="Code128" FontSize="10" /></Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding SetBarcodeFormatCommand}" CommandParameter="Code39"><TextBlock Text="Code39" FontSize="10" /></Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding SetBarcodeFormatCommand}" CommandParameter="Ean13"><TextBlock Text="EAN-13" FontSize="10" /></Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding SetBarcodeFormatCommand}" CommandParameter="UpcA"><TextBlock Text="UPC-A" FontSize="10" /></Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding SetBarcodeFormatCommand}" CommandParameter="Itf14"><TextBlock Text="ITF-14" FontSize="10" /></Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding SetBarcodeFormatCommand}" CommandParameter="Codabar"><TextBlock Text="Codabar" FontSize="10" /></Button>
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Command="{Binding SetBarcodeFormatCommand}" CommandParameter="Pdf417"><TextBlock Text="PDF417" FontSize="10" /></Button>
                                </WrapPanel>
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Code Value" Classes="inspector-label" />
                                <TextBox Classes="m3-outlined" Text="{Binding BarcodeElement.CodeValue, Mode=TwoWay}" Height="32" FontSize="12" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Show Text Underneath" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding BarcodeElement.ShowText, Mode=TwoWay}" OnContent="" OffContent="" Margin="0" />
                            </Grid>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Barcode Color" Classes="inspector-label" />
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Button Classes="color-studio-btn" ToolTip.Tip="Custom Barcode Color Studio">
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft">
                                                <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                                                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource M3ShapeCornerMedium}"
                                                        Padding="10"
                                                        BoxShadow="{StaticResource M3ElevationLevel3}">
                                                    <ColorView Color="{Binding BarcodeElement.BarColorHex, Mode=TwoWay, Converter={StaticResource HexToColorConverter}}"
                                                               IsAlphaEnabled="True" IsHexInputVisible="True" Width="280" />
                                                </Border>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Grid Width="24" Height="24">
                                            <Border CornerRadius="12" Width="24" Height="24">
                                                <Border.Background>
                                                    <ConicGradientBrush Center="0.5,0.5">
                                                        <GradientStop Color="#FF0000" Offset="0.0" /><GradientStop Color="#FFFF00" Offset="0.17" /><GradientStop Color="#00FF00" Offset="0.33" /><GradientStop Color="#00FFFF" Offset="0.50" /><GradientStop Color="#0000FF" Offset="0.67" /><GradientStop Color="#FF00FF" Offset="0.83" /><GradientStop Color="#FF0000" Offset="1.0" />
                                                    </ConicGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border Margin="3.5" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="{DynamicResource M3SurfaceContainerLowBrush}">
                                                <materialIcons:MaterialIcon Kind="Palette" Width="11" Height="11" Foreground="{DynamicResource M3OnSurfaceBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <ItemsControl ItemsSource="{Binding ColorSwatches}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:ColorSwatchItem">
                                                <Button Width="22" Height="22" Margin="1.5" CornerRadius="{StaticResource M3ShapeCornerFull}"
                                                        BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1"
                                                        Background="{Binding Hex, Converter={StaticResource HexToBrushConverter}}"
                                                        Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).SetBarcodeColorCommand}" CommandParameter="{Binding Hex}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 11. REDACTION CARD (Visible when Redaction block is selected) -->
                    <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource M3ShapeCornerLarge}"
                            Padding="12"
                            BoxShadow="{StaticResource M3ElevationLevel1}"
                            IsVisible="{Binding RedactionElement, Converter={StaticResource NullToBooleanConverter}}">
                        <StackPanel Spacing="10">
                            <!-- Card Header with Tonal Avatar -->
                            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,2">
                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="{StaticResource M3ShapeCornerSmall}"
                                        Background="{DynamicResource M3ErrorContainerBrush}" Margin="0,0,8,0">
                                    <materialIcons:MaterialIcon Kind="EyeOffOutline" Width="16" Height="16"
                                                                Foreground="{DynamicResource M3OnErrorContainerBrush}"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Legal Redaction Exemption" FontWeight="SemiBold" FontSize="12.5"
                                               Foreground="{DynamicResource M3OnErrorContainerBrush}" />
                                    <TextBlock Text="FOIA • Privacy &amp; Classified Overlays" FontSize="10"
                                               Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Exemption Code / Rationale" Classes="inspector-label" />
                                <TextBox Classes="m3-outlined" Text="{Binding RedactionElement.ExemptionCode, Mode=TwoWay}" Height="32" FontSize="12" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Show Exemption Text" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding RedactionElement.ShowOverlayText, Mode=TwoWay}" OnContent="" OffContent="" Margin="0" />
                            </Grid>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Redaction Fill Style" Classes="inspector-label" />
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Classes="color-studio-btn" ToolTip.Tip="Custom Redaction Color Studio">
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft">
                                                <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                                                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource M3ShapeCornerMedium}"
                                                        Padding="10"
                                                        BoxShadow="{StaticResource M3ElevationLevel3}">
                                                    <ColorView Color="{Binding RedactionElement.FillColorHex, Mode=TwoWay, Converter={StaticResource HexToColorConverter}}"
                                                               IsAlphaEnabled="True" IsHexInputVisible="True" Width="280" />
                                                </Border>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Grid Width="24" Height="24">
                                            <Border CornerRadius="12" Width="24" Height="24">
                                                <Border.Background>
                                                    <ConicGradientBrush Center="0.5,0.5">
                                                        <GradientStop Color="#FF0000" Offset="0.0" /><GradientStop Color="#FFFF00" Offset="0.17" /><GradientStop Color="#00FF00" Offset="0.33" /><GradientStop Color="#00FFFF" Offset="0.50" /><GradientStop Color="#0000FF" Offset="0.67" /><GradientStop Color="#FF00FF" Offset="0.83" /><GradientStop Color="#FF0000" Offset="1.0" />
                                                    </ConicGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border Margin="3.5" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="{DynamicResource M3SurfaceContainerLowBrush}">
                                                <materialIcons:MaterialIcon Kind="Palette" Width="11" Height="11" Foreground="{DynamicResource M3OnSurfaceBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <Button Width="24" Height="24" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="#0F172A" Command="{Binding SetRedactionFillColorCommand}" CommandParameter="#0F172A" ToolTip.Tip="Blackout" />
                                    <Button Width="24" Height="24" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="#FFFFFF" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" Command="{Binding SetRedactionFillColorCommand}" CommandParameter="#FFFFFF" ToolTip.Tip="Whiteout" />
                                    <Button Width="24" Height="24" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="#475569" Command="{Binding SetRedactionFillColorCommand}" CommandParameter="#475569" ToolTip.Tip="Grayout" />
                                    <Button Width="24" Height="24" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="#DC2626" Command="{Binding SetRedactionFillColorCommand}" CommandParameter="#DC2626" ToolTip.Tip="Red Confidential" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 12. INK & MARKUP CARD (Visible when Ink element is selected) -->
                    <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource M3ShapeCornerLarge}"
                            Padding="12"
                            BoxShadow="{StaticResource M3ElevationLevel1}"
                            IsVisible="{Binding InkElement, Converter={StaticResource NullToBooleanConverter}}">
                        <StackPanel Spacing="10">
                            <!-- Card Header with Tonal Avatar -->
                            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,2">
                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="{StaticResource M3ShapeCornerSmall}"
                                        Background="{DynamicResource M3SecondaryContainerBrush}" Margin="0,0,8,0">
                                    <materialIcons:MaterialIcon Kind="DrawPen" Width="16" Height="16"
                                                                Foreground="{DynamicResource M3OnSecondaryContainerBrush}"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Ink &amp; Markup Drawing" FontWeight="SemiBold" FontSize="12.5"
                                               Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                    <TextBlock Text="Freehand • Highlighter • Bézier Spline" FontSize="10"
                                               Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Stroke Width (pt)" Classes="inspector-label" />
                                <NumericUpDown Value="{Binding InkElement.StrokeThickness, Mode=TwoWay}"
                                               Minimum="1" Maximum="30" Increment="1" FormatString="0.0"
                                               HorizontalAlignment="Stretch" Height="28" FontSize="12" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Highlighter Mode" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding InkElement.IsHighlighter, Mode=TwoWay}" OnContent="" OffContent="" Margin="0" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Smooth Bézier Spline" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding InkElement.IsSmoothSpline, Mode=TwoWay}" OnContent="" OffContent="" Margin="0" />
                            </Grid>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Ink Color" Classes="inspector-label" />
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Button Classes="color-studio-btn" ToolTip.Tip="Custom Ink Color Studio">
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft">
                                                <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                                                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource M3ShapeCornerMedium}"
                                                        Padding="10"
                                                        BoxShadow="{StaticResource M3ElevationLevel3}">
                                                    <ColorView Color="{Binding InkElement.StrokeColorHex, Mode=TwoWay, Converter={StaticResource HexToColorConverter}}"
                                                               IsAlphaEnabled="True" IsHexInputVisible="True" Width="280" />
                                                </Border>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Grid Width="24" Height="24">
                                            <Border CornerRadius="12" Width="24" Height="24">
                                                <Border.Background>
                                                    <ConicGradientBrush Center="0.5,0.5">
                                                        <GradientStop Color="#FF0000" Offset="0.0" /><GradientStop Color="#FFFF00" Offset="0.17" /><GradientStop Color="#00FF00" Offset="0.33" /><GradientStop Color="#00FFFF" Offset="0.50" /><GradientStop Color="#0000FF" Offset="0.67" /><GradientStop Color="#FF00FF" Offset="0.83" /><GradientStop Color="#FF0000" Offset="1.0" />
                                                    </ConicGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border Margin="3.5" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="{DynamicResource M3SurfaceContainerLowBrush}">
                                                <materialIcons:MaterialIcon Kind="Palette" Width="11" Height="11" Foreground="{DynamicResource M3OnSurfaceBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <ItemsControl ItemsSource="{Binding ColorSwatches}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:ColorSwatchItem">
                                                <Button Width="22" Height="22" Margin="1.5" CornerRadius="{StaticResource M3ShapeCornerFull}"
                                                        BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1"
                                                        Background="{Binding Hex, Converter={StaticResource HexToBrushConverter}}"
                                                        Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).SetInkColorCommand}" CommandParameter="{Binding Hex}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 13. STICKY NOTE CARD (Visible when Sticky Note is selected) -->
                    <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource M3ShapeCornerLarge}"
                            Padding="12"
                            BoxShadow="{StaticResource M3ElevationLevel1}"
                            IsVisible="{Binding StickyNoteElement, Converter={StaticResource NullToBooleanConverter}}">
                        <StackPanel Spacing="10">
                            <!-- Card Header with Tonal Avatar -->
                            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,2">
                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="{StaticResource M3ShapeCornerSmall}"
                                        Background="{DynamicResource M3TertiaryContainerBrush}" Margin="0,0,8,0">
                                    <materialIcons:MaterialIcon Kind="NoteTextOutline" Width="16" Height="16"
                                                                Foreground="{DynamicResource M3OnTertiaryContainerBrush}"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Review Comment Note" FontWeight="SemiBold" FontSize="12.5"
                                               Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                    <TextBlock Text="Collaborative Annotations" FontSize="10"
                                               Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Comment Text" Classes="inspector-label" />
                                <TextBox Classes="m3-outlined" Text="{Binding StickyNoteElement.NoteText, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" Height="64" FontSize="12" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,4,0">
                                    <TextBlock Text="Author" Classes="inspector-label" />
                                    <TextBox Classes="m3-outlined" Text="{Binding StickyNoteElement.Author, Mode=TwoWay}" Height="32" FontSize="11.5" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3" Margin="4,0,0,0">
                                    <TextBlock Text="Review Status" Classes="inspector-label" />
                                    <TextBox Classes="m3-outlined" Text="{Binding StickyNoteElement.Status, Mode=TwoWay}" Height="32" FontSize="11.5" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Sticky Color" Classes="inspector-label" />
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Classes="color-studio-btn" ToolTip.Tip="Custom Sticky Note Color Studio">
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft">
                                                <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                                                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource M3ShapeCornerMedium}"
                                                        Padding="10"
                                                        BoxShadow="{StaticResource M3ElevationLevel3}">
                                                    <ColorView Color="{Binding StickyNoteElement.ColorHex, Mode=TwoWay, Converter={StaticResource HexToColorConverter}}"
                                                               IsAlphaEnabled="True" IsHexInputVisible="True" Width="280" />
                                                </Border>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Grid Width="24" Height="24">
                                            <Border CornerRadius="12" Width="24" Height="24">
                                                <Border.Background>
                                                    <ConicGradientBrush Center="0.5,0.5">
                                                        <GradientStop Color="#FF0000" Offset="0.0" /><GradientStop Color="#FFFF00" Offset="0.17" /><GradientStop Color="#00FF00" Offset="0.33" /><GradientStop Color="#00FFFF" Offset="0.50" /><GradientStop Color="#0000FF" Offset="0.67" /><GradientStop Color="#FF00FF" Offset="0.83" /><GradientStop Color="#FF0000" Offset="1.0" />
                                                    </ConicGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border Margin="3.5" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="{DynamicResource M3SurfaceContainerLowBrush}">
                                                <materialIcons:MaterialIcon Kind="Palette" Width="11" Height="11" Foreground="{DynamicResource M3OnSurfaceBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <Button Width="24" Height="24" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="#FEF3C7" Command="{Binding SetStickyNoteColorCommand}" CommandParameter="#FEF3C7" ToolTip.Tip="Yellow Note" />
                                    <Button Width="24" Height="24" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="#DBEAFE" Command="{Binding SetStickyNoteColorCommand}" CommandParameter="#DBEAFE" ToolTip.Tip="Blue Note" />
                                    <Button Width="24" Height="24" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="#DCFCE7" Command="{Binding SetStickyNoteColorCommand}" CommandParameter="#DCFCE7" ToolTip.Tip="Green Note" />
                                    <Button Width="24" Height="24" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="#FCE7F3" Command="{Binding SetStickyNoteColorCommand}" CommandParameter="#FCE7F3" ToolTip.Tip="Pink Note" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 14. MEASUREMENT DIMENSION CARD (Visible when Measurement is selected) -->
                    <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource M3ShapeCornerLarge}"
                            Padding="12"
                            BoxShadow="{StaticResource M3ElevationLevel1}"
                            IsVisible="{Binding MeasurementElement, Converter={StaticResource NullToBooleanConverter}}">
                        <StackPanel Spacing="10">
                            <!-- Card Header with Tonal Avatar -->
                            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,2">
                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="{StaticResource M3ShapeCornerSmall}"
                                        Background="{DynamicResource M3SecondaryContainerBrush}" Margin="0,0,8,0">
                                    <materialIcons:MaterialIcon Kind="RulerSquare" Width="16" Height="16"
                                                                Foreground="{DynamicResource M3OnSecondaryContainerBrush}"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Measurement &amp; Scale" FontWeight="SemiBold" FontSize="12.5"
                                               Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                    <TextBlock Text="Dimensions • Engineering Annotations" FontSize="10"
                                               Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Custom Label (or auto distance)" Classes="inspector-label" />
                                <TextBox Classes="m3-outlined" Text="{Binding MeasurementElement.CustomLabel, Mode=TwoWay}" Height="32" FontSize="12" PlaceholderText="Auto-computed dimension..." />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,4,0">
                                    <TextBlock Text="Dimension Units" Classes="inspector-label" />
                                    <ComboBox ItemsSource="{Binding MeasurementUnits}"
                                              SelectedItem="{Binding MeasurementElement.Unit, Mode=TwoWay}"
                                              Height="32" FontSize="11.5" HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3" Margin="4,0,0,0">
                                    <TextBlock Text="Stroke Width (pt)" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding MeasurementElement.StrokeThickness, Mode=TwoWay}"
                                                   Minimum="0.5" Maximum="10" Increment="0.5" FormatString="0.0"
                                                   HorizontalAlignment="Stretch" Height="28" FontSize="11.5" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Dimension Line Color" Classes="inspector-label" />
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Button Classes="color-studio-btn" ToolTip.Tip="Custom Dimension Color Studio">
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft">
                                                <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                                                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource M3ShapeCornerMedium}"
                                                        Padding="10"
                                                        BoxShadow="{StaticResource M3ElevationLevel3}">
                                                    <ColorView Color="{Binding MeasurementElement.StrokeColorHex, Mode=TwoWay, Converter={StaticResource HexToColorConverter}}"
                                                               IsAlphaEnabled="True" IsHexInputVisible="True" Width="280" />
                                                </Border>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Grid Width="24" Height="24">
                                            <Border CornerRadius="12" Width="24" Height="24">
                                                <Border.Background>
                                                    <ConicGradientBrush Center="0.5,0.5">
                                                        <GradientStop Color="#FF0000" Offset="0.0" /><GradientStop Color="#FFFF00" Offset="0.17" /><GradientStop Color="#00FF00" Offset="0.33" /><GradientStop Color="#00FFFF" Offset="0.50" /><GradientStop Color="#0000FF" Offset="0.67" /><GradientStop Color="#FF00FF" Offset="0.83" /><GradientStop Color="#FF0000" Offset="1.0" />
                                                    </ConicGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border Margin="3.5" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="{DynamicResource M3SurfaceContainerLowBrush}">
                                                <materialIcons:MaterialIcon Kind="Palette" Width="11" Height="11" Foreground="{DynamicResource M3OnSurfaceBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <ItemsControl ItemsSource="{Binding ColorSwatches}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:ColorSwatchItem">
                                                <Button Width="22" Height="22" Margin="1.5" CornerRadius="{StaticResource M3ShapeCornerFull}"
                                                        BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1"
                                                        Background="{Binding Hex, Converter={StaticResource HexToBrushConverter}}"
                                                        Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).SetMeasurementColorCommand}" CommandParameter="{Binding Hex}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>

                            <Border Background="{DynamicResource M3SurfaceContainerLowBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" CornerRadius="{StaticResource M3ShapeCornerMedium}" Padding="10,8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Kind="ArrowExpandHorizontal" Width="14" Height="14" Foreground="{DynamicResource M3PrimaryBrush}" />
                                    <TextBlock Text="Calculated Dimension:" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                    <TextBlock Text="{Binding MeasurementElement.FormattedDistance}" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource M3PrimaryBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 14.5. SVG VECTOR ART & ORNAMENTS STUDIO (Visible when SvgElement is selected) -->
                    <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource M3ShapeCornerLarge}"
                            Padding="12"
                            BoxShadow="{StaticResource M3ElevationLevel1}"
                            IsVisible="{Binding SvgElement, Converter={StaticResource NullToBooleanConverter}}">
                        <StackPanel Spacing="10">
                            <!-- Card Header with Tonal Avatar -->
                            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,2">
                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="{StaticResource M3ShapeCornerSmall}"
                                        Background="{DynamicResource M3SecondaryContainerBrush}" Margin="0,0,8,0">
                                    <materialIcons:MaterialIcon Kind="VectorCurve" Width="16" Height="16"
                                                                Foreground="{DynamicResource M3OnSecondaryContainerBrush}"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="SVG Vector Art Studio" FontWeight="SemiBold" FontSize="12.5"
                                               Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                    <TextBlock Text="11 Cultural Ornaments • Vector Tinting" FontSize="10"
                                               Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </StackPanel>
                            </Grid>

                            <!-- Preset Ornaments Selector -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Ornament / Crest Preset" Classes="inspector-label" />
                                <WrapPanel Orientation="Horizontal" Margin="0,2">
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Content="Ganesha"
                                            Command="{Binding SetSvgPresetCommand}" CommandParameter="GaneshaCrest" />
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Content="Toran"
                                            Command="{Binding SetSvgPresetCommand}" CommandParameter="MarigoldToran" />
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Content="Deepam"
                                            Command="{Binding SetSvgPresetCommand}" CommandParameter="TraditionalDeepam" />
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Content="Hanging Lamps"
                                            Command="{Binding SetSvgPresetCommand}" CommandParameter="HangingDiyas" />
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Content="Floral Divider"
                                            Command="{Binding SetSvgPresetCommand}" CommandParameter="DottedFloralDivider" />
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Content="Mandap Arch"
                                            Command="{Binding SetSvgPresetCommand}" CommandParameter="MandapArch" />
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Content="Plantain Trees"
                                            Command="{Binding SetSvgPresetCommand}" CommandParameter="PlantainTrees" />
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Content="Vedic Kalash"
                                            Command="{Binding SetSvgPresetCommand}" CommandParameter="AuspiciousKalash" />
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Content="Botanical Wreath"
                                            Command="{Binding SetSvgPresetCommand}" CommandParameter="BotanicalWreath" />
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Content="Art Deco Frame"
                                            Command="{Binding SetSvgPresetCommand}" CommandParameter="ArtDecoFrame" />
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Content="Om Crest"
                                            Command="{Binding SetSvgPresetCommand}" CommandParameter="OmCrest" />
                                </WrapPanel>
                            </StackPanel>

                            <!-- Tint Color Studio -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Vector Tint Color (Optional)" Classes="inspector-label" />
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Button Classes="color-studio-btn" ToolTip.Tip="Custom SVG Tint Color Studio">
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft">
                                                <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                                                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource M3ShapeCornerMedium}"
                                                        Padding="10"
                                                        BoxShadow="{StaticResource M3ElevationLevel3}">
                                                    <ColorView Color="{Binding SvgElement.TintColorHex, Mode=TwoWay, Converter={StaticResource HexToColorConverter}}"
                                                               IsAlphaEnabled="True" IsHexInputVisible="True" Width="280" />
                                                </Border>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Grid Width="24" Height="24">
                                            <Border CornerRadius="12" Width="24" Height="24">
                                                <Border.Background>
                                                    <ConicGradientBrush Center="0.5,0.5">
                                                        <GradientStop Color="#FF0000" Offset="0.0" /><GradientStop Color="#FFFF00" Offset="0.17" /><GradientStop Color="#00FF00" Offset="0.33" /><GradientStop Color="#00FFFF" Offset="0.50" /><GradientStop Color="#0000FF" Offset="0.67" /><GradientStop Color="#FF00FF" Offset="0.83" /><GradientStop Color="#FF0000" Offset="1.0" />
                                                    </ConicGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border Margin="3.5" CornerRadius="{StaticResource M3ShapeCornerFull}" Background="{DynamicResource M3SurfaceContainerLowBrush}">
                                                <materialIcons:MaterialIcon Kind="Palette" Width="11" Height="11" Foreground="{DynamicResource M3OnSurfaceBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <ItemsControl ItemsSource="{Binding ColorSwatches}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:ColorSwatchItem">
                                                <Button Width="22" Height="22" Margin="1.5" CornerRadius="{StaticResource M3ShapeCornerFull}"
                                                        BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1"
                                                        Background="{Binding Hex, Converter={StaticResource HexToBrushConverter}}"
                                                        Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).SetSvgTintColorCommand}" CommandParameter="{Binding Hex}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>

                            <!-- Keep Aspect Ratio -->
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Keep Aspect Ratio" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding SvgElement.KeepAspectRatio, Mode=TwoWay}" OnContent="" OffContent="" Margin="0" />
                            </Grid>

                            <!-- Raw SVG Source Editor -->
                            <StackPanel Spacing="3">
                                <TextBlock Text="Raw SVG Source Markup" Classes="inspector-label" />
                                <TextBox Classes="m3-outlined" Text="{Binding SvgElement.SvgSource, Mode=TwoWay}"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         Height="80" FontSize="11" FontFamily="Cascadia Code, Consolas, Courier New, monospace" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 15. MATHEMATICAL EQUATION & FORMULA CARD (Visible when Math Element is selected) -->
                    <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource M3ShapeCornerLarge}"
                            Padding="12"
                            BoxShadow="{StaticResource M3ElevationLevel1}"
                            IsVisible="{Binding MathElement, Converter={StaticResource NullToBooleanConverter}}">
                        <StackPanel Spacing="10">
                            <!-- Card Header -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="{StaticResource M3ShapeCornerFull}"
                                        Background="{DynamicResource M3SecondaryContainerBrush}"
                                        VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="Sigma" Width="16" Height="16"
                                                                Foreground="{DynamicResource M3OnSecondaryContainerBrush}"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Mathematical Equation" FontWeight="SemiBold" FontSize="12.5"
                                               Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                    <TextBlock Text="LaTeX Formatting • MathFX Engine" FontSize="10"
                                               Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </StackPanel>
                                <Button Grid.Column="2" Classes="m3-tonal-btn" Height="26" Padding="8,2"
                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenMathStudioCommand}"
                                        CommandParameter="{Binding MathElement}"
                                        ToolTip.Tip="Open Full Equation Studio">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <materialIcons:MaterialIcon Kind="OpenInNew" Width="12" Height="12" />
                                        <TextBlock Text="Studio" FontSize="10" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Quick Presets -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Standard Formula Presets" Classes="inspector-label" />
                                <WrapPanel Orientation="Horizontal" Margin="0,2">
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Content="∫ Gaussian"
                                            Command="{Binding MathElement.ApplyPresetCommand}" CommandParameter="gaussian_integral" />
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Content="± Quadratic"
                                            Command="{Binding MathElement.ApplyPresetCommand}" CommandParameter="quadratic_formula" />
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Content="Ψ Schrödinger"
                                            Command="{Binding MathElement.ApplyPresetCommand}" CommandParameter="schrodinger_time_dependent" />
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Content="∂ Black-Scholes"
                                            Command="{Binding MathElement.ApplyPresetCommand}" CommandParameter="black_scholes_pde" />
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Content="e^(iπ) Euler"
                                            Command="{Binding MathElement.ApplyPresetCommand}" CommandParameter="eulers_identity" />
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Content="𝒩 Normal PDF"
                                            Command="{Binding MathElement.ApplyPresetCommand}" CommandParameter="normal_distribution" />
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Content="SDE Bates Jump"
                                            Command="{Binding MathElement.ApplyPresetCommand}" CommandParameter="bates_jump_diffusion" />
                                    <Button Classes="m3-preset-chip" Margin="0,0,4,4" Content="Ĥ Cavity QED"
                                            Command="{Binding MathElement.ApplyPresetCommand}" CommandParameter="dicke_hamiltonian" />
                                </WrapPanel>
                            </StackPanel>

                            <!-- LaTeX Formula Editor -->
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="LaTeX Expression" Classes="inspector-label" />
                                    <TextBlock Grid.Column="1" Text="{Binding MathElement.PresetName}" FontSize="9.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" FontWeight="Medium" />
                                </Grid>
                                <TextBox Classes="m3-outlined" Text="{Binding MathElement.Formula, Mode=TwoWay}"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         Height="70" FontSize="11.5"
                                         FontFamily="Cascadia Code, Consolas, Courier New, monospace" />
                            </StackPanel>

                            <!-- Quick Symbol Insert Bar -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Quick Insert Math Symbols" Classes="inspector-label" />
                                <WrapPanel Orientation="Horizontal" Margin="0,2">
                                    <Button Classes="m3-preset-chip" Margin="0,0,3,3" Height="24" Padding="5,1" Content="a/b" Command="{Binding MathElement.InsertSymbolCommand}" CommandParameter="frac" />
                                    <Button Classes="m3-preset-chip" Margin="0,0,3,3" Height="24" Padding="5,1" Content="√x" Command="{Binding MathElement.InsertSymbolCommand}" CommandParameter="sqrt" />
                                    <Button Classes="m3-preset-chip" Margin="0,0,3,3" Height="24" Padding="5,1" Content="∑" Command="{Binding MathElement.InsertSymbolCommand}" CommandParameter="sum" />
                                    <Button Classes="m3-preset-chip" Margin="0,0,3,3" Height="24" Padding="5,1" Content="∫" Command="{Binding MathElement.InsertSymbolCommand}" CommandParameter="int" />
                                    <Button Classes="m3-preset-chip" Margin="0,0,3,3" Height="24" Padding="5,1" Content="∂" Command="{Binding MathElement.InsertSymbolCommand}" CommandParameter="\partial" />
                                    <Button Classes="m3-preset-chip" Margin="0,0,3,3" Height="24" Padding="5,1" Content="∇" Command="{Binding MathElement.InsertSymbolCommand}" CommandParameter="\nabla" />
                                    <Button Classes="m3-preset-chip" Margin="0,0,3,3" Height="24" Padding="5,1" Content="ℏ" Command="{Binding MathElement.InsertSymbolCommand}" CommandParameter="\hbar" />
                                    <Button Classes="m3-preset-chip" Margin="0,0,3,3" Height="24" Padding="5,1" Content="∞" Command="{Binding MathElement.InsertSymbolCommand}" CommandParameter="\infty" />
                                    <Button Classes="m3-preset-chip" Margin="0,0,3,3" Height="24" Padding="5,1" Content="α" Command="{Binding MathElement.InsertSymbolCommand}" CommandParameter="\alpha" />
                                    <Button Classes="m3-preset-chip" Margin="0,0,3,3" Height="24" Padding="5,1" Content="β" Command="{Binding MathElement.InsertSymbolCommand}" CommandParameter="\beta" />
                                    <Button Classes="m3-preset-chip" Margin="0,0,3,3" Height="24" Padding="5,1" Content="π" Command="{Binding MathElement.InsertSymbolCommand}" CommandParameter="\pi" />
                                    <Button Classes="m3-preset-chip" Margin="0,0,3,3" Height="24" Padding="5,1" Content="σ" Command="{Binding MathElement.InsertSymbolCommand}" CommandParameter="\sigma" />
                                    <Button Classes="m3-preset-chip" Margin="0,0,3,3" Height="24" Padding="5,1" Content="ψ" Command="{Binding MathElement.InsertSymbolCommand}" CommandParameter="\psi" />
                                    <Button Classes="m3-preset-chip" Margin="0,0,3,3" Height="24" Padding="5,1" Content="ω" Command="{Binding MathElement.InsertSymbolCommand}" CommandParameter="\omega" />
                                    <Button Classes="m3-preset-chip" Margin="0,0,3,3" Height="24" Padding="5,1" Content="±" Command="{Binding MathElement.InsertSymbolCommand}" CommandParameter="\pm" />
                                    <Button Classes="m3-preset-chip" Margin="0,0,3,3" Height="24" Padding="5,1" Content="×" Command="{Binding MathElement.InsertSymbolCommand}" CommandParameter="\times" />
                                    <Button Classes="m3-preset-chip" Margin="0,0,3,3" Height="24" Padding="5,1" Content="≤" Command="{Binding MathElement.InsertSymbolCommand}" CommandParameter="\le" />
                                    <Button Classes="m3-preset-chip" Margin="0,0,3,3" Height="24" Padding="5,1" Content="≥" Command="{Binding MathElement.InsertSymbolCommand}" CommandParameter="\ge" />
                                    <Button Classes="m3-preset-chip" Margin="0,0,3,3" Height="24" Padding="5,1" Content="≈" Command="{Binding MathElement.InsertSymbolCommand}" CommandParameter="\approx" />
                                    <Button Classes="m3-preset-chip" Margin="0,0,3,3" Height="24" Padding="5,1" Content="→" Command="{Binding MathElement.InsertSymbolCommand}" CommandParameter="\to" />
                                </WrapPanel>
                            </StackPanel>

                            <!-- Font Size & Equation Numbering -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="Base Font Size (pt)" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding MathElement.FontSize, Mode=TwoWay}"
                                                   Minimum="8" Maximum="72" Increment="1" FormatString="0 pt" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="Equation Number" Classes="inspector-label" />
                                    <TextBox Classes="m3-outlined" Text="{Binding MathElement.EquationNumber, Mode=TwoWay}"
                                             Height="28" FontSize="11.5"
                                             IsEnabled="{Binding MathElement.ShowEquationNumber}" />
                                </StackPanel>
                            </Grid>

                            <!-- Equation Number Toggle -->
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Show Equation Number Tag (e.g. (1))" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding MathElement.ShowEquationNumber, Mode=TwoWay}" OnContent="" OffContent="" Margin="0" />
                            </Grid>

                            <!-- Text / Symbol Color -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Formula Glyph Color" Classes="inspector-label" />
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Button Classes="color-studio-btn" ToolTip.Tip="Formula Color Picker">
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft">
                                                <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                                                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource M3ShapeCornerMedium}"
                                                        Padding="10"
                                                        BoxShadow="{StaticResource M3ElevationLevel3}">
                                                    <ColorView Color="{Binding MathElement.TextColorHex, Mode=TwoWay, Converter={StaticResource HexToColorConverter}}"
                                                               IsAlphaEnabled="True" IsHexInputVisible="True" Width="280" />
                                                </Border>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Border CornerRadius="{StaticResource M3ShapeCornerFull}" Width="24" Height="24"
                                                Background="{Binding MathElement.TextColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" />
                                    </Button>
                                    <ItemsControl ItemsSource="{Binding ColorSwatches}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:ColorSwatchItem">
                                                <Button Width="22" Height="22" Margin="1.5" CornerRadius="{StaticResource M3ShapeCornerFull}"
                                                        BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1"
                                                        Background="{Binding Hex, Converter={StaticResource HexToBrushConverter}}"
                                                        Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).SetTextColorCommand}" CommandParameter="{Binding Hex}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>

                            <!-- Background & Border Card Styling -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="Corner Radius" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding MathElement.CornerRadius, Mode=TwoWay}"
                                                   Minimum="0" Maximum="30" Increment="1" FormatString="0 px" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="Border Thickness" Classes="inspector-label" />
                                    <NumericUpDown Value="{Binding MathElement.BorderThickness, Mode=TwoWay}"
                                                   Minimum="0" Maximum="10" Increment="0.5" FormatString="0.0 px" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 16. DIMENSIONS, POSITION & TRANSFORMS CARD (Visible for any selected element) -->
                    <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource M3ShapeCornerLarge}"
                            Padding="12"
                            BoxShadow="{StaticResource M3ElevationLevel1}"
                            IsVisible="{Binding HasSelectedElement}">
                        <StackPanel Spacing="10">
                            <!-- Card Header -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="{StaticResource M3ShapeCornerFull}"
                                        Background="{DynamicResource M3SecondaryContainerBrush}"
                                        VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="ArrowAll" Width="16" Height="16"
                                                                Foreground="{DynamicResource M3OnSecondaryContainerBrush}"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Position &amp; Geometry" FontWeight="SemiBold" FontSize="12.5"
                                               Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                    <TextBlock Text="Coordinates • Transforms • Hierarchy" FontSize="10"
                                               Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </StackPanel>
                                <Border Grid.Column="2" Background="{DynamicResource M3SurfaceContainerHighBrush}"
                                        BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1"
                                        CornerRadius="{StaticResource M3ShapeCornerSmall}" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="pt" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                </Border>
                            </Grid>

                            <!-- X & Y Coords -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Grid Grid.Column="0" ColumnDefinitions="Auto,*">
                                    <Border Classes="input-badge">
                                        <TextBlock Text="X" Classes="input-badge-text" />
                                    </Border>
                                    <NumericUpDown Grid.Column="1" Value="{Binding SelectedElement.X, Mode=TwoWay}"
                                                   Minimum="0" Maximum="2000" Increment="1" FormatString="0"
                                                   HorizontalAlignment="Stretch" CornerRadius="0,12,12,0" />
                                </Grid>

                                <Grid Grid.Column="1" ColumnDefinitions="Auto,*">
                                    <Border Classes="input-badge">
                                        <TextBlock Text="Y" Classes="input-badge-text" />
                                    </Border>
                                    <NumericUpDown Grid.Column="1" Value="{Binding SelectedElement.Y, Mode=TwoWay}"
                                                   Minimum="0" Maximum="3000" Increment="1" FormatString="0"
                                                   HorizontalAlignment="Stretch" CornerRadius="0,12,12,0" />
                                </Grid>
                            </Grid>

                            <!-- Width & Height -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Grid Grid.Column="0" ColumnDefinitions="Auto,*">
                                    <Border Classes="input-badge">
                                        <TextBlock Text="W" Classes="input-badge-text" />
                                    </Border>
                                    <NumericUpDown Grid.Column="1" Value="{Binding SelectedElement.Width, Mode=TwoWay}"
                                                   Minimum="10" Maximum="2000" Increment="1" FormatString="0"
                                                   HorizontalAlignment="Stretch" CornerRadius="0,12,12,0" />
                                </Grid>

                                <Grid Grid.Column="1" ColumnDefinitions="Auto,*">
                                    <Border Classes="input-badge">
                                        <TextBlock Text="H" Classes="input-badge-text" />
                                    </Border>
                                    <NumericUpDown Grid.Column="1" Value="{Binding SelectedElement.Height, Mode=TwoWay}"
                                                   Minimum="5" Maximum="3000" Increment="1" FormatString="0"
                                                   HorizontalAlignment="Stretch" CornerRadius="0,12,12,0" />
                                </Grid>
                            </Grid>

                            <!-- Rotation & Opacity -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Grid Grid.Column="0" ColumnDefinitions="Auto,*">
                                    <Border Classes="input-badge">
                                        <TextBlock Text="∠" Classes="input-badge-text" />
                                    </Border>
                                    <NumericUpDown Grid.Column="1" Value="{Binding SelectedElement.Rotation, Mode=TwoWay}"
                                                   Minimum="0" Maximum="360" Increment="15" FormatString="0°"
                                                   HorizontalAlignment="Stretch" CornerRadius="0,12,12,0" />
                                </Grid>

                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Opacity" Classes="inspector-label" Margin="0" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedElement.Opacity, StringFormat='{}{0:P0}'}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource M3PrimaryBrush}" />
                                    </Grid>
                                    <Slider Value="{Binding SelectedElement.Opacity, Mode=TwoWay}" Minimum="0.0" Maximum="1.0" Height="24" Margin="0" />
                                </StackPanel>
                            </Grid>

                            <!-- Alignment Buttons -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Page Alignment" Classes="inspector-label" />
                                <Border Classes="m3-segmented-container" HorizontalAlignment="Stretch" Padding="2">
                                    <Grid ColumnDefinitions="*,*,*,*,*,*">
                                        <Button Grid.Column="0" Classes="m3-segment-btn" Height="28" Padding="0" Command="{Binding AlignLeftCommand}" ToolTip.Tip="Align Left">
                                            <materialIcons:MaterialIcon Kind="AlignHorizontalLeft" Width="14" Height="14" HorizontalAlignment="Center" />
                                        </Button>
                                        <Button Grid.Column="1" Classes="m3-segment-btn" Height="28" Padding="0" Command="{Binding AlignCenterCommand}" ToolTip.Tip="Align Center">
                                            <materialIcons:MaterialIcon Kind="AlignHorizontalCenter" Width="14" Height="14" HorizontalAlignment="Center" />
                                        </Button>
                                        <Button Grid.Column="2" Classes="m3-segment-btn" Height="28" Padding="0" Command="{Binding AlignRightCommand}" ToolTip.Tip="Align Right">
                                            <materialIcons:MaterialIcon Kind="AlignHorizontalRight" Width="14" Height="14" HorizontalAlignment="Center" />
                                        </Button>
                                        <Button Grid.Column="3" Classes="m3-segment-btn" Height="28" Padding="0" Command="{Binding AlignTopCommand}" ToolTip.Tip="Align Top">
                                            <materialIcons:MaterialIcon Kind="AlignVerticalTop" Width="14" Height="14" HorizontalAlignment="Center" />
                                        </Button>
                                        <Button Grid.Column="4" Classes="m3-segment-btn" Height="28" Padding="0" Command="{Binding AlignMiddleCommand}" ToolTip.Tip="Align Middle">
                                            <materialIcons:MaterialIcon Kind="AlignVerticalCenter" Width="14" Height="14" HorizontalAlignment="Center" />
                                        </Button>
                                        <Button Grid.Column="5" Classes="m3-segment-btn" Height="28" Padding="0" Command="{Binding AlignBottomCommand}" ToolTip.Tip="Align Bottom">
                                            <materialIcons:MaterialIcon Kind="AlignVerticalBottom" Width="14" Height="14" HorizontalAlignment="Center" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Distribution Tools -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Smart Distribution" Classes="inspector-label" />
                                <Grid ColumnDefinitions="*,*">
                                    <Button Grid.Column="0" Classes="m3-tonal-btn" Height="30" Margin="0,0,3,0" Command="{Binding DistributeHorizontallyCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="DistributeHorizontalCenter" Width="14" Height="14" />
                                            <TextBlock Text="Distribute H" FontSize="10" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Classes="m3-tonal-btn" Height="30" Margin="3,0,0,0" Command="{Binding DistributeVerticallyCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="DistributeVerticalCenter" Width="14" Height="14" />
                                            <TextBlock Text="Distribute V" FontSize="10" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Actions Row (Front, Up, Down, Back, Duplicate, Delete) -->
                            <StackPanel Spacing="4" Margin="0,4,0,0">
                                <TextBlock Text="Layer Order &amp; Quick Actions" Classes="inspector-label" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <!-- 1. Layer Order 4-Button Segmented Capsule -->
                                    <Border Grid.Column="0" Classes="m3-segmented-container" HorizontalAlignment="Stretch" Padding="2">
                                        <Grid ColumnDefinitions="*,*,*,*">
                                            <Button Grid.Column="0" Classes="m3-segment-btn" Height="28" Padding="0" HorizontalAlignment="Stretch"
                                                    Command="{Binding BringToFrontCommand}" ToolTip.Tip="Bring to Front (Ctrl+])">
                                                <materialIcons:MaterialIcon Kind="ArrangeBringToFront" Width="14" Height="14" HorizontalAlignment="Center" />
                                            </Button>
                                            <Button Grid.Column="1" Classes="m3-segment-btn" Height="28" Padding="0" HorizontalAlignment="Stretch"
                                                    Command="{Binding BringForwardCommand}" ToolTip.Tip="Bring Forward (1 Step)">
                                                <materialIcons:MaterialIcon Kind="ArrowUpBold" Width="14" Height="14" HorizontalAlignment="Center" />
                                            </Button>
                                            <Button Grid.Column="2" Classes="m3-segment-btn" Height="28" Padding="0" HorizontalAlignment="Stretch"
                                                    Command="{Binding SendBackwardCommand}" ToolTip.Tip="Send Backward (1 Step)">
                                                <materialIcons:MaterialIcon Kind="ArrowDownBold" Width="14" Height="14" HorizontalAlignment="Center" />
                                            </Button>
                                            <Button Grid.Column="3" Classes="m3-segment-btn" Height="28" Padding="0" HorizontalAlignment="Stretch"
                                                    Command="{Binding SendToBackCommand}" ToolTip.Tip="Send to Back (Ctrl+[)">
                                                <materialIcons:MaterialIcon Kind="ArrangeSendToBack" Width="14" Height="14" HorizontalAlignment="Center" />
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- 2. Quick Actions: Duplicate & Delete -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button Classes="m3-tonal-btn" Width="32" Height="32" Padding="0"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Command="{Binding DuplicateSelectedElementCommand}" ToolTip.Tip="Duplicate (Ctrl+D)">
                                            <materialIcons:MaterialIcon Kind="ContentCopy" Width="14" Height="14" HorizontalAlignment="Center" />
                                        </Button>
                                        <Button Classes="danger-btn" Width="32" Height="32" Padding="0"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Command="{Binding DeleteSelectedElementCommand}" ToolTip.Tip="Delete (Del)">
                                            <materialIcons:MaterialIcon Kind="DeleteOutline" Width="14" Height="14" Foreground="{DynamicResource M3ErrorBrush}" HorizontalAlignment="Center" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Dynamic Plugin-Contributed Inspector Sections -->
                    <ItemsControl ItemsSource="{Binding DynamicSections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DynamicInspectorSectionViewModel">
                                <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource M3ShapeCornerLarge}"
                                        Margin="0,4"
                                        Padding="12"
                                        BoxShadow="{StaticResource M3ElevationLevel1}">
                                    <StackPanel Spacing="8">
                                        <!-- Header -->
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Border Width="28" Height="28" CornerRadius="{StaticResource M3ShapeCornerFull}"
                                                        Background="{DynamicResource M3SecondaryContainerBrush}" VerticalAlignment="Center">
                                                    <materialIcons:MaterialIcon Kind="{Binding IconKind}" Width="15" Height="15"
                                                                                Foreground="{DynamicResource M3OnSecondaryContainerBrush}"
                                                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5"
                                                           Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Content -->
                                        <ContentControl Content="{Binding Content}">
                                            <ContentControl.DataTemplates>
                                                <DataTemplate DataType="x:String">
                                                    <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                                                </DataTemplate>
                                            </ContentControl.DataTemplates>
                                        </ContentControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Border>

    <!-- B. COLLAPSED MINI DOCK RAIL (Width 40) -->
    <Border Background="{DynamicResource M3SurfaceContainerLowBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1,0,0,0" Width="40"
            IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsInspectorCollapsed}">
        <Grid RowDefinitions="Auto,*,Auto" Margin="0,4">
            <!-- Top: Expand Chevron Button -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="4">
                <Button Classes="m3-icon-btn" Width="32" Height="32"
                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleInspectorCollapseCommand}"
                        ToolTip.Tip="Expand Properties Inspector (⌘⇧P / Ctrl+Shift+P)">
                    <materialIcons:MaterialIcon Kind="ChevronLeft" Width="18" Height="18" />
                </Button>
                <Rectangle Width="24" Height="1" Fill="{DynamicResource M3OutlineVariantBrush}" Margin="0,2" />
            </StackPanel>

            <!-- Middle: Inspector Icon & Category Indicator -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Spacing="8" Margin="0,6">
                <Button Classes="m3-icon-btn" Width="32" Height="32"
                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleInspectorCollapseCommand}"
                        ToolTip.Tip="Open Properties &amp; Format Inspector (⌘⇧P)">
                    <materialIcons:MaterialIcon Kind="TuneVariant" Width="18" Height="18" />
                </Button>
                <Border Background="{DynamicResource M3SecondaryContainerBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource M3ShapeCornerSmall}" Padding="3,4" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding ActiveCategoryName}"
                               FontSize="9.5"
                               FontWeight="Bold"
                               Foreground="{DynamicResource M3OnSecondaryContainerBrush}"
                               TextAlignment="Center" />
                </Border>
            </StackPanel>

            <!-- Bottom: Duplicate Action -->
            <StackPanel Grid.Row="2" HorizontalAlignment="Center" Spacing="4">
                <Button Classes="m3-icon-btn" Width="32" Height="32"
                        Command="{Binding DuplicateSelectedElementCommand}"
                        IsEnabled="{Binding HasSelectedElement}"
                        ToolTip.Tip="Duplicate Selected Element (⌘D)">
                    <materialIcons:MaterialIcon Kind="ContentCopy" Width="16" Height="16" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Panel>
</UserControl>
