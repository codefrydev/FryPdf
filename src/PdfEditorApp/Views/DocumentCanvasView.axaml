<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfEditorApp.ViewModels"
             xmlns:views="using:PdfEditorApp.Views"
             xmlns:controls="using:PdfEditorApp.Views.Controls"
             xmlns:elvm="using:PdfEditorApp.ViewModels.ElementViewModels"
             xmlns:converters="using:PdfEditorApp.Converters"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PdfEditorApp.Views.DocumentCanvasView"
             x:DataType="vm:MainViewModel"
             Focusable="True">

    <UserControl.Resources>
        <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
        <converters:TextAlignmentConverter x:Key="TextAlignmentConverter" />
        <converters:EqualityToBooleanConverter x:Key="EqualityConverter" />
        <converters:NullToBooleanConverter x:Key="NullToBooleanConverter" />
        <converters:DoubleToThicknessConverter x:Key="DoubleToThickness" />
        <converters:DoubleToCornerRadiusConverter x:Key="DoubleToCornerRadius" />

        <!-- Rich Element Right-Click Context Menu -->
        <ContextMenu x:Key="ElementContextMenu" x:DataType="elvm:ElementViewModelBase">
            <MenuItem Header="Edit In-Place" InputGesture="F2" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Inspector.StartEditModeCommand}">
                <MenuItem.Icon><materialIcons:MaterialIcon Kind="PencilOutline" Width="16" Height="16" Foreground="#0F6CBD" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Ask AI to Modify..." InputGesture="Ctrl+I" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).AskAiToModifyCommand}" CommandParameter="{Binding}">
                <MenuItem.Icon><materialIcons:MaterialIcon Kind="AutoFixHigh" Width="16" Height="16" Foreground="#7C3AED" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Cut" InputGesture="Ctrl+X" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).CutCommand}">
                <MenuItem.Icon><materialIcons:MaterialIcon Kind="ContentCut" Width="16" Height="16" Foreground="{DynamicResource WinMutedBrush}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Copy" InputGesture="Ctrl+C" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).CopyCommand}">
                <MenuItem.Icon><materialIcons:MaterialIcon Kind="ContentCopy" Width="16" Height="16" Foreground="{DynamicResource WinMutedBrush}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Paste" InputGesture="Ctrl+V" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).PasteCommand}">
                <MenuItem.Icon><materialIcons:MaterialIcon Kind="ContentPaste" Width="16" Height="16" Foreground="#0F6CBD" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Duplicate" InputGesture="Ctrl+D" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).DuplicateCommand}">
                <MenuItem.Icon><materialIcons:MaterialIcon Kind="ContentDuplicate" Width="16" Height="16" Foreground="{DynamicResource WinMutedBrush}" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Bring to Front" InputGesture="Ctrl+OemCloseBrackets" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Inspector.BringToFrontCommand}">
                <MenuItem.Icon><materialIcons:MaterialIcon Kind="ArrangeBringToFront" Width="16" Height="16" Foreground="{DynamicResource WinMutedBrush}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Bring Forward" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Inspector.BringForwardCommand}">
                <MenuItem.Icon><materialIcons:MaterialIcon Kind="ArrowUpBold" Width="16" Height="16" Foreground="{DynamicResource WinMutedBrush}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Send Backward" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Inspector.SendBackwardCommand}">
                <MenuItem.Icon><materialIcons:MaterialIcon Kind="ArrowDownBold" Width="16" Height="16" Foreground="{DynamicResource WinMutedBrush}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Send to Back" InputGesture="Ctrl+OemOpenBrackets" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Inspector.SendToBackCommand}">
                <MenuItem.Icon><materialIcons:MaterialIcon Kind="ArrangeSendToBack" Width="16" Height="16" Foreground="{DynamicResource WinMutedBrush}" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Lock / Unlock" InputGesture="Ctrl+L" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Inspector.ToggleLockCommand}">
                <MenuItem.Icon><materialIcons:MaterialIcon Kind="LockOutline" Width="16" Height="16" Foreground="{DynamicResource WinMutedBrush}" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Delete" InputGesture="Delete" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Inspector.DeleteSelectedElementCommand}">
                <MenuItem.Icon><materialIcons:MaterialIcon Kind="DeleteOutline" Width="16" Height="16" Foreground="#DC2626" /></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>

    <!-- Outer Grid: Rulers + Canvas Viewport -->
    <Grid RowDefinitions="Auto,*" ColumnDefinitions="Auto,*">

        <!-- Ruler Origin Corner -->
        <Border Grid.Row="0" Grid.Column="0" Width="20" Height="20" Background="{DynamicResource WinInputBgBrush}" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="0,0,1,1" IsVisible="{Binding ShowRulers}">
            <materialIcons:MaterialIcon Kind="RulerSquare" Width="11" Height="11" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <!-- Top Horizontal Ruler -->
        <views:CanvasRulerControl Grid.Row="0" Grid.Column="1" Height="20"
                                  Orientation="Horizontal"
                                  ZoomLevel="{Binding ZoomLevel}"
                                  Unit="{Binding RulerUnit}"
                                  CursorPosition="{Binding CursorCanvasX}"
                                  PageOffset="36"
                                  PageDimension="{Binding CurrentPage.Width, FallbackValue=800}"
                                  IsVisible="{Binding ShowRulers}" />

        <!-- Left Vertical Ruler -->
        <views:CanvasRulerControl Grid.Row="1" Grid.Column="0" Width="20"
                                  Orientation="Vertical"
                                  ZoomLevel="{Binding ZoomLevel}"
                                  Unit="{Binding RulerUnit}"
                                  CursorPosition="{Binding CursorCanvasY}"
                                  PageOffset="36"
                                  PageDimension="{Binding CurrentPage.Height, FallbackValue=1131}"
                                  IsVisible="{Binding ShowRulers}" />

        <!-- Canvas Viewport with Overlays -->
        <Grid Grid.Row="1" Grid.Column="1">
            <!-- Canvas Scrollable Workspace -->
            <ScrollViewer x:Name="CanvasScrollViewer"
                          Background="{DynamicResource WinBgBrush}"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          PointerPressed="OnCanvasBackgroundPointerPressed"
                          PointerMoved="OnCanvasPointerMoved">
                <ScrollViewer.GestureRecognizers>
                    <PinchGestureRecognizer />
                </ScrollViewer.GestureRecognizers>

                <!-- Canvas Background Context Menu -->
                <ScrollViewer.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Ask AI: Insert / Edit Here (⌘I)" Command="{Binding AskAiAtPointCommand}">
                            <MenuItem.Icon><materialIcons:MaterialIcon Kind="AutoFixHigh" Width="16" Height="16" Foreground="#7C3AED" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Target Entire Page for AI" Command="{Binding SelectEntirePageForAiCommand}">
                            <MenuItem.Icon><materialIcons:MaterialIcon Kind="FileDocumentOutline" Width="16" Height="16" Foreground="#0F6CBD" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Paste" InputGesture="Ctrl+V" Command="{Binding PasteCommand}">
                            <MenuItem.Icon><materialIcons:MaterialIcon Kind="ContentPaste" Width="16" Height="16" Foreground="#0F6CBD" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Insert Text" InputGesture="T" Command="{Binding AddTextElementCommand}">
                            <MenuItem.Icon><materialIcons:MaterialIcon Kind="FormatColorText" Width="16" Height="16" Foreground="#0F6CBD" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Insert Section Heading" InputGesture="H" Command="{Binding AddHeadingElementCommand}">
                            <MenuItem.Icon><materialIcons:MaterialIcon Kind="FormatHeader1" Width="16" Height="16" Foreground="{DynamicResource WinMutedBrush}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Insert Rectangle Shape" InputGesture="R" Command="{Binding AddShapeElementCommand}" CommandParameter="Rectangle">
                            <MenuItem.Icon><materialIcons:MaterialIcon Kind="SquareOutline" Width="16" Height="16" Foreground="{DynamicResource WinMutedBrush}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Insert Sticky Note" InputGesture="N" Command="{Binding AddStickyNoteElementCommand}">
                            <MenuItem.Icon><materialIcons:MaterialIcon Kind="NoteTextOutline" Width="16" Height="16" Foreground="#D97706" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Insert Dimension Measurement" Command="{Binding AddMeasurementElementCommand}">
                            <MenuItem.Icon><materialIcons:MaterialIcon Kind="RulerSquare" Width="16" Height="16" Foreground="#DC2626" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Insert Image" Command="{Binding AddImageElementCommand}">
                            <MenuItem.Icon><materialIcons:MaterialIcon Kind="ImageOutline" Width="16" Height="16" Foreground="{DynamicResource WinMutedBrush}" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Fit to Page" InputGesture="Ctrl+D9" Command="{Binding FitToPageCommand}">
                            <MenuItem.Icon><materialIcons:MaterialIcon Kind="FitToPageOutline" Width="16" Height="16" Foreground="{DynamicResource WinMutedBrush}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Zoom In" InputGesture="Ctrl+OemPlus" Command="{Binding ZoomInCommand}">
                            <MenuItem.Icon><materialIcons:MaterialIcon Kind="MagnifyPlusOutline" Width="16" Height="16" Foreground="{DynamicResource WinMutedBrush}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Zoom Out" InputGesture="Ctrl+OemMinus" Command="{Binding ZoomOutCommand}">
                            <MenuItem.Icon><materialIcons:MaterialIcon Kind="MagnifyMinusOutline" Width="16" Height="16" Foreground="{DynamicResource WinMutedBrush}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Reset Zoom (100%)" InputGesture="Ctrl+D0" Command="{Binding ResetZoomCommand}">
                            <MenuItem.Icon><materialIcons:MaterialIcon Kind="Magnify" Width="16" Height="16" Foreground="{DynamicResource WinMutedBrush}" /></MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </ScrollViewer.ContextMenu>

        <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Margin="36">
            <LayoutTransformControl>
                <LayoutTransformControl.LayoutTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="{Binding ZoomLevel}" ScaleY="{Binding ZoomLevel}" />
                        <RotateTransform Angle="{Binding CurrentPage.RotationAngle, FallbackValue=0}" />
                    </TransformGroup>
                </LayoutTransformControl.LayoutTransform>

                <!-- PDF Paper Sheet Container (A4 / Letter) -->
                <Border Width="{Binding CurrentPage.Width, FallbackValue=800}"
                        Height="{Binding CurrentPage.Height, FallbackValue=1131}"
                        Background="{Binding CurrentPage.BackgroundColorHex, FallbackValue=White, Converter={StaticResource HexToBrushConverter}}"
                        CornerRadius="2"
                        BoxShadow="0 6 24 #14000000, 0 1 4 #08000000, 0 0 1 #20000000"
                        ClipToBounds="True">

                    <!-- Document Sheet Layout -->
                    <Grid Width="{Binding CurrentPage.Width, FallbackValue=800}"
                          Height="{Binding CurrentPage.Height, FallbackValue=1131}">

                        <!-- Elements Canvas ItemsControl -->
                        <ItemsControl x:Name="PageElementsCanvas"
                                      ItemsSource="{Binding CurrentPage.Elements}"
                                      Width="{Binding CurrentPage.Width, FallbackValue=800}"
                                      Height="{Binding CurrentPage.Height, FallbackValue=1131}">

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas Width="{Binding CurrentPage.Width, FallbackValue=800}"
                                            Height="{Binding CurrentPage.Height, FallbackValue=1131}"
                                            Background="Transparent" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemContainerTheme>
                                <ControlTheme TargetType="ContentPresenter" x:DataType="elvm:ElementViewModelBase">
                                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                    <Setter Property="Canvas.ZIndex" Value="{Binding ZIndex}" />
                                    <Setter Property="Opacity" Value="{Binding Opacity}" />
                                    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
                                    <Setter Property="RenderTransform" Value="{Binding Rotation, Converter={StaticResource RotationToTransformConverter}}" />
                                    <Setter Property="ContextMenu" Value="{StaticResource ElementContextMenu}" />
                                </ControlTheme>
                            </ItemsControl.ItemContainerTheme>

                            <ItemsControl.DataTemplates>

                                <!-- 1. TEXT ELEMENT TEMPLATE -->
                                <DataTemplate DataType="elvm:TextElementViewModel">
                                    <Grid Width="{Binding Width}" Height="{Binding Height}">
                                        <!-- Visual Advanced Text Canvas Element -->
                                        <controls:AdvancedTextControl
                                            Text="{Binding Text}"
                                            Spans="{Binding Spans}"
                                            FontFamilyName="{Binding FontFamily}"
                                            FontSize="{Binding FontSize}"
                                            IsBold="{Binding IsBold}"
                                            IsItalic="{Binding IsItalic}"
                                            IsUnderline="{Binding IsUnderline}"
                                            IsDoubleUnderline="{Binding IsDoubleUnderline}"
                                            IsStrikethrough="{Binding IsStrikethrough}"
                                            TextBrush="{Binding TextBrush}"
                                            TextOpacity="{Binding TextOpacity}"
                                            Alignment="{Binding Alignment}"
                                            TextVerticalAlignment="{Binding VerticalAlignment}"
                                            LineHeight="{Binding LineHeight}"
                                            CharacterSpacing="{Binding CharacterSpacing}"
                                            WordSpacing="{Binding WordSpacing}"
                                            ParagraphSpacing="{Binding ParagraphSpacing}"
                                            TextWrap="{Binding TextWrap}"
                                            HasStroke="{Binding HasStroke}"
                                            StrokeBrush="{Binding StrokeBrush}"
                                            StrokeWidth="{Binding StrokeWidth}"
                                            HasShadow="{Binding HasShadow}"
                                            ShadowBrush="{Binding ShadowBrush}"
                                            ShadowOffsetX="{Binding ShadowOffsetX}"
                                            ShadowOffsetY="{Binding ShadowOffsetY}"
                                            ShadowBlurRadius="{Binding ShadowBlurRadius}"
                                            ShadowOpacity="{Binding ShadowOpacity}"
                                            BackgroundBrush="{Binding BackgroundBrush}"
                                            BorderBrush="{Binding BorderBrush}"
                                            BorderThickness="{Binding BorderThickness}"
                                            CornerRadius="{Binding CornerRadius}"
                                            Padding="{Binding Padding}"
                                            ShapeMode="{Binding ShapeMode}"
                                            CurveRadius="{Binding CurveRadius}"
                                            CurveArcAngle="{Binding CurveArcAngle}"
                                            CurveStartAngle="{Binding CurveStartAngle}"
                                            CurveClockwise="{Binding CurveClockwise}"
                                            CurveInvert="{Binding CurveInvert}"
                                            CircularPlacement="{Binding CircularPlacement}"
                                            BaselineShift="{Binding BaselineShift}"
                                            CharacterRotation="{Binding CharacterRotation}"
                                            ScaleX="{Binding ScaleX}"
                                            ScaleY="{Binding ScaleY}"
                                            FlipX="{Binding FlipX}"
                                            FlipY="{Binding FlipY}"
                                            BezierPreset="{Binding BezierPreset}"
                                            BezierP0X="{Binding BezierP0X}"
                                            BezierP0Y="{Binding BezierP0Y}"
                                            BezierP1X="{Binding BezierP1X}"
                                            BezierP1Y="{Binding BezierP1Y}"
                                            BezierP2X="{Binding BezierP2X}"
                                            BezierP2Y="{Binding BezierP2Y}"
                                            BezierP3X="{Binding BezierP3X}"
                                            BezierP3Y="{Binding BezierP3Y}"
                                            IsVisible="{Binding !IsInEditMode}"
                                            PointerPressed="OnElementPointerPressed"
                                            DoubleTapped="OnTextElementDoubleTapped" />

                                        <!-- In-place Editable TextBox -->
                                        <TextBox Text="{Binding Text, Mode=TwoWay}"
                                                 FontFamily="{Binding AvaloniaFontFamily}"
                                                 FontSize="{Binding FontSize}"
                                                 FontWeight="{Binding IsBold, Converter={x:Static converters:BooleanToFontWeightConverter.Instance}}"
                                                 FontStyle="{Binding IsItalic, Converter={x:Static converters:BooleanToFontStyleConverter.Instance}}"
                                                 Foreground="{Binding TextColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                 CaretBrush="{DynamicResource WinAccentBrush}"
                                                 FocusAdorner="{x:Null}"
                                                 MinHeight="0"
                                                 MinWidth="0"
                                                 HorizontalAlignment="Stretch"
                                                 VerticalAlignment="Stretch"
                                                 VerticalContentAlignment="Top"
                                                 Background="Transparent"
                                                 BorderThickness="1"
                                                 BorderBrush="{DynamicResource WinAccentBrush}"
                                                 CornerRadius="2"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 TextAlignment="{Binding Alignment, Converter={StaticResource TextAlignmentConverter}}"
                                                 Padding="{Binding Padding, Converter={StaticResource DoubleToThickness}}"
                                                 IsVisible="{Binding IsInEditMode}"
                                                 AttachedToVisualTree="OnInPlaceTextBoxAttached"
                                                 LostFocus="OnTextBoxLostFocus" />

                                        <!-- Selection Adorner & Resize Handles -->
                                        <Grid IsVisible="{Binding IsSelected}" IsHitTestVisible="{Binding !IsInEditMode}">
                                            <!-- Blue Bounding Box -->
                                            <Border BorderBrush="{DynamicResource WinAccentBrush}" BorderThickness="1.5" CornerRadius="2" IsHitTestVisible="False" />

                                            <!-- 8 Resize Handles -->
                                            <Panel IsVisible="{Binding !IsInEditMode}">
                                                <!-- Top Left -->
                                                <Border Tag="topleft" Width="8" Height="8" Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinAccentBrush}" BorderThickness="1.5"
                                                        CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-4,-4,0,0" Cursor="TopLeftCorner"
                                                        PointerPressed="OnHandlePointerPressed" />
                                                <!-- Top Middle -->
                                                <Border Tag="top" Width="8" Height="8" Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinAccentBrush}" BorderThickness="1.5"
                                                        CornerRadius="1.5" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-4,0,0" Cursor="SizeNorthSouth"
                                                        PointerPressed="OnHandlePointerPressed" />
                                                <!-- Top Right -->
                                                <Border Tag="topright" Width="8" Height="8" Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinAccentBrush}" BorderThickness="1.5"
                                                        CornerRadius="1.5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0" Cursor="TopRightCorner"
                                                        PointerPressed="OnHandlePointerPressed" />
                                                <!-- Left Middle -->
                                                <Border Tag="left" Width="8" Height="8" Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinAccentBrush}" BorderThickness="1.5"
                                                        CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-4,0,0,0" Cursor="SizeWestEast"
                                                        PointerPressed="OnHandlePointerPressed" />
                                                <!-- Right Middle -->
                                                <Border Tag="right" Width="8" Height="8" Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinAccentBrush}" BorderThickness="1.5"
                                                        CornerRadius="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-4,0" Cursor="SizeWestEast"
                                                        PointerPressed="OnHandlePointerPressed" />
                                                <!-- Bottom Left -->
                                                <Border Tag="bottomleft" Width="8" Height="8" Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinAccentBrush}" BorderThickness="1.5"
                                                        CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-4,0,0,-4" Cursor="BottomLeftCorner"
                                                        PointerPressed="OnHandlePointerPressed" />
                                                <!-- Bottom Middle -->
                                                <Border Tag="bottom" Width="8" Height="8" Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinAccentBrush}" BorderThickness="1.5"
                                                        CornerRadius="1.5" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-4" Cursor="SizeNorthSouth"
                                                        PointerPressed="OnHandlePointerPressed" />
                                                <!-- Bottom Right -->
                                                <Border Tag="bottomright" Width="8" Height="8" Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinAccentBrush}" BorderThickness="1.5"
                                                        CornerRadius="1.5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-4" Cursor="BottomRightCorner"
                                                        PointerPressed="OnHandlePointerPressed" />
                                            </Panel>

                                            <!-- Floating Quick Ask AI Pill -->
                                            <controls:AskAiButton IsVisible="{Binding !IsInEditMode}" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>

                                <!-- 2. SHAPE ELEMENT TEMPLATE -->
                                <DataTemplate DataType="elvm:ShapeElementViewModel">
                                    <Grid Width="{Binding Width}" Height="{Binding Height}">
                                        <Panel PointerPressed="OnElementPointerPressed" DoubleTapped="OnShapeElementDoubleTapped">
                                            <!-- Vector Geometry Shape -->
                                            <Path Data="{Binding PathData}"
                                                  Fill="{Binding FillColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                  Stroke="{Binding StrokeColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                  StrokeThickness="{Binding StrokeThickness}"
                                                  StrokeDashArray="{Binding DashArrayString}"
                                                  StrokeLineCap="Round"
                                                  StrokeJoin="Round"
                                                  Stretch="Fill" />

                                            <!-- Centered Label / Stamp Text (Visible when NOT in edit mode) -->
                                            <TextBlock Text="{Binding Label}"
                                                       FontSize="{Binding LabelFontSize}"
                                                       FontWeight="Bold"
                                                       Foreground="{Binding LabelColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Center"
                                                       Margin="8,4"
                                                       IsVisible="{Binding !IsInEditMode}" />

                                            <!-- In-Place Shape Label Editor (Visible when in edit mode) -->
                                            <TextBox Text="{Binding Label, Mode=TwoWay}"
                                                     FontSize="{Binding LabelFontSize}"
                                                     FontWeight="Bold"
                                                     Foreground="{Binding LabelColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                     Background="#40FFFFFF"
                                                     BorderBrush="{DynamicResource WinAccentBrush}"
                                                     BorderThickness="1"
                                                     CornerRadius="3"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     TextAlignment="Center"
                                                     Padding="6,2"
                                                     MinWidth="60"
                                                     MaxWidth="{Binding Width}"
                                                     IsVisible="{Binding IsInEditMode}"
                                                     AttachedToVisualTree="OnInPlaceTextBoxAttached"
                                                     LostFocus="OnShapeTextBoxLostFocus" />
                                        </Panel>

                                        <!-- Selection Adorner -->
                                        <Grid IsVisible="{Binding IsSelected}" IsHitTestVisible="{Binding !IsInEditMode}">
                                            <Border BorderBrush="{DynamicResource WinAccentBrush}" BorderThickness="1.5" CornerRadius="2" IsHitTestVisible="False" />
                                            <Border Tag="bottomright" Width="8" Height="8" Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinAccentBrush}" BorderThickness="1.5"
                                                    CornerRadius="1.5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-4" Cursor="BottomRightCorner"
                                                    PointerPressed="OnHandlePointerPressed" IsVisible="{Binding !IsInEditMode}" />
                                            <!-- Floating Quick Ask AI Pill -->
                                            <controls:AskAiButton IsVisible="{Binding !IsInEditMode}" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>

                                <!-- 3. DIVIDER ELEMENT TEMPLATE -->
                                <DataTemplate DataType="elvm:DividerElementViewModel">
                                    <Grid Width="{Binding Width}" Height="{Binding Height}" PointerPressed="OnElementPointerPressed">
                                        <Path Data="{Binding PathData}"
                                              Stroke="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                              StrokeThickness="{Binding Thickness}"
                                              StrokeDashArray="{Binding DashArrayString}"
                                              StrokeLineCap="Round"
                                              StrokeJoin="Round"
                                              Stretch="Fill" />

                                        <!-- Selection Adorner -->
                                        <Grid IsVisible="{Binding IsSelected}">
                                            <Border BorderBrush="{DynamicResource WinAccentBrush}" BorderThickness="1.5" CornerRadius="2" IsHitTestVisible="False" />
                                            <Border Tag="right" Width="8" Height="8" Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinAccentBrush}" BorderThickness="1.5"
                                                    CornerRadius="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-4,0" Cursor="SizeWestEast"
                                                    PointerPressed="OnHandlePointerPressed" />

                                            <!-- Floating Quick Ask AI Pill -->
                                            <controls:AskAiButton />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>

                                <!-- 4. TABLE ELEMENT TEMPLATE -->
                                <DataTemplate DataType="elvm:TableElementViewModel">
                                    <Grid Width="{Binding Width}" Height="{Binding Height}">
                                        <Border Background="{DynamicResource WinPanelBrush}"
                                                BorderBrush="{Binding BorderColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                ClipToBounds="True"
                                                PointerPressed="OnElementPointerPressed">
                                            <Grid RowDefinitions="Auto,*">
                                                <!-- Table Header Row -->
                                                <Border Grid.Row="0" Background="{Binding HeaderBackgroundHex, Converter={StaticResource HexToBrushConverter}}" Padding="6,4">
                                                    <ItemsControl ItemsSource="{Binding Headers}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <UniformGrid Rows="1" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="elvm:TableHeaderItem">
                                                                <TextBox Text="{Binding Text, Mode=TwoWay}"
                                                                         FontWeight="Bold"
                                                                         FontSize="10.5"
                                                                         Foreground="{Binding $parent[Border].((elvm:TableElementViewModel)DataContext).HeaderTextHex, Converter={StaticResource HexToBrushConverter}}"
                                                                         Background="Transparent"
                                                                         BorderThickness="0"
                                                                         Padding="4,2"
                                                                         VerticalAlignment="Center"
                                                                         LostFocus="OnTableCellLostFocus" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>

                                                <!-- Table Data Rows -->
                                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding Rows}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="elvm:TableRowItem">
                                                                <Border BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="0,0,0,1" Padding="6,4">
                                                                    <ItemsControl ItemsSource="{Binding Cells}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <UniformGrid Rows="1" />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate DataType="elvm:TableCellItem">
                                                                                <TextBox Text="{Binding Text, Mode=TwoWay}"
                                                                                         FontSize="10"
                                                                                         Foreground="{DynamicResource WinTextBrush}"
                                                                                         Background="Transparent"
                                                                                         BorderThickness="0"
                                                                                         Padding="4,2"
                                                                                         VerticalAlignment="Center"
                                                                                         LostFocus="OnTableCellLostFocus" />
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Grid>
                                        </Border>

                                        <!-- Selection Adorner -->
                                        <Grid IsVisible="{Binding IsSelected}">
                                            <Border BorderBrush="{DynamicResource WinAccentBrush}" BorderThickness="1.5" CornerRadius="2" IsHitTestVisible="False" />
                                            <Border Tag="bottomright" Width="8" Height="8" Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinAccentBrush}" BorderThickness="1.5"
                                                    CornerRadius="1.5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-4" Cursor="BottomRightCorner"
                                                    PointerPressed="OnHandlePointerPressed" />
                                            <!-- Floating Quick Ask AI Pill -->
                                            <controls:AskAiButton />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>

                                <!-- 5. ADVANCED LIVECHARTS2 CHART ELEMENT TEMPLATE -->
                                <DataTemplate DataType="elvm:ChartElementViewModel">
                                    <Grid Width="{Binding Width}" Height="{Binding Height}">
                                        <Border Background="{Binding BackgroundColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                BorderBrush="{Binding BorderColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8,6"
                                                ClipToBounds="True"
                                                PointerPressed="OnElementPointerPressed">
                                            <Grid RowDefinitions="Auto,*">
                                                <!-- Chart Header -->
                                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                                    <TextBlock Grid.Column="0" Text="{Binding Title}"
                                                               FontSize="11" FontWeight="Bold" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <Border Grid.Column="1" Background="{DynamicResource WinCardBorderBrush}" CornerRadius="4" Padding="5,1">
                                                        <TextBlock Text="{Binding ChartTypeDescription}" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource WinMutedBrush}" />
                                                    </Border>
                                                </Grid>

                                                <!-- High-DPI LiveCharts2 Skia Image -->
                                                <Image Grid.Row="1"
                                                       Source="{Binding ChartBitmap}"
                                                       Stretch="Fill"
                                                       RenderOptions.BitmapInterpolationMode="HighQuality" />
                                            </Grid>
                                        </Border>

                                        <!-- Selection Adorner -->
                                        <Grid IsVisible="{Binding IsSelected}">
                                            <Border BorderBrush="{DynamicResource WinAccentBrush}" BorderThickness="1.5" CornerRadius="2" IsHitTestVisible="False" />
                                            <Border Tag="bottomright" Width="8" Height="8" Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinAccentBrush}" BorderThickness="1.5"
                                                    CornerRadius="1.5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-4" Cursor="BottomRightCorner"
                                                    PointerPressed="OnHandlePointerPressed" />
                                            <!-- Floating Quick Ask AI Pill -->
                                            <controls:AskAiButton />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>

                                <!-- 6. IMAGE ELEMENT TEMPLATE -->
                                <DataTemplate DataType="elvm:ImageElementViewModel">
                                    <Grid Width="{Binding Width}" Height="{Binding Height}">
                                        <Border Background="Transparent"
                                                BorderBrush="{Binding BorderColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                BorderThickness="{Binding BorderThickness, Converter={StaticResource DoubleToThickness}}"
                                                CornerRadius="{Binding CornerRadius, Converter={StaticResource DoubleToCornerRadius}}"
                                                ClipToBounds="True"
                                                PointerPressed="OnElementPointerPressed">
                                            <Panel>
                                                <Image Source="{Binding PreviewBitmap}"
                                                       RenderOptions.BitmapInterpolationMode="HighQuality"
                                                       Stretch="{Binding KeepAspectRatio, Converter={x:Static converters:BooleanToStretchConverter.Instance}}"
                                                       IsVisible="{Binding PreviewBitmap, Converter={StaticResource NullToBooleanConverter}}" />

                                                <Border Background="{DynamicResource WinInputBgBrush}"
                                                        IsVisible="{Binding PreviewBitmap, Converter={x:Static converters:EqualityToBooleanConverter.Instance}, ConverterParameter={x:Null}, FallbackValue=True}">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                                                        <materialIcons:MaterialIcon Kind="ImageOutline" Width="36" Height="36" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Center" />
                                                        <TextBlock Text="{Binding AltText}" FontSize="11" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </Panel>
                                        </Border>

                                        <Grid IsVisible="{Binding IsSelected}">
                                            <Border BorderBrush="{DynamicResource WinAccentBrush}" BorderThickness="1.5" CornerRadius="2" IsHitTestVisible="False" />
                                            <Border Tag="bottomright" Width="8" Height="8" Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinAccentBrush}" BorderThickness="1.5"
                                                    CornerRadius="1.5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-4" Cursor="BottomRightCorner"
                                                    PointerPressed="OnHandlePointerPressed" />

                                            <!-- Floating Quick Ask AI Pill -->
                                            <controls:AskAiButton />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>

                                <!-- 7. WATERMARK ELEMENT TEMPLATE -->
                                <DataTemplate DataType="elvm:WatermarkElementViewModel">
                                    <Grid Width="{Binding Width}" Height="{Binding Height}" PointerPressed="OnElementPointerPressed">
                                        <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <LayoutTransformControl.LayoutTransform>
                                                <RotateTransform Angle="{Binding Angle}" />
                                            </LayoutTransformControl.LayoutTransform>
                                            <TextBlock Text="{Binding Text}"
                                                       FontSize="{Binding FontSize}"
                                                       FontWeight="Bold"
                                                       Opacity="{Binding Opacity}"
                                                       Foreground="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}" />
                                        </LayoutTransformControl>
                                        <Grid IsVisible="{Binding IsSelected}">
                                            <Border BorderBrush="{DynamicResource WinDangerBrush}" BorderThickness="1" IsHitTestVisible="False" />
                                            <!-- Floating Quick Ask AI Pill -->
                                            <controls:AskAiButton />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>

                                <!-- 8. FORM FIELD ELEMENT TEMPLATE -->
                                <DataTemplate DataType="elvm:FormFieldElementViewModel">
                                    <Grid Width="{Binding Width}" Height="{Binding Height}" PointerPressed="OnElementPointerPressed">
                                        <Border Background="{Binding BackgroundColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                BorderBrush="{Binding BorderColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                BorderThickness="1.5"
                                                CornerRadius="4"
                                                Padding="8,4">
                                            <!-- Field layout based on type -->
                                            <Panel>
                                                <!-- 1. Checkbox Field -->
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                                            IsVisible="{Binding FieldType, Converter={StaticResource EqualityConverter}, ConverterParameter=Checkbox}">
                                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Label}" FontSize="{Binding FontSize}" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <!-- 2. Signature Field -->
                                                <Grid RowDefinitions="Auto,*,Auto"
                                                      IsVisible="{Binding FieldType, Converter={StaticResource EqualityConverter}, ConverterParameter=Signature}">
                                                    <TextBlock Grid.Row="0" Text="{Binding Label}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource WinMutedBrush}" />
                                                    <Border Grid.Row="1" BorderBrush="{DynamicResource WinBorderBrush}" BorderThickness="0,0,0,1.5" Margin="0,4,0,2">
                                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <materialIcons:MaterialIcon Kind="DrawPen" Width="18" Height="18" Foreground="{DynamicResource WinAccentBrush}" />
                                                            <TextBlock Text="[Click / Sign Here]" FontSize="12" FontStyle="Italic" Foreground="{DynamicResource WinAccentBrush}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                    <TextBlock Grid.Row="2" Text="Digitally Verified Identity" FontSize="9" Foreground="{DynamicResource WinSubtleBrush}" HorizontalAlignment="Right" />
                                                </Grid>

                                                <!-- 3. Standard Single-Line Text Field -->
                                                <StackPanel Spacing="3"
                                                            IsVisible="{Binding FieldType, Converter={StaticResource EqualityConverter}, ConverterParameter=Text}">
                                                    <TextBlock Text="{Binding Label}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource WinMutedBrush}" />
                                                    <TextBox Text="{Binding Value, Mode=TwoWay}"
                                                             PlaceholderText="{Binding Placeholder}"
                                                             FontSize="{Binding FontSize}"
                                                             Height="28" Padding="6,2" />
                                                </StackPanel>

                                                <!-- 4. Multiline Text Area -->
                                                <StackPanel Spacing="3"
                                                            IsVisible="{Binding FieldType, Converter={StaticResource EqualityConverter}, ConverterParameter=MultilineText}">
                                                    <TextBlock Text="{Binding Label}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource WinMutedBrush}" />
                                                    <TextBox Text="{Binding Value, Mode=TwoWay}"
                                                             PlaceholderText="{Binding Placeholder}"
                                                             FontSize="{Binding FontSize}"
                                                             AcceptsReturn="True"
                                                             TextWrapping="Wrap"
                                                             Height="50" Padding="6,4" />
                                                </StackPanel>

                                                <!-- 5. Radio Button Field -->
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                                            IsVisible="{Binding FieldType, Converter={StaticResource EqualityConverter}, ConverterParameter=Radio}">
                                                    <RadioButton IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Label}" FontSize="{Binding FontSize}" Foreground="{DynamicResource WinTextBrush}" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <!-- 6. Dropdown Select Field -->
                                                <StackPanel Spacing="3"
                                                            IsVisible="{Binding FieldType, Converter={StaticResource EqualityConverter}, ConverterParameter=Dropdown}">
                                                    <TextBlock Text="{Binding Label}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource WinMutedBrush}"
                                                               IsVisible="{Binding ShowLabel}" />
                                                    <ComboBox ItemsSource="{Binding Options}"
                                                              SelectedItem="{Binding Value, Mode=TwoWay}"
                                                              PlaceholderText="{Binding Placeholder}"
                                                              FontSize="{Binding FontSize}"
                                                              HorizontalAlignment="Stretch"
                                                              Height="28" CornerRadius="4" />
                                                </StackPanel>

                                                <!-- 7. Date Picker Field -->
                                                <StackPanel Spacing="3"
                                                            IsVisible="{Binding FieldType, Converter={StaticResource EqualityConverter}, ConverterParameter=DatePicker}">
                                                    <TextBlock Text="{Binding Label}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource WinMutedBrush}"
                                                               IsVisible="{Binding ShowLabel}" />
                                                    <CalendarDatePicker SelectedDate="{Binding Value, Mode=TwoWay, Converter={StaticResource DateTimeFormatConverter}}"
                                                                        PlaceholderText="{Binding Placeholder, FallbackValue='YYYY-MM-DD'}"
                                                                        FontSize="{Binding FontSize}"
                                                                        HorizontalAlignment="Stretch"
                                                                        Height="28" CornerRadius="4" />
                                                </StackPanel>

                                                <!-- 8. Number / Currency Field -->
                                                <StackPanel Spacing="3"
                                                            IsVisible="{Binding FieldType, Converter={StaticResource EqualityConverter}, ConverterParameter=Number}">
                                                    <TextBlock Text="{Binding Label}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource WinMutedBrush}" />
                                                    <TextBox Text="{Binding Value, Mode=TwoWay}"
                                                             PlaceholderText="{Binding Placeholder, FallbackValue='0.00'}"
                                                             FontSize="{Binding FontSize}"
                                                             Height="28" Padding="6,2" />
                                                </StackPanel>

                                                <!-- 9. Signature Line Field -->
                                                <Grid RowDefinitions="Auto,*,Auto"
                                                      IsVisible="{Binding FieldType, Converter={StaticResource EqualityConverter}, ConverterParameter=SignatureLine}">
                                                    <TextBlock Grid.Row="0" Text="{Binding Label}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource WinMutedBrush}" />
                                                    <Border Grid.Row="1" BorderBrush="#0F6CBD" BorderThickness="0,0,0,1.5" Margin="0,4,0,2">
                                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <materialIcons:MaterialIcon Kind="DrawPen" Width="18" Height="18" Foreground="{DynamicResource WinAccentBrush}" />
                                                            <TextBlock Text="[Authorized Signature Line]" FontSize="11" FontStyle="Italic" Foreground="{DynamicResource WinAccentBrush}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                    <TextBlock Grid.Row="2" Text="Signed &amp; Sealed Under Penalty of Law" FontSize="8.5" Foreground="{DynamicResource WinSubtleBrush}" HorizontalAlignment="Right" />
                                                </Grid>

                                                <!-- 10. Push Button Field -->
                                                <Border Background="{DynamicResource WinAccentBrush}" CornerRadius="4" Height="30" Padding="12,4" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        IsVisible="{Binding FieldType, Converter={StaticResource EqualityConverter}, ConverterParameter=Button}">
                                                    <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </Border>
                                            </Panel>
                                        </Border>

                                        <!-- Selection Adorner -->
                                        <Grid IsVisible="{Binding IsSelected}">
                                            <Border BorderBrush="{DynamicResource WinAccentBrush}" BorderThickness="1.5" CornerRadius="2" IsHitTestVisible="False" />
                                            <Border Tag="bottomright" Width="8" Height="8" Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinAccentBrush}" BorderThickness="1.5"
                                                    CornerRadius="1.5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-4" Cursor="BottomRightCorner"
                                                    PointerPressed="OnHandlePointerPressed" />

                                            <!-- Floating Quick Ask AI Pill -->
                                            <controls:AskAiButton />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>

                                <!-- 9. QR CODE ELEMENT TEMPLATE -->
                                <DataTemplate DataType="elvm:QrCodeElementViewModel">
                                    <Grid Width="{Binding Width}" Height="{Binding Height}" PointerPressed="OnElementPointerPressed">
                                        <Border Background="{Binding LightColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                BorderBrush="{DynamicResource WinBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="6"
                                                BoxShadow="0 1 4 #08000000">
                                            <Grid RowDefinitions="*,Auto">
                                                <!-- Live scannable QR Code Image -->
                                                <Image Grid.Row="0"
                                                       Source="{Binding QrBitmap}"
                                                       Stretch="Uniform"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="1" Text="{Binding Label}" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource WinMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                                            </Grid>
                                        </Border>

                                        <!-- Selection Adorner -->
                                        <Grid IsVisible="{Binding IsSelected}">
                                            <Border BorderBrush="{DynamicResource WinAccentBrush}" BorderThickness="1.5" CornerRadius="2" IsHitTestVisible="False" />
                                            <Border Tag="bottomright" Width="8" Height="8" Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinAccentBrush}" BorderThickness="1.5"
                                                    CornerRadius="1.5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-4" Cursor="BottomRightCorner"
                                                    PointerPressed="OnHandlePointerPressed" />

                                            <!-- Floating Quick Ask AI Pill -->
                                            <controls:AskAiButton />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>

                                <!-- 10. BARCODE ELEMENT TEMPLATE -->
                                <DataTemplate DataType="elvm:BarcodeElementViewModel">
                                    <Grid Width="{Binding Width}" Height="{Binding Height}" PointerPressed="OnElementPointerPressed">
                                        <Border Background="{DynamicResource WinPanelBrush}"
                                                BorderBrush="{DynamicResource WinBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8,4">
                                            <Grid RowDefinitions="*,Auto">
                                                <materialIcons:MaterialIcon Grid.Row="0" Kind="Barcode" Width="180" Height="36" Foreground="{Binding BarColorHex, Converter={StaticResource HexToBrushConverter}}" HorizontalAlignment="Center" />
                                                <TextBlock Grid.Row="1" Text="{Binding CodeValue}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource WinTextBrush}" HorizontalAlignment="Center" LetterSpacing="1.2" IsVisible="{Binding ShowText}" />
                                            </Grid>
                                        </Border>

                                        <!-- Selection Adorner -->
                                        <Grid IsVisible="{Binding IsSelected}">
                                            <Border BorderBrush="{DynamicResource WinAccentBrush}" BorderThickness="1.5" CornerRadius="2" IsHitTestVisible="False" />
                                            <Border Tag="bottomright" Width="8" Height="8" Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinAccentBrush}" BorderThickness="1.5"
                                                    CornerRadius="1.5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-4" Cursor="BottomRightCorner"
                                                    PointerPressed="OnHandlePointerPressed" />

                                            <!-- Floating Quick Ask AI Pill -->
                                            <controls:AskAiButton />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>

                                <!-- 11. REDACTION ELEMENT TEMPLATE -->
                                <DataTemplate DataType="elvm:RedactionElementViewModel">
                                    <Grid Width="{Binding Width}" Height="{Binding Height}" PointerPressed="OnElementPointerPressed">
                                        <Border Background="{Binding FillColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                BorderBrush="{Binding BorderColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                BorderThickness="{Binding BorderThickness, Converter={StaticResource DoubleToThickness}}"
                                                CornerRadius="2"
                                                Padding="4">
                                            <TextBlock Text="{Binding ExemptionCode}"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{Binding TextColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding ShowOverlayText}" />
                                        </Border>

                                        <!-- Selection Adorner -->
                                        <Grid IsVisible="{Binding IsSelected}">
                                            <Border BorderBrush="{DynamicResource WinDangerBrush}" BorderThickness="1.5" CornerRadius="2" IsHitTestVisible="False" />
                                            <Border Tag="bottomright" Width="8" Height="8" Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinDangerBrush}" BorderThickness="1.5"
                                                    CornerRadius="1.5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-4" Cursor="BottomRightCorner"
                                                    PointerPressed="OnHandlePointerPressed" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>

                                <!-- 12. INK & HIGHLIGHTER ELEMENT TEMPLATE -->
                                <DataTemplate DataType="elvm:InkElementViewModel">
                                    <Grid Width="{Binding Width}" Height="{Binding Height}" PointerPressed="OnElementPointerPressed" Background="Transparent">
                                        <!-- Highlighter / Ink Stroke Vector Path -->
                                        <Path Data="{Binding PathData}"
                                              Stroke="{Binding StrokeColorHex, Converter={StaticResource HexToBrushConverter}}"
                                              StrokeThickness="{Binding StrokeThickness}"
                                              StrokeLineCap="Round"
                                              StrokeJoin="Round"
                                              Opacity="{Binding Opacity}"
                                              Stretch="None" />
                                        <Border BorderBrush="{DynamicResource WinAccentBrush}" BorderThickness="1" IsVisible="{Binding IsSelected}" IsHitTestVisible="False" />
                                    </Grid>
                                </DataTemplate>

                                <!-- 13. STICKY NOTE ELEMENT TEMPLATE -->
                                <DataTemplate DataType="elvm:StickyNoteElementViewModel">
                                    <Grid Width="{Binding Width}" Height="{Binding Height}" PointerPressed="OnElementPointerPressed">
                                        <Border Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                BorderBrush="{Binding BorderColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                BoxShadow="0 4 12 #20000000"
                                                Padding="10">
                                            <Grid RowDefinitions="Auto,*,Auto">
                                                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">
                                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="NoteTextOutline" Width="14" Height="14" Foreground="#B45309" Margin="0,0,4,0" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Author}" FontSize="10.5" FontWeight="Bold" Foreground="#78350F" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Timestamp}" FontSize="8.5" Foreground="#92400E" VerticalAlignment="Center" />
                                                </Grid>
                                                <TextBox Grid.Row="1" Text="{Binding NoteText, Mode=TwoWay}"
                                                         FontSize="10.5" Foreground="#78350F" Background="Transparent"
                                                         BorderThickness="0" TextWrapping="Wrap" AcceptsReturn="True"
                                                         LostFocus="OnStickyNoteTextBoxLostFocus" />
                                                <Border Grid.Row="2" Background="#FEF3C7" CornerRadius="3" Padding="4,2" HorizontalAlignment="Left" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding Status}" FontSize="9" FontWeight="SemiBold" Foreground="#B45309" />
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Selection Adorner -->
                                        <Grid IsVisible="{Binding IsSelected}">
                                            <Border BorderBrush="{DynamicResource WinAccentBrush}" BorderThickness="1.5" CornerRadius="2" IsHitTestVisible="False" />
                                            <Border Tag="bottomright" Width="8" Height="8" Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinAccentBrush}" BorderThickness="1.5"
                                                    CornerRadius="1.5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-4" Cursor="BottomRightCorner"
                                                    PointerPressed="OnHandlePointerPressed" />

                                            <!-- Floating Quick Ask AI Pill -->
                                            <controls:AskAiButton />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>

                                <!-- 14. MEASUREMENT DIMENSION ELEMENT TEMPLATE -->
                                <DataTemplate DataType="elvm:MeasurementElementViewModel">
                                    <Grid Width="{Binding Width}" Height="{Binding Height}" PointerPressed="OnElementPointerPressed">
                                        <!-- Vector Dimension Graphic with Terminal Ticks -->
                                        <Canvas Width="{Binding Width}" Height="{Binding Height}">
                                            <!-- Left Tick -->
                                            <Line StartPoint="0,4" EndPoint="0,28" Stroke="{Binding StrokeColorHex, Converter={StaticResource HexToBrushConverter}}" StrokeThickness="{Binding StrokeThickness}" />
                                            <!-- Right Tick -->
                                            <Line StartPoint="{Binding Width, StringFormat='{}{0},4'}" EndPoint="{Binding Width, StringFormat='{}{0},28'}" Stroke="{Binding StrokeColorHex, Converter={StaticResource HexToBrushConverter}}" StrokeThickness="{Binding StrokeThickness}" />
                                            <!-- Horizontal Dimension Axis -->
                                            <Line StartPoint="0,16" EndPoint="{Binding Width, StringFormat='{}{0},16'}" Stroke="{Binding StrokeColorHex, Converter={StaticResource HexToBrushConverter}}" StrokeThickness="{Binding StrokeThickness}" />
                                        </Canvas>

                                        <!-- Dimension Readout Badge -->
                                        <Border Background="{DynamicResource WinPanelBrush}" BorderBrush="{Binding StrokeColorHex, Converter={StaticResource HexToBrushConverter}}" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FormattedDistance}" FontSize="{Binding FontSize}" FontWeight="Bold" Foreground="{Binding StrokeColorHex, Converter={StaticResource HexToBrushConverter}}" />
                                        </Border>

                                        <!-- Selection Adorner -->
                                        <Grid IsVisible="{Binding IsSelected}">
                                            <Border BorderBrush="{DynamicResource WinAccentBrush}" BorderThickness="1.5" CornerRadius="2" IsHitTestVisible="False" />
                                            <Border Tag="right" Width="8" Height="8" Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinAccentBrush}" BorderThickness="1.5"
                                                    CornerRadius="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-4,0" Cursor="SizeWestEast"
                                                    PointerPressed="OnHandlePointerPressed" />

                                            <!-- Floating Quick Ask AI Pill -->
                                            <controls:AskAiButton />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>

                                <!-- 15. SVG VECTOR ART & ORNAMENTS TEMPLATE -->
                                <DataTemplate DataType="elvm:SvgElementViewModel">
                                    <Grid Width="{Binding Width}" Height="{Binding Height}">
                                        <Border Background="Transparent"
                                                BorderBrush="{Binding BorderColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                BorderThickness="{Binding BorderThickness, Converter={StaticResource DoubleToThickness}}"
                                                CornerRadius="{Binding CornerRadius, Converter={StaticResource DoubleToCornerRadius}}"
                                                ClipToBounds="True"
                                                PointerPressed="OnElementPointerPressed">
                                            <Panel>
                                                <Image Source="{Binding PreviewBitmap}"
                                                       RenderOptions.BitmapInterpolationMode="HighQuality"
                                                       Stretch="{Binding KeepAspectRatio, Converter={x:Static converters:BooleanToStretchConverter.Instance}}"
                                                       IsVisible="{Binding PreviewBitmap, Converter={StaticResource NullToBooleanConverter}}" />

                                                <Viewbox Stretch="Uniform"
                                                         IsVisible="{Binding PreviewBitmap, Converter={x:Static converters:EqualityToBooleanConverter.Instance}, ConverterParameter={x:Null}, FallbackValue=True}">
                                                    <Path Data="{Binding PathGeometryData}"
                                                          Fill="{Binding TintColorHex, Converter={StaticResource HexToBrushConverter}, FallbackValue='#D97706'}"
                                                          Stroke="{Binding TintColorHex, Converter={StaticResource HexToBrushConverter}, FallbackValue='#8B0000'}"
                                                          StrokeThickness="1.5" />
                                                </Viewbox>
                                            </Panel>
                                        </Border>

                                        <!-- Selection Adorner -->
                                        <Grid IsVisible="{Binding IsSelected}">
                                            <Border BorderBrush="{DynamicResource WinAccentBrush}" BorderThickness="1.5" CornerRadius="2" IsHitTestVisible="False" />
                                            <Border Tag="bottomright" Width="8" Height="8" Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinAccentBrush}" BorderThickness="1.5"
                                                    CornerRadius="1.5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-4" Cursor="BottomRightCorner"
                                                    PointerPressed="OnHandlePointerPressed" />

                                            <!-- Floating Quick Ask AI Pill -->
                                            <controls:AskAiButton />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>

                                <!-- 16. MATHEMATICAL EQUATION & FORMULA TEMPLATE -->
                                <DataTemplate DataType="elvm:MathElementViewModel">
                                    <Grid Width="{Binding Width}" Height="{Binding Height}">
                                        <!-- Visual Container Box -->
                                        <Border Background="{Binding BackgroundColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                BorderBrush="{Binding BorderColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                BorderThickness="{Binding BorderThickness, Converter={StaticResource DoubleToThickness}}"
                                                CornerRadius="{Binding CornerRadius, Converter={StaticResource DoubleToCornerRadius}}"
                                                Padding="{Binding Padding, Converter={StaticResource DoubleToThickness}}"
                                                PointerPressed="OnElementPointerPressed">

                                            <Grid>
                                                <!-- High-Precision Vector Math Rendering Canvas -->
                                                <views:MathFormulaControl Formula="{Binding Formula}"
                                                                          FontSize="{Binding FontSize}"
                                                                          TextColor="{Binding TextColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                          ShowEquationNumber="{Binding ShowEquationNumber}"
                                                                          EquationNumber="{Binding EquationNumber}"
                                                                          Alignment="{Binding Alignment}"
                                                                          IsVisible="{Binding !IsInEditMode}"
                                                                          DoubleTapped="OnMathElementDoubleTapped" />

                                                <!-- In-Place Editable LaTeX Code Box -->
                                                <TextBox Text="{Binding Formula, Mode=TwoWay}"
                                                         FontFamily="Cascadia Code, Consolas, Courier New, monospace"
                                                         FontSize="11.5"
                                                         Foreground="{Binding TextColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         Padding="4"
                                                         IsVisible="{Binding IsInEditMode}"
                                                         AttachedToVisualTree="OnInPlaceTextBoxAttached"
                                                         LostFocus="OnMathTextBoxLostFocus" />
                                            </Grid>
                                        </Border>

                                        <!-- Selection Adorner & 8 Resize Handles -->
                                        <Grid IsVisible="{Binding IsSelected}" IsHitTestVisible="True">
                                            <Border BorderBrush="{DynamicResource WinAccentBrush}" BorderThickness="1.5" CornerRadius="2" IsHitTestVisible="False" />

                                            <Border Tag="topleft" Width="8" Height="8" Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinAccentBrush}" BorderThickness="1.5"
                                                    CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-4,-4,0,0" Cursor="TopLeftCorner"
                                                    PointerPressed="OnHandlePointerPressed" />
                                            <Border Tag="top" Width="8" Height="8" Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinAccentBrush}" BorderThickness="1.5"
                                                    CornerRadius="1.5" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-4,0,0" Cursor="SizeNorthSouth"
                                                    PointerPressed="OnHandlePointerPressed" />
                                            <Border Tag="topright" Width="8" Height="8" Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinAccentBrush}" BorderThickness="1.5"
                                                    CornerRadius="1.5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0" Cursor="TopRightCorner"
                                                    PointerPressed="OnHandlePointerPressed" />
                                            <Border Tag="left" Width="8" Height="8" Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinAccentBrush}" BorderThickness="1.5"
                                                    CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-4,0,0,0" Cursor="SizeWestEast"
                                                    PointerPressed="OnHandlePointerPressed" />
                                            <Border Tag="right" Width="8" Height="8" Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinAccentBrush}" BorderThickness="1.5"
                                                    CornerRadius="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-4,0" Cursor="SizeWestEast"
                                                    PointerPressed="OnHandlePointerPressed" />
                                            <Border Tag="bottomleft" Width="8" Height="8" Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinAccentBrush}" BorderThickness="1.5"
                                                    CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-4,0,0,-4" Cursor="BottomLeftCorner"
                                                    PointerPressed="OnHandlePointerPressed" />
                                            <Border Tag="bottom" Width="8" Height="8" Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinAccentBrush}" BorderThickness="1.5"
                                                    CornerRadius="1.5" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-4" Cursor="SizeNorthSouth"
                                                    PointerPressed="OnHandlePointerPressed" />
                                            <Border Tag="bottomright" Width="8" Height="8" Background="{DynamicResource WinPanelBrush}" BorderBrush="{DynamicResource WinAccentBrush}" BorderThickness="1.5"
                                                    CornerRadius="1.5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-4" Cursor="BottomRightCorner"
                                                    PointerPressed="OnHandlePointerPressed" />

                                            <!-- Floating Quick Ask AI Pill -->
                                            <controls:AskAiButton IsVisible="{Binding !IsInEditMode}" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>

                            </ItemsControl.DataTemplates>
                        </ItemsControl>

                        <!-- Page Footer Bar (Inside page margins) -->
                        <Border VerticalAlignment="Bottom"
                                Height="38"
                                Padding="30,0"
                                BorderBrush="{DynamicResource WinBorderBrush}"
                                BorderThickness="0,1,0,0"
                                Background="Transparent"
                                IsHitTestVisible="False"
                                IsVisible="{Binding CurrentPage.ShowHeaderFooter}">
                            <Grid ColumnDefinitions="*,*">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding CurrentPage.FooterLeft}"
                                           FontSize="10"
                                           Foreground="{DynamicResource WinSubtleBrush}"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding CurrentPage.FooterRight}"
                                           FontSize="10"
                                           Foreground="{DynamicResource WinSubtleBrush}"
                                           FontWeight="Medium"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <!-- Marquee Selection Rectangle Overlay -->
                        <Canvas Width="{Binding CurrentPage.Width, FallbackValue=800}"
                                Height="{Binding CurrentPage.Height, FallbackValue=1131}"
                                IsHitTestVisible="False">
                            <Border x:Name="MarqueeSelectionBox"
                                    IsVisible="False"
                                    Background="#180F6CBD"
                                    BorderBrush="#0F6CBD"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    Canvas.Left="0"
                                    Canvas.Top="0"
                                    Width="0"
                                    Height="0" />
                        </Canvas>

                        <!-- Interactive AI Target Point Reticle / Pin Overlay -->
                        <Canvas Width="{Binding CurrentPage.Width, FallbackValue=800}"
                                Height="{Binding CurrentPage.Height, FallbackValue=1131}"
                                IsVisible="{Binding AiAssistant.HasTargetPoint}"
                                IsHitTestVisible="True">
                            <Grid Canvas.Left="{Binding AiAssistant.TargetPointX}"
                                  Canvas.Top="{Binding AiAssistant.TargetPointY}"
                                  Margin="-18,-18,0,0">
                                <!-- Pulsing Outer Glow Ring -->
                                <Border Width="36" Height="36"
                                        CornerRadius="18"
                                        BorderBrush="#7C3AED"
                                        BorderThickness="1.5"
                                        Background="#207C3AED"
                                        BoxShadow="0 0 16 #507C3AED" />

                                <!-- Inner Target Center Dot -->
                                <Border Width="8" Height="8"
                                        CornerRadius="4"
                                        Background="#7C3AED"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />

                                <!-- Floating Coordinate Tag Pill with Close Button -->
                                <Border HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="24,-12,0,0"
                                        Background="#1E1B4B"
                                        BorderBrush="#7C3AED"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="8,3"
                                        BoxShadow="0 4 12 #60000000">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="Target" Width="12" Height="12" Foreground="#C4B5FD" />
                                        <TextBlock Text="{Binding AiAssistant.TargetPointDisplay, StringFormat='AI Target ({0})'}"
                                                   Foreground="#EDE9FE"
                                                   FontWeight="SemiBold"
                                                   FontSize="10.5"
                                                   VerticalAlignment="Center" />
                                        <Button Classes="mini-tool-btn"
                                                Width="16" Height="16"
                                                Padding="0"
                                                Command="{Binding AiAssistant.ClearTargetPointCommand}"
                                                ToolTip.Tip="Clear target point (Revert to Entire Page)">
                                            <materialIcons:MaterialIcon Kind="Close" Width="10" Height="10" Foreground="#C4B5FD" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Canvas>

                        <!-- Entire Page Focus Outline (when whole page is selected and no element is selected) -->
                        <Border IsVisible="{Binding AiAssistant.IsPageTargetMode}"
                                IsHitTestVisible="False"
                                BorderBrush="{DynamicResource M3PrimaryBrush}"
                                BorderThickness="1.5"
                                CornerRadius="2">
                            <!-- Floating Page Focus Pill Badge in Top-Left Corner -->
                            <Border HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="10,10,0,0"
                                    Background="{DynamicResource M3SurfaceContainerHighestBrush}"
                                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource M3ShapeCornerFull}"
                                    Padding="8,3.5"
                                    BoxShadow="0 2 8 #20000000">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="FileDocumentOutline" Width="13" Height="13" Foreground="{DynamicResource M3PrimaryBrush}" />
                                    <TextBlock Text="{Binding CurrentPage.PageNumber, StringFormat='Page {0} Selected'}"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                    <TextBlock Text="{Binding AiAssistant.TargetPageDimensions, StringFormat='• {0}'}"
                                               FontSize="10"
                                               Foreground="{DynamicResource WinMutedBrush}" />
                                </StackPanel>
                            </Border>
                        </Border>
                    </Grid>
                </Border>
            </LayoutTransformControl>
        </Grid>
    </ScrollViewer>

    <!-- Multi-Selection Summary Pill Overlay -->
    <Border IsVisible="{Binding CurrentPage.HasMultiSelection, FallbackValue=False}"
            Background="#0F6CBD"
            CornerRadius="12"
            Padding="12,5"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,16,0,0"
            BoxShadow="0 4 12 #40000000"
            IsHitTestVisible="False">
        <StackPanel Orientation="Horizontal" Spacing="6">
            <materialIcons:MaterialIcon Kind="SelectMultiple" Width="15" Height="15" Foreground="White" />
            <TextBlock Text="{Binding CurrentPage.SelectionCount, StringFormat='{}{0} Elements Selected'}" Foreground="White" FontWeight="SemiBold" FontSize="12" />
        </StackPanel>
    </Border>

    <!-- Floating In-Canvas Text Formatting HUD Bar (Contextual when Text Element is Selected) -->
    <views:CanvasTextHudView HorizontalAlignment="Center"
                             VerticalAlignment="Top"
                             Margin="0,16,0,0"
                             IsVisible="{Binding Inspector.IsTextElement}" />

    <!-- Floating In-Canvas Find & Replace HUD Bar -->
    <views:FindReplaceBarView HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,24,0" IsVisible="{Binding IsFindReplaceOpen}" />

    </Grid>
</Grid>
</UserControl>
