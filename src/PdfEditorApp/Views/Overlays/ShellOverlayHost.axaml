<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PdfEditorApp.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
             x:Class="PdfEditorApp.Views.Overlays.ShellOverlayHost"
             x:Name="RootOverlayHost"
             x:DataType="vm:MainViewModel"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <ItemsControl ItemsSource="{Binding ActiveOverlays}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <Canvas Width="{Binding $parent[UserControl].Bounds.Width}"
                        Height="{Binding $parent[UserControl].Bounds.Height}" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemContainerTheme>
            <ControlTheme TargetType="ContentPresenter" x:DataType="vm:OverlayInstanceViewModel">
                <Setter Property="Canvas.Left" Value="{Binding X}" />
                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                <Setter Property="Canvas.ZIndex" Value="{Binding ZIndex}" />
                <Setter Property="IsVisible" Value="{Binding IsVisible}" />
            </ControlTheme>
        </ItemsControl.ItemContainerTheme>

        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:OverlayInstanceViewModel" x:DataType="vm:OverlayInstanceViewModel">
                <Panel PointerPressed="OnOverlayPointerPressed">
                    <!-- 1. CUSTOM CHROME (games, immersive canvas, full-bleed views) -->
                    <ContentControl Content="{Binding CustomChromeContent}"
                                    IsVisible="{Binding HasCustomChrome}" />

                    <!-- 2. STANDARD M3 CARD CHROME (utilities, telemetry, forms) -->
                    <Border IsVisible="{Binding HasStandardChrome}"
                            Background="{DynamicResource M3SurfaceContainerHighBrush}"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource M3ShapeCornerLarge}"
                            BoxShadow="{StaticResource M3ElevationLevel3}"
                            ClipToBounds="True"
                            Width="{Binding Width, Mode=TwoWay}"
                            Height="{Binding EffectiveHeight}"
                            MinWidth="{Binding Descriptor.MinWidth}"
                            MinHeight="{Binding EffectiveMinHeight}">
                        <Panel>
                            <Grid RowDefinitions="Auto,*">
                                <!-- Draggable Header -->
                                <Border Grid.Row="0"
                                        Background="{DynamicResource M3SurfaceContainerHighestBrush}"
                                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                        BorderThickness="0,0,0,1"
                                        Height="42"
                                        Padding="12,0"
                                        PointerPressed="OnStandardHeaderPointerPressed"
                                        PointerMoved="OnStandardHeaderPointerMoved"
                                        PointerReleased="OnStandardHeaderPointerReleased"
                                        Cursor="SizeAll">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" VerticalAlignment="Center">
                                        <!-- Icon and Title -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="{Binding IconKind}"
                                                                        Width="16" Height="16"
                                                                        Foreground="{DynamicResource M3PrimaryBrush}"
                                                                        VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource M3OnSurfaceBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Pin Toggle Button -->
                                        <ToggleButton Grid.Column="2"
                                                      IsChecked="{Binding IsPinned}"
                                                      Classes="m3-icon-btn"
                                                      Width="26" Height="26"
                                                      Padding="0"
                                                      Margin="2,0"
                                                      Background="Transparent"
                                                      BorderThickness="0"
                                                      Cursor="Hand"
                                                      ToolTip.Tip="Pin Overlay (Keep Visible)">
                                            <materialIcons:MaterialIcon Kind="PinOutline" Width="14" Height="14" Foreground="{DynamicResource WinMutedBrush}" />
                                        </ToggleButton>

                                        <!-- Minimize / Restore Button -->
                                        <Button Grid.Column="3"
                                                Command="{Binding ToggleMinimizeCommand}"
                                                Classes="m3-icon-btn"
                                                Width="26" Height="26"
                                                Padding="0"
                                                Margin="2,0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                ToolTip.Tip="Minimize / Expand Overlay">
                                            <materialIcons:MaterialIcon Kind="Minus" Width="14" Height="14" Foreground="{DynamicResource WinMutedBrush}" />
                                        </Button>

                                        <!-- Close Button -->
                                        <Button Grid.Column="4"
                                                Command="{Binding CloseCommand}"
                                                Classes="m3-icon-btn"
                                                Width="26" Height="26"
                                                Padding="0"
                                                Margin="2,0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                ToolTip.Tip="Close Overlay">
                                            <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14" Foreground="{DynamicResource WinMutedBrush}" />
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Content Body (collapses when minimized) -->
                                <ContentControl Grid.Row="1"
                                                Content="{Binding StandardChromeContent}"
                                                IsVisible="{Binding !IsMinimized}" />
                            </Grid>

                            <!-- RESIZE OVERLAYS (Active only when CanResize is true) -->
                            <!-- Right Edge Resize Strip -->
                            <Border Width="6" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                    Background="Transparent"
                                    Cursor="SizeWestEast"
                                    IsVisible="{Binding CanResize}"
                                    PointerPressed="OnResizeRightPointerPressed"
                                    PointerMoved="OnResizePointerMoved"
                                    PointerReleased="OnResizePointerReleased" />

                            <!-- Bottom Edge Resize Strip -->
                            <Border Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                                    Background="Transparent"
                                    Cursor="SizeNorthSouth"
                                    IsVisible="{Binding CanResize}"
                                    PointerPressed="OnResizeBottomPointerPressed"
                                    PointerMoved="OnResizePointerMoved"
                                    PointerReleased="OnResizePointerReleased" />

                            <!-- Bottom-Right Corner Tactile Resize Grip -->
                            <Border Width="18" Height="18"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Background="Transparent"
                                    Cursor="BottomRightCorner"
                                    IsVisible="{Binding CanResize}"
                                    PointerPressed="OnResizeBottomRightPointerPressed"
                                    PointerMoved="OnResizePointerMoved"
                                    PointerReleased="OnResizePointerReleased">
                                <materialIcons:MaterialIcon Kind="ResizeBottomRight"
                                                             Width="12" Height="12"
                                                             Foreground="{DynamicResource M3OutlineBrush}"
                                                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                             Margin="0,0,3,3" />
                            </Border>
                        </Panel>
                    </Border>
                </Panel>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>

</UserControl>
