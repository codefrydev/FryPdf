<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);NU1901;NU1902;NU1903;NU1904;CS1591</NoWarn>
    <AssemblyName>PdfEditorApp.Core</AssemblyName>
    <RootNamespace>PdfEditorApp.Core</RootNamespace>
    <PackageId Condition="'$(PackageId)' == ''">FryPdf.PluginSdk</PackageId>
    <Title>FryPDF Plugin SDK</Title>
    <Version Condition="'$(Version)' == ''">0.1.2</Version>
    <!--
      Plugin ABI version. This assembly is the plugin contract: external plugins compile against it
      and never ship it, so its identity must NOT move with the application's release version —
      otherwise every release hands already-published plugins a contract they did not compile
      against. Bump this ONLY on a breaking contract change.
      PdfEditorApp.csproj strips the AssemblyVersion global property from its ProjectReference so
      a command-line -p:AssemblyVersion (as used by .github/workflows/release.yml) cannot override
      the value below. FileVersion / InformationalVersion still flow through, so the shipped file
      keeps reporting the release it came from.
    -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Authors>PrashantUnity</Authors>
    <Company>Code Fry Dev</Company>
    <Copyright>Copyright © 2026 Code Fry Dev</Copyright>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>High-performance PDF deconstruction, layout analysis, and document engineering core library</Description>
    <PackageDescription>Cross-platform SDK and core document processing engine for building plugins, tools, and extensions for FryPDF.</PackageDescription>
    <PackageTags>pdf;frypdf;plugin;sdk;document-processing;questpdf;pdfpig;layout-analysis;deconstruction</PackageTags>
    <PackageProjectUrl>https://codefrydev.in/frypdf/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/codefrydev/frypdf</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>app-logo.png</PackageIcon>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\PdfEditorApp\Assets\app-logo.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView" />
    <PackageReference Include="PdfPig" />
    <PackageReference Include="PdfPig.Rendering.Skia" />
    <PackageReference Include="PdfSharpCore" />
    <PackageReference Include="QuestPDF" />
    <PackageReference Include="QRCoder" />
    <PackageReference Include="Tabula" />
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
</Project>
